<script>
  // SURFACE-5: a ticket picker, placed by a mark — `<ticket-picker name="parent"/>`.
  // Typing asks `find` (FRAME-16: nothing until there is a query; 150 ms of
  // quiet, the newest query only); Enter or a click puts `picked { name, id }`
  // on the bus — `name` the picker's prop, so the component that placed it
  // knows which field it fills (`on("picked", …)`) — ↑↓ move the hit Enter
  // takes, and Escape closes it. The field is drawn again (keyed by `n`) once
  // a pick or Escape empties it. The keys are the field's own (`on:keydown`):
  // they act only while it has the focus, so no `keys()`.
  //
  // While the debounce runs, or the new `find` is resyncing, the engine keeps
  // the last query's rows: a hit is drawn, moved to or taken only when its id
  // or title holds the query as typed now (`lq`, trimmed and lower-cased) —
  // Enter takes the hit ↑↓ chose, else the one whose id is the query, else
  // the first that holds it, else nothing.
  prop("name"); prop("label");
  state(#{ q: "", lq: "", open: false, n: 0, cur: () });
  let found = live(#{ snapshot: "tickets.find", params: #{ query: state.q, limit: 8, fields: ["id", "title", "kind", "status"] },
                      key: "id", debounce_ms: 150, when: state.q });
  fn typed(state, ev) {
    let q = ev.value;
    q.trim();
    state.q = ev.value; state.lq = q.to_lower(); state.open = ev.value != ""; state.cur = ();
    state
  }
  fn keyed(state, ev) {
    let lq = state.lq;
    let ids = [];
    let exact = [];
    for f in ev.live.found {
      let hit = f.id.to_lower().contains(lq) || f.title.to_lower().contains(lq);
      if hit { ids.push(f.id); }
      if f.id.to_lower() == lq { exact.push(f.id); }
    }
    let at = -1;
    let i = 0;
    for x in ids { if x == state.cur { at = i; } i += 1; }
    let n = ids.len();
    let down = at + 1;
    if down >= n { down = 0; }
    let up = at - 1;
    if up < 0 { up = n - 1; }
    if ev.key == "ArrowDown" && n > 0 { state.cur = ids[down]; }
    if ev.key == "ArrowUp" && n > 0 { state.cur = ids[up]; }
    let id = ();
    if n > 0 { id = ids[0]; }
    if exact.len() > 0 { id = exact[0]; }
    if at >= 0 { id = ids[at]; }
    let pick = ev.key == "Enter" && state.open && id != ();
    if pick { emit("picked", #{ name: ev.props.name, id: id }); }
    if pick || ev.key == "Escape" { state.q = ""; state.lq = ""; state.open = false; state.cur = (); state.n += 1; }
    state
  }
  fn clicked(state, ev) {
    let id = ev.target.data["pick"];
    let pick = id != () && id != "";
    if pick { emit("picked", #{ name: ev.props.name, id: id }); state.q = ""; state.lq = ""; state.open = false; state.cur = (); state.n += 1; }
    state
  }
</script>

<div class="picker" data-surface="ticket-picker" data-picker={name}>
  {#each [state.n] as k (k)}
  <input class="picker-input" data-field={name} type="text" spellcheck="false" autocomplete="off" role="combobox"
         aria-label={if label == () { name } else { label }} aria-expanded={if state.open { "true" } else { "false" }}
         placeholder="an id or words in a title" value={state.q} on:input={typed} on:keydown={keyed}/>
  {/each}
  {#if state.open}
    <ul class="picker-hits" role="listbox" data-picker-hits>
      {#each found.rows.filter(|f| f.id.to_lower().contains(state.lq) || f.title.to_lower().contains(state.lq)) as f (f.id)}
        <li role="option" aria-selected={if f.id == state.cur { "true" } else { "false" }}><button type="button" class="pick" data-pick={f.id} data-id={f.id} data-status={f.status} on:click={clicked}>
          <i class="kmark" data-kind={f.kind} aria-hidden="true"></i>
          {#if state.lq != "" && f.id.to_lower().index_of(state.lq) >= 0}
            <span class="pick-id">{f.id.sub_string(0, f.id.to_lower().index_of(state.lq))}<mark data-match>{f.id.sub_string(f.id.to_lower().index_of(state.lq), state.lq.len())}</mark>{f.id.sub_string(f.id.to_lower().index_of(state.lq) + state.lq.len())}</span>
          {:else}
            <span class="pick-id">{f.id}</span>
          {/if}
          {#if state.lq != "" && f.title.to_lower().index_of(state.lq) >= 0}
            <span class="pick-title">{f.title.sub_string(0, f.title.to_lower().index_of(state.lq))}<mark data-match>{f.title.sub_string(f.title.to_lower().index_of(state.lq), state.lq.len())}</mark>{f.title.sub_string(f.title.to_lower().index_of(state.lq) + state.lq.len())}</span>
          {:else}
            <span class="pick-title">{f.title}</span>
          {/if}
          <span class="pick-status">{f.status}</span>
        </button></li>
      {/each}
      {#if found.status == "pending"}<li class="picker-skeleton" data-loading aria-hidden="true"></li>{/if}
      {#if found.status == "live" && found.rows.filter(|f| f.id.to_lower().contains(state.lq) || f.title.to_lower().contains(state.lq)).len() == 0}<li class="picker-empty" data-empty>No ticket's id or title holds “{state.q}”.</li>{/if}
      {#if found.status == "error" || found.status == "refused"}<li class="picker-refused" data-refused role="alert">{found.message}</li>{/if}
    </ul>
  {/if}
</div>

<style>
  :scope { display: block; position: relative; min-width: 0; }
  .picker-input { width: 100%; padding: 5px 10px; color: var(--ink); font: inherit; background: var(--bg); border: var(--border) solid var(--line); border-radius: var(--radius); transition: border-color var(--motion-fast) var(--ease); }
  .picker-input:hover { border-color: var(--muted); }
  .picker-input:focus-visible { outline: none; border-color: var(--focus); box-shadow: 0 0 0 2px var(--sel); }
  .picker-hits { position: absolute; z-index: 5; left: 0; right: 0; top: calc(100% + 4px); list-style: none; margin: 0; padding: 4px; max-height: 260px; overflow: auto; background: var(--card); border: var(--border) solid var(--line); border-radius: var(--radius-lg); box-shadow: 0 10px 30px var(--shadow); }
  .pick { display: grid; grid-template-columns: 10px auto minmax(0, 1fr) auto; gap: 8px; align-items: center; width: 100%; height: var(--pitch); padding: 0 8px; font: inherit; text-align: left; color: var(--ink); white-space: nowrap; background: none; border: 0; border-radius: var(--radius); cursor: pointer; transition: background-color var(--motion-fast) var(--ease); }
  .pick > * { pointer-events: none; }
  .pick:hover { background: var(--hover); }
  .pick:focus-visible { outline: none; background: var(--row-sel); box-shadow: inset 0 0 0 2px var(--focus); }
  li[aria-selected=true] .pick { background: var(--row-sel); box-shadow: inset 2px 0 0 var(--accent); }
  mark { color: inherit; background: var(--sel); border-radius: var(--radius-xs); box-shadow: 0 1px 0 var(--accent); }
  .pick-id { color: var(--accent); font-variant-numeric: tabular-nums; }
  .pick-title { overflow: hidden; text-overflow: ellipsis; }
  .pick-status { padding: 0 7px; font-size: 11px; line-height: 18px; border-radius: var(--radius-md); background: var(--st-draft-bg); color: var(--st-draft-fg); }
  .pick[data-status=Pending] .pick-status { background: var(--st-pending-bg); color: var(--st-pending-fg); }
  .pick[data-status=Ready] .pick-status { background: var(--st-ready-bg); color: var(--st-ready-fg); }
  .pick[data-status=Coding] .pick-status { background: var(--st-coding-bg); color: var(--st-coding-fg); }
  .pick[data-status="In Review"] .pick-status { background: var(--st-in-review-bg); color: var(--st-in-review-fg); }
  .pick[data-status=Complete] .pick-status { background: var(--st-complete-bg); color: var(--st-complete-fg); }
  .pick[data-status=Blocked] .pick-status { background: var(--st-blocked-bg); color: var(--st-blocked-fg); }
  .pick[data-status=Superseded] .pick-status { background: var(--st-superseded-bg); color: var(--st-superseded-fg); }
  .pick[data-status=Canceled] .pick-status { background: var(--st-canceled-bg); color: var(--st-canceled-fg); }
  .kmark { display: inline-block; width: 8px; height: 8px; background: var(--kind-build); border-radius: 50%; }
  .kmark[data-kind=scope] { background: var(--kind-scope); border-radius: var(--radius-xs); transform: rotate(45deg) scale(.85); }
  .kmark[data-kind=gap] { background: var(--kind-gap); border-radius: 0; clip-path: polygon(50% 0, 100% 100%, 0 100%); }
  .kmark[data-kind=spike] { background: none; border: 2px solid var(--kind-spike); }
  .kmark[data-kind=execution] { background: var(--kind-execution); border-radius: var(--radius-xs); }
  .picker-skeleton { height: 12px; margin: 8px; background: var(--skeleton); border-radius: var(--radius-sm); animation: breathe var(--motion-pulse) var(--ease) infinite alternate; }
  .picker-empty { padding: 6px 8px; color: var(--muted); }
  .picker-refused { padding: 6px 8px; color: var(--warn); font-size: 11px; }
  @keyframes breathe { from { opacity: 1; } to { opacity: .45; } }
  @media (prefers-reduced-motion: reduce) {
    .pick, .picker-input { transition: none; }
    .picker-skeleton { animation: none; }
  }
</style>
