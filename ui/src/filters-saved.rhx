<script>
  // SURFACE-6: the saved filters (FILTER-46) — `#/filters` (and
  // `#/filters/:filter`, the board's filter handed in to be saved), and the
  // nav's "saved" group as `<filters-saved filter={filter} compact="true"/>`.
  // `filters.list` live on `watch`'s `filter_saved` / `filter_deleted` — a
  // rename is both, the new row and then the old name gone (SURFACE-6's
  // change to the service). A row selected is `filters.get` (its filter as the server keeps
  // it, its count), opened on the board as `#/f/saved "Name"`, renamed or
  // deleted; the form saves a name over the typed filter (the board's when
  // nothing is typed), `filters.check` on each pause saying ok or the
  // refusal's words, and the save held back while the check refuses.
  //
  // `call()` answers nothing today (CONTRACT), so what the server would
  // refuse is said before the write too — the check's words for a filter, a
  // name another row holds for a rename. FRAME-37 (`call(method, params,
  // "fold")`, the fold run once with `ev = #{ method, params, ok, events,
  // message }`) draws the write's own refusal beside it: each write names
  // its answer fold below and the fold is written; the third argument goes
  // in when FRAME-37 merges (the compiler refuses it until then). The list
  // needs no re-ask after a write: `watch` says filter_saved / filter_deleted.
  prop("filter");
  prop("compact");
  state(#{ sel: "", name: "", text: "", typed: false, to: "", gen: 0, refused: "" });
  let saved = live(#{ snapshot: "tickets.filters.list", params: #{}, changes: "tickets.watch", key: "name",
                      on: #{ filter_saved: "upsert:filter", filter_deleted: "remove:name" } });
  // a pause before the get: a row picked by the save that made it is asked once the save has landed
  let one = live(#{ snapshot: "tickets.filters.get", params: #{ name: state.sel }, key: "name", debounce_ms: 250, when: state.sel });
  let checked = live(#{ snapshot: "tickets.filters.check", params: #{ filter: state.text }, key: "filter", debounce_ms: 200, when: state.text });
  fn named(state, ev) { state.name = ev.value; state.refused = ""; state }
  fn filtered(state, ev) { state.text = ev.value; state.typed = true; state }
  fn save(state, ev) {
    let name = state.name;
    name.trim();
    let text = if state.typed { state.text } else if ev.props.filter == () { "" } else { ev.props.filter };
    text.trim();
    if name == "" { state.refused = "a saved filter needs a name"; return state; }
    if text == "" { state.refused = "there is no filter to save — type one"; return state; }
    // the check is under the field: a refused (or unanswered) filter is not sent
    if state.typed && ev.live.checked.len() == 0 { return state; }
    // FRAME-37: answer fold "saved_answer" — the fields stay until it says ok
    call("tickets.filters.save", #{ name: name, filter: text });
    state.sel = name;
    state.refused = "";
    state
  }
  fn saved_on_enter(state, ev) {
    if ev.key == "Enter" { return save(state, ev); }
    state
  }
  fn pick(state, ev) {
    let n = ev.target.data["pick"];
    if state.sel == n { state.sel = ""; } else { state.sel = n; }
    state.to = "";
    state.refused = "";
    state
  }
  fn open(state, ev) {
    let t = "saved \"" + ev.target.data["open"] + "\"";
    t.replace("%", "%25");
    t.replace("/", "%2F");
    t.replace("#", "%23");
    navigate("#/f/" + t);
    state
  }
  fn renaming(state, ev) { state.to = ev.value; state.refused = ""; state }
  fn rename(state, ev) {
    let to = state.to;
    to.trim();
    let from = state.sel;
    if to == "" || to == from { state.refused = "a new name, please"; return state; }
    let lower = to.to_lower();
    let clash = false;
    for f in ev.live.saved {
      if f.name != from && f.name.to_lower() == lower { clash = true; }
    }
    if clash { state.refused = "another saved filter is named " + to; return state; }
    // FRAME-37: answer fold "renamed_answer"
    call("tickets.filters.rename", #{ name: from, to: to });
    state.sel = to;
    state.to = "";
    state.refused = "";
    state
  }
  fn renamed_on_enter(state, ev) {
    if ev.key == "Enter" { return rename(state, ev); }
    state
  }
  // FRAME-37's answer folds: a refusal's words beside the write that was refused.
  fn saved_answer(state, ev) {
    if !ev.ok { state.refused = if ev.message == () { "the save was refused" } else { ev.message }; state.sel = ""; return state; }
    state.name = "";
    state.text = "";
    state.typed = false;
    state.gen += 1;
    state
  }
  fn renamed_answer(state, ev) {
    if !ev.ok { state.refused = if ev.message == () { "the rename was refused" } else { ev.message }; state.sel = ev.params.name; }
    state
  }
  fn deleted_answer(state, ev) {
    if !ev.ok { state.refused = if ev.message == () { "the delete was refused" } else { ev.message }; state.sel = ev.params.name; }
    state
  }
  fn remove(state, ev) {
    // FRAME-37: answer fold "deleted_answer"
    call("tickets.filters.delete", #{ name: state.sel });
    state.sel = "";
    state.refused = "";
    state
  }
</script>

<section class="filters-saved" data-surface="filters-saved" data-compact={if compact == () { "false" } else { "true" }}>
  <header class="fs-head">
    <h2>Saved filters</h2>
    <span class="fs-count" data-field="total">{saved.rows.len()}</span>
  </header>
  {#if compact == ()}
    <div class="fs-form" data-form="tickets.filters.save">
      {#each [state.gen] as g (g)}
        <label class="fs-field"><span>name</span>
          <input data-field="name" type="text" spellcheck="false" autocomplete="off" placeholder="Open builds" on:input={named} on:keydown={saved_on_enter}/></label>
        <label class="fs-field grow"><span>filter</span>
          <input data-field="filter" type="text" spellcheck="false" autocomplete="off" placeholder="kind build and not category done"
                 value={if filter == () { "" } else { filter }} on:input={filtered} on:keydown={saved_on_enter}/></label>
      {/each}
      {#if (state.typed && state.text != "" && (checked.status != "live" || checked.rows.len() == 0)) || state.name == ""}
        <button class="fs-btn" type="button" data-action="tickets.filters.save" disabled="" aria-disabled="true">Save</button>
      {:else}
        <button class="fs-btn primary" type="button" data-action="tickets.filters.save" on:click={save}>Save</button>
      {/if}
      {#if state.typed && state.text != ""}
        {#if checked.status == "error" || checked.status == "refused"}
          <p class="fs-check" data-check="refused" data-refused role="status">{if checked.message == () { "this filter is not taken" } else { checked.message }}</p>
        {:else}
          {#if checked.status == "live" && checked.rows.len() > 0}
            <p class="fs-check" data-check="ok" role="status"><span class="ok">ok</span> · <span data-field="count">{checked.rows[0].count}</span> tickets · <code>{checked.rows[0].filter}</code></p>
          {:else}
            <p class="fs-check" data-check="pending" data-loading>checking…</p>
          {/if}
        {/if}
      {/if}
      {#if state.refused != "" && state.sel == ""}<p class="fs-check" data-refused role="alert">{state.refused}</p>{/if}
    </div>
  {/if}
  {#if saved.status == "pending"}
    <ul class="fs-rows" data-loading aria-busy="true"><li class="fs-skel"></li><li class="fs-skel"></li><li class="fs-skel"></li></ul>
  {:else}
    {#if saved.status == "error" || saved.status == "refused"}
      <p class="fs-empty" data-refused>{if saved.message == () { "the saved filters are not yours to read" } else { saved.message }}</p>
    {/if}
    <ul class="fs-rows">
      {#each saved as f (f.name)}
        {#if f.name == state.sel}
          <li class="fs-row" data-id={f.name} data-selected="">
            <div class="fs-line">
              <button class="fs-name" type="button" data-pick={f.name} aria-expanded="true" on:click={pick}>{f.name}</button>
              <span class="fs-n" data-field="count">{if f.count == () { "" } else { f.count }}</span>
              <button class="fs-btn" type="button" data-action="open" data-open={f.name} on:click={open}>Open</button>
            </div>
            <div class="fs-detail" data-field="detail">
              {#each one as o (o.name)}
                <p class="fs-text"><code data-field="filter">{o.filter}</code> <span class="fs-meta">{o.count} tickets</span></p>
              {/each}
              {#if one.status == "error" || one.status == "refused"}<p class="fs-check" data-refused>{one.message}</p>{/if}
              {#if compact == ()}
                <div class="fs-acts">
                  <input class="fs-to" data-field="to" type="text" spellcheck="false" autocomplete="off" placeholder="a new name" aria-label="a new name" on:input={renaming} on:keydown={renamed_on_enter}/>
                  <button class="fs-btn" type="button" data-action="tickets.filters.rename" on:click={rename}>Rename</button>
                  <button class="fs-btn danger" type="button" data-action="tickets.filters.delete" on:click={remove}>Delete</button>
                </div>
                {#if state.refused != ""}<p class="fs-check" data-refused role="alert">{state.refused}</p>{/if}
              {/if}
            </div>
          </li>
        {:else}
          <li class="fs-row" data-id={f.name}>
            <div class="fs-line">
              {#if compact == ()}
                <button class="fs-name" type="button" data-pick={f.name} aria-expanded="false" title={f.filter} on:click={pick}>{f.name}</button>
              {:else}
                <button class="fs-name" type="button" data-open={f.name} title={f.filter} on:click={open}>{f.name}</button>
              {/if}
              <span class="fs-n" data-field="count">{if f.count == () { "" } else { f.count }}</span>
              <button class="fs-btn" type="button" data-action="open" data-open={f.name} on:click={open}>Open</button>
            </div>
          </li>
        {/if}
      {/each}
    </ul>
    {#if saved.status == "live" && saved.rows.len() == 0}
      <p class="fs-empty" data-empty>No saved filters yet — type one above and give it a name.</p>
    {/if}
  {/if}
</section>

<style>
  :scope { display: block; }
  .filters-saved { max-width: 760px; margin: 0 auto; padding: 16px 20px 32px; color: var(--ink); font-family: var(--font-text); font-size: var(--text-size); }
  .filters-saved[data-compact=true] { max-width: none; margin: 0; padding: 8px 4px; }
  .fs-head { display: flex; gap: 8px; align-items: baseline; margin-bottom: 10px; }
  .fs-head h2 { margin: 0; font-size: 11px; font-weight: var(--weight-medium); color: var(--muted); text-transform: uppercase; letter-spacing: .06em; }
  .fs-count { padding: 0 7px; font-size: 11px; line-height: 18px; color: var(--chip-fg); background: var(--chip-bg); border: var(--border) solid var(--chip-line); border-radius: var(--radius-pill); font-variant-numeric: tabular-nums; }
  .fs-form { display: flex; flex-wrap: wrap; gap: 8px; align-items: flex-end; padding: 10px; margin-bottom: 14px; background: var(--panel); border: var(--border) solid var(--line); border-radius: var(--radius-lg); }
  .fs-field { display: flex; flex-direction: column; gap: 3px; font-size: 11px; color: var(--muted); }
  .fs-field.grow { flex: 1; min-width: 220px; }
  .fs-field input, .fs-to { padding: 5px 8px; color: var(--ink); background: var(--bg); border: var(--border) solid var(--line); border-radius: var(--radius); transition: border-color var(--motion-fast) var(--ease); }
  .fs-field input:hover, .fs-to:hover { border-color: var(--muted); }
  .fs-field input:focus-visible, .fs-to:focus-visible { outline: none; border-color: var(--focus); box-shadow: 0 0 0 2px var(--sel); }
  .fs-btn { padding: 4px 10px; font-size: 12px; color: var(--ink); background: var(--card); border: var(--border) solid var(--line); border-radius: var(--radius); cursor: pointer; transition: background-color var(--motion-fast) var(--ease), border-color var(--motion-fast) var(--ease); }
  .fs-btn:hover { background: var(--hover); }
  .fs-btn:focus-visible { outline: 2px solid var(--focus); outline-offset: 1px; }
  .fs-btn.primary { color: var(--accent); border-color: var(--accent); background: var(--sel); }
  .fs-btn.danger { color: var(--warn); }
  .fs-btn[disabled] { color: var(--disabled); border-color: var(--line); background: var(--card); cursor: not-allowed; }
  .fs-check { flex-basis: 100%; margin: 2px 0 0; font-size: 11px; color: var(--muted); }
  .fs-check[data-refused] { color: var(--warn); }
  .fs-check[data-loading] { color: var(--disabled); }
  .fs-check .ok { color: var(--live); font-weight: var(--weight-medium); }
  .fs-check code, .fs-text code { font-family: var(--font-text); color: var(--ink); }
  .fs-rows { list-style: none; margin: 0; padding: 0; }
  .fs-row { border-bottom: var(--border) solid var(--line); }
  .fs-row[data-selected] { background: var(--row-sel); box-shadow: inset 2px 0 0 var(--accent); }
  .fs-line { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; gap: 8px; align-items: center; min-height: var(--pitch); padding: 0 8px; transition: background-color var(--motion-fast) var(--ease); }
  .fs-row:not([data-selected]) .fs-line:hover { background: var(--hover); }
  .fs-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding: 0; color: var(--ink); text-align: left; font: inherit; font-weight: var(--weight-medium); background: none; border: 0; cursor: pointer; }
  .fs-name:hover { color: var(--accent); }
  .fs-name:focus-visible { outline: 2px solid var(--focus); border-radius: var(--radius-sm); }
  .fs-n:empty { display: none; }
  .fs-n { padding: 0 7px; font-size: 11px; line-height: 18px; color: var(--chip-fg); background: var(--chip-bg); border: var(--border) solid var(--chip-line); border-radius: var(--radius-pill); font-variant-numeric: tabular-nums; }
  .fs-detail { padding: 2px 8px 10px; }
  .fs-text { margin: 0 0 8px; overflow-wrap: anywhere; }
  .fs-meta { color: var(--muted); font-size: 11px; }
  .fs-acts { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .fs-to { flex: 1; min-width: 140px; }
  .fs-empty { margin: 10px 8px; color: var(--muted); }
  .fs-empty[data-refused] { color: var(--warn); }
  .fs-skel { height: 14px; margin: 7px 8px; border-radius: var(--radius-sm); background: var(--skeleton); animation: fs-pulse var(--motion-pulse) var(--ease) infinite alternate; }
  .filters-saved[data-compact=true] .fs-line { grid-template-columns: minmax(0, 1fr) auto; }
  .filters-saved[data-compact=true] [data-action=open] { display: none; }
  @keyframes fs-pulse { from { opacity: .55; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .fs-btn, .fs-line, .fs-field input, .fs-to { transition: none; }
    .fs-skel { animation: none; }
  }
</style>
