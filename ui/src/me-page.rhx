<script>
  // SURFACE-9: who I am — the connection's identity (`session.whoami`:
  // principal, provider, roles, tenant) and the door's (`auth.whoami`: the
  // agent, the memberships, a ceiling), the providers each names
  // (`session.providers`, `auth.providers`), every grant and team I hold
  // (`members.mine`: `me`, then `team { team }` and `grant { grant }` rows),
  // "who may…" (`auth.requires { method }` → its grant and roles, asked when
  // a method is entered), and the way out: `session.logout` ends this
  // connection's session and the form posts to the shell's door, /logout.
  state(#{ draft: "", method: () });
  let who = live(#{ snapshot: "session.whoami", params: #{}, key: "principal", on: #{} });
  let door = live(#{ snapshot: "auth.whoami", params: #{}, key: "principal", on: #{} });
  let mine = live(#{ snapshot: "members.mine", params: #{}, key: "name", on: #{} });
  let sessions = live(#{ snapshot: "session.providers", params: #{}, key: "name", on: #{} });
  let providers = live(#{ snapshot: "auth.providers", params: #{}, key: "name", on: #{} });
  let req = live(#{ snapshot: "auth.requires", params: #{ method: state.method }, key: "method", when: state.method, on: #{} });
  fn typed(state, ev) { state.draft = ev.value; state }
  fn entered(state, ev) {
    if ev.key == "Enter" && ev.value != "" { state.draft = ev.value; state.method = ev.value; }
    state
  }
  fn ask(state, ev) { if state.draft != "" { state.method = state.draft; } state }
  // FRAME-37: no answer fold — the form leaves for the shell's door, which
  // ends the session whatever this call answers.
  fn logout(state, ev) { call("session.logout", #{}); state }
</script>

<section class="me-page" data-surface="me-page">
  <nav class="crumbs"><a href="#/" data-back>← board</a></nav>
  <header class="head">
    <h1>Who I am</h1>
    {#if who.status != "live"}<span class="state" data-loading={who.status}>{who.status}</span>{/if}
    <form class="door" method="post" action="/logout">
      <button class="act" type="submit" data-action="session.logout" on:click={logout}>sign out</button>
    </form>
  </header>

  {#each who as w (w.principal)}
    <dl class="card identity">
      <dt>name</dt><dd data-field="name">{w.name}</dd>
      <dt>principal</dt><dd class="mono" data-field="principal">{w.principal}</dd>
      <dt>provider</dt><dd data-field="provider">{w.provider}</dd>
      <dt>roles</dt><dd data-field="roles">{if w.roles.len() == 0 { "none on the session" } else { w.roles.reduce(|a, b| if a == "" { b } else { a + ", " + b }, "") }}</dd>
      <dt>tenant</dt><dd data-field="tenant">{if w.tenant == () { "none" } else { w.tenant }}</dd>
      {#each door as d (d.principal)}
        <dt>agent</dt><dd data-field="agent">{if d.agent == () { "none" } else { d.agent }}</dd>
        <dt>ceiling</dt><dd data-field="ceiling">{if d.ceiling.len() == 0 { "none" } else { d.ceiling.map(|c| if type_of(c) == "string" { c } else { c.role + "@" + c.scope }).reduce(|a, b| if a == "" { b } else { a + ", " + b }, "") }}</dd>
      {/each}
    </dl>
  {/each}
  {#if who.status == "error" || who.status == "refused"}<p class="refused" data-refused>refused: {who.message}</p>{/if}

  <h2>Grants</h2>
  <div class="rows" data-field="grants">
    {#each mine.rows.filter(|r| r.role != ()) as g (g.scope)}
      <div class="row" data-id={g.scope}>
        <span class="scope mono" data-field="scope">{g.scope}</span>
        <span class="tag" data-field="role">{g.role}</span>
        <span class="meta" data-field="by">{if g.granted_by == () { "" } else { "by " + g.granted_by }}</span>
      </div>
    {/each}
    {#if mine.status == "pending"}<div class="row skeleton" data-loading><span></span></div>{/if}
    {#if mine.status == "live" && mine.rows.filter(|r| r.role != ()).len() == 0}<p class="empty" data-empty>No grant: you hold nothing yet.</p>{/if}
  </div>
  {#each mine.rows.filter(|r| r.admin_everywhere == true) as m (m.name)}<p class="note" data-field="admin">admin everywhere</p>{/each}

  <h2>Teams</h2>
  <div class="rows" data-field="teams">
    {#each mine.rows.filter(|r| r.members != ()) as t (t.name)}
      <div class="row" data-id={t.name}>
        <span class="scope" data-field="team">{t.name}</span>
        <span class="meta"><span data-field="members">{t.members}</span> members</span>
        <span class="meta">{t.org}</span>
      </div>
    {/each}
    {#if mine.status == "live" && mine.rows.filter(|r| r.members != ()).len() == 0}<p class="empty" data-empty>In no team.</p>{/if}
  </div>

  <h2>Providers</h2>
  <div class="rows" data-field="providers">
    {#each providers as p (p.name)}
      <div class="row" data-id={p.name}><span class="scope" data-field="provider-name">{p.name}</span><span class="meta">{p.kind}</span><span class="meta">the door's</span></div>
    {/each}
    {#each sessions as p (p.name)}
      <div class="row" data-session-provider={p.name}><span class="scope">{p.name}</span><span class="meta">{p.kind}</span><span class="meta">this session's</span></div>
    {/each}
    {#if providers.status == "live" && providers.rows.len() == 0 && sessions.rows.len() == 0}<p class="empty" data-empty>No provider named.</p>{/if}
  </div>

  <h2>Who may…</h2>
  <div class="ask" data-form="auth.requires">
    <input class="field" placeholder="a method, e.g. tickets.set_status" spellcheck="false" autocomplete="off" on:input={typed} on:keydown={entered}/>
    <button class="act" data-action="auth.requires" on:click={ask}>ask</button>
    {#if state.method != ()}
      {#each req as r (r.method)}
        <p class="answer"><span class="mono">{r.method}</span> needs the grant <span class="mono" data-field="grant">{r.grant}</span>, held by <span data-field="roles">{r.roles.reduce(|a, b| if a == "" { b } else { a + ", " + b }, "")}</span>
          — <strong data-field="may">{if door.rows.len() > 0 && door.rows[0].memberships.some(|m| r.roles.contains(m.role)) { "you may" } else { "you may not" }}</strong></p>
      {/each}
      {#if req.status == "pending" || req.status == "resyncing"}<p class="answer" data-loading>asking…</p>{/if}
      {#if req.status == "error" || req.status == "refused"}<p class="refused" data-refused>refused: {req.message}</p>{/if}
    {/if}
  </div>
</section>

<style>
  :scope { display: block; }
  .me-page { max-width: 860px; margin: 0 auto; padding: 16px 20px 40px; color: var(--ink); font-family: var(--font-text); font-size: var(--text-size); }
  .crumbs { margin-bottom: 12px; font-size: 12px; }
  .crumbs a { color: var(--muted); border-radius: var(--radius-sm); }
  .crumbs a:hover { color: var(--accent); }
  .crumbs a:focus-visible { outline: 2px solid var(--focus); outline-offset: 1px; }
  .head { display: flex; gap: 14px; align-items: baseline; margin-bottom: 12px; }
  .head h1 { margin: 0; font-family: var(--font-display); font-size: 22px; font-weight: var(--weight-strong); }
  .state { font-size: 11px; color: var(--muted); }
  .door { margin: 0 0 0 auto; }
  h2 { margin: 22px 0 6px; font-size: 11px; font-weight: var(--weight-medium); color: var(--muted); text-transform: uppercase; letter-spacing: .06em; }
  .card { display: grid; grid-template-columns: max-content 1fr; gap: 4px 14px; margin: 0; padding: 12px 14px; background: var(--panel); border: var(--border) solid var(--line); border-radius: var(--radius-lg); }
  .card dt { color: var(--muted); }
  .card dd { margin: 0; overflow-wrap: anywhere; }
  .mono { font-family: var(--font-text); overflow-wrap: anywhere; }
  .rows { border-top: var(--border) solid var(--line); }
  .row { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: 12px; align-items: center; min-height: var(--pitch); padding: 3px 8px; border-bottom: var(--border) solid var(--line); transition: background-color var(--motion-fast) var(--ease); }
  .row:hover { background: var(--hover); }
  .scope { color: var(--accent); overflow: hidden; text-overflow: ellipsis; }
  .meta { color: var(--muted); font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .meta span { color: var(--ink); }
  .tag { padding: 0 7px; font-size: 11px; line-height: 18px; color: var(--chip-fg); background: var(--chip-bg); border: var(--border) solid var(--chip-line); border-radius: var(--radius-pill); }
  .note { margin: 6px 0 0; font-size: 12px; color: var(--live); }
  .ask { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .field { flex: 1; min-width: 220px; padding: 4px 8px; color: var(--ink); background: var(--card); border: var(--border) solid var(--line); border-radius: var(--radius); outline: none; }
  .field:focus-visible { box-shadow: 0 0 0 2px var(--focus); }
  .act { padding: 2px 10px; font-size: 12px; color: var(--ink); background: var(--card); border: var(--border) solid var(--line); border-radius: var(--radius); cursor: pointer; transition: background-color var(--motion-fast) var(--ease); }
  .act:hover { background: var(--hover); }
  .act:focus-visible { outline: 2px solid var(--focus); outline-offset: 1px; }
  .act:disabled { color: var(--disabled); cursor: default; }
  .answer { flex-basis: 100%; margin: 4px 0 0; }
  .answer strong { color: var(--live); font-weight: var(--weight-medium); }
  .refused { flex-basis: 100%; margin: 4px 0 0; font-size: 12px; color: var(--warn); }
  .skeleton span { display: block; height: 10px; width: 40%; background: var(--skeleton); border-radius: var(--radius-sm); animation: breathe var(--motion-pulse) var(--ease) infinite alternate; }
  .empty { margin: 6px 8px; color: var(--muted); }
  @keyframes breathe { from { opacity: .55; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .row, .act { transition: none; } .skeleton span { animation: none; } }
  @media (max-width: 720px) { .row { grid-template-columns: 1fr auto; } .meta { display: none; } }
</style>
