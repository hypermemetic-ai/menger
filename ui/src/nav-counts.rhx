<script>
  // SURFACE-6: a count for a filter, placed anywhere — `<nav-counts
  // filter="ready and kind build"/>` (a `label` beside it, optional; on its
  // own at `#/counts/:filter`) — and live by `watch { filter, membership }`:
  // `nav counts` gives the total once, and the filter's first page of ids
  // (`list { filter, fields: [id], limit: 1000 }`) is folded by the
  // membership stream — `entered` puts an id in, `left` takes it out — so
  // the count is the total less that page plus what the page holds now
  // (exact up to 1,000 matches; above, a ticket leaving from past the page
  // is not seen until the next read, and a write moving more than 256 says
  // `recount`, which this does not fold).
  //
  // With `ids` (an array, from a mark: `<nav-counts filter="status Ready"
  // ids={selected}/>`) it is how many of those tickets the filter admits:
  // `nav member { ids, filter }`, folded by the same stream.
  prop("filter");
  prop("label");
  prop("ids");
  let total = live(#{ snapshot: "tickets.nav.counts", params: #{ filter: filter }, key: "shortcode" });
  let held = live(#{ snapshot: "tickets.list", params: #{ filter: filter, summary: true, fields: ["id"], limit: 1000 },
                     changes: "tickets.watch", changes_params: #{ filter: filter, membership: true }, key: "id",
                     on: #{ entered: "upsert:.", left: "remove:id" } });
  let member = live(#{ snapshot: "tickets.nav.member", params: #{ ids: ids, filter: filter },
                       changes: "tickets.watch", changes_params: #{ filter: filter, membership: true }, key: "id",
                       on: #{ entered: "upsert:.", left: "remove:id" }, when: ids });
  fn open(state, ev) {
    let t = if ev.props.filter == () { "" } else { ev.props.filter };
    t.replace("%", "%25");
    t.replace("/", "%2F");
    t.replace("#", "%23");
    if t == "" { navigate("#/"); } else { navigate("#/f/" + t); }
    state
  }
</script>

<span class="nav-counts" data-surface="nav-counts" data-filter={filter}>
  {#if ids != ()}
    {#if member.status == "error" || member.status == "refused"}
      <span class="nc-refused" data-refused title={member.message}>{if member.message == () { "not taken" } else { member.message }}</span>
    {:else}
      <button class="nc" type="button" data-action="open" title={filter} on:click={open}>
        {#if member.status == "pending"}<span class="nc-n" data-loading aria-busy="true"></span>{:else}<span class="nc-n" data-field="count">{member.rows.filter(|r| r.matched != false && r.id in ids).len()}</span>{/if}<span class="nc-of">of {ids.len()}</span>{#if label != ()}<span class="nc-label">{label}</span>{/if}
      </button>
    {/if}
  {:else}
    {#if total.status == "error" || total.status == "refused" || held.status == "error"}
      <span class="nc-refused" data-refused title={filter}>{if total.message != () { total.message } else if held.message != () { held.message } else { "this filter is not taken" }}</span>
    {:else}
      <button class="nc" type="button" data-action="open" title={filter} on:click={open}>
        {#if total.status == "pending" || held.status == "pending"}<span class="nc-n" data-loading aria-busy="true"></span>{:else}<span class="nc-n" data-field="count" data-empty={if total.rows.reduce(|a, c| a + c.held, 0) - (if total.rows.reduce(|a, c| a + c.held, 0) < 1000 { total.rows.reduce(|a, c| a + c.held, 0) } else { 1000 }) + held.rows.len() == 0 { "true" } else { "false" }}>{total.rows.reduce(|a, c| a + c.held, 0) - (if total.rows.reduce(|a, c| a + c.held, 0) < 1000 { total.rows.reduce(|a, c| a + c.held, 0) } else { 1000 }) + held.rows.len()}</span>{/if}{#if label != ()}<span class="nc-label">{label}</span>{/if}
      </button>
    {/if}
  {/if}
</span>

<style>
  :scope { display: inline-block; }
  .nav-counts { display: inline-flex; align-items: center; font-family: var(--font-text); font-size: 11px; }
  .nc { display: inline-flex; gap: 5px; align-items: center; padding: 0 7px; font: inherit; line-height: 18px; color: var(--chip-fg); background: var(--chip-bg); border: var(--border) solid var(--chip-line); border-radius: var(--radius-pill); cursor: pointer; transition: background-color var(--motion-fast) var(--ease), border-color var(--motion-fast) var(--ease); }
  .nc:hover { background: var(--hover); border-color: var(--muted); }
  .nc:focus-visible { outline: 2px solid var(--focus); outline-offset: 1px; }
  .nc-n { min-width: 1ch; color: var(--ink); font-weight: var(--weight-bold); font-variant-numeric: tabular-nums; }
  .nc-n[data-empty=true] { color: var(--muted); font-weight: var(--weight-medium); }
  .nc-n[data-loading] { width: 3ch; height: 10px; border-radius: var(--radius-sm); background: var(--skeleton); animation: nc-pulse var(--motion-pulse) var(--ease) infinite alternate; }
  .nc-of, .nc-label { color: var(--muted); }
  .nc-refused { padding: 0 7px; line-height: 18px; color: var(--warn); border: var(--border) dashed var(--warn); border-radius: var(--radius-pill); }
  @keyframes nc-pulse { from { opacity: .55; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .nc { transition: none; }
    .nc-n[data-loading] { animation: none; }
  }
</style>
