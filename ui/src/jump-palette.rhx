<script>
  // UI-8: the jump palette — `/` opens it; `find` after 80 ms of quiet, the
  // newest query only, its hits first and `search`'s best below; Enter
  // jumps to the first, Escape closes. FRAME-16: neither asks anything
  // until there is a query (`when: state.q`).
  state(#{ open: false, q: "" });
  let found = live(#{ snapshot: "tickets.find", params: #{ query: state.q, limit: 12, fields: ["id", "title", "kind", "status"] }, key: "id", debounce_ms: 80, when: state.q });
  let searched = live(#{ snapshot: "tickets.search", params: #{ query: state.q, limit: 8 }, key: "id", debounce_ms: 80, when: state.q });
  fn keyed(state, ev) {
    if ev.key == "/" && !state.open && ev.target.tag != "input" && ev.target.tag != "textarea" && ev.target.tag != "select" { state.open = true; }
    else if ev.key == "Escape" && state.open { state.open = false; state.q = ""; }
    state
  }
  fn typed(state, ev) { state.q = ev.value; state }
  fn entered(state, ev) {
    if ev.key == "Enter" {
      let f = ev.live.found;
      if f.len() > 0 { navigate("#/ticket/" + f[0].id); state.open = false; state.q = ""; }
    }
    state
  }
  fn picked(state, ev) { state.open = false; state.q = ""; state }
</script>

<div class="jump-palette" data-palette on:window-keydown={keyed}>
  {#if state.open}
    <div class="palette-sheet" role="dialog" aria-label="jump to a ticket">
      <input class="palette-input" data-palette-input autofocus="" spellcheck="false" autocomplete="off"
             placeholder="jump to a ticket — an id or words" value={state.q} on:input={typed} on:keydown={entered}/>
      {#if state.q != ""}
        <ul class="palette-hits" data-palette-hits>
          {#each found as f (f.id)}
            <li><a class="palette-hit" data-palette-hit={f.id} href={"#/ticket/" + f.id} on:click={picked}><span class="row-id">{f.id}</span> <span class="row-title">{f.title}</span></a></li>
          {/each}
        </ul>
        <p class="palette-label">in titles and bodies</p>
        <ul class="palette-hits search" data-search-hits>
          {#each searched as h (h.id)}
            <li><a class="palette-hit" data-search-hit={h.id} href={"#/ticket/" + h.id} on:click={picked}><span class="row-id">{h.id}</span> <span class="row-title">{h.title}</span></a></li>
          {/each}
        </ul>
      {/if}
    </div>
  {/if}
</div>

<style>
  :scope { display: block; }
  .palette-sheet { position: fixed; z-index: 10; top: 12vh; left: 50%; transform: translateX(-50%); display: flex; flex-direction: column; width: min(640px, calc(100vw - 32px)); max-height: 70vh; overflow: hidden; background: var(--card); border: var(--border) solid var(--line); border-radius: var(--radius-xl); box-shadow: 0 10px 30px var(--shadow); }
  .palette-input { padding: 12px 14px; font-size: 14px; color: var(--ink); background: none; border: 0; border-bottom: var(--border) solid var(--line); outline: none; }
  .palette-input:focus-visible, .palette-input[data-sheet~=focus] { box-shadow: inset 0 -2px 0 var(--focus); }
  .palette-hits { list-style: none; margin: 0; padding: 4px; overflow: auto; }
  .palette-hit { display: flex; gap: 10px; align-items: center; height: var(--pitch); padding: 0 10px; overflow: hidden; white-space: nowrap; color: var(--ink); text-decoration: none; border-radius: var(--radius); transition: background-color var(--motion-fast) var(--ease); }
  .palette-hit:hover, .palette-hit[data-sheet~=hover] { background: var(--hover); }
  .palette-hit:focus-visible, .palette-hit[data-sheet~=focus] { outline: none; background: var(--row-sel); box-shadow: inset 0 0 0 2px var(--focus); }
  .row-id { flex: none; color: var(--accent); font-variant-numeric: tabular-nums; }
  .row-title { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .palette-label { margin: 6px 14px 2px; font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: .06em; }
</style>
