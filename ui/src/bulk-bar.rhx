<script>
  // SURFACE-5: the bulk bar — under the board's rows (`<bulk-bar/>`), and
  // at `#/bulk/:ids` with a selection of its own. It hears the rows'
  // selection on the bus (`board.selected { ids }`, SURFACE-2's), or takes a
  // filter typed instead — its count `nav.counts { filter }`'s sum. An
  // action is `update_many` (`--status`, `--label`, `--unlabel`, `--kind`,
  // `--severity`) or `archive`, each at most `--max`, and each asked in two
  // steps: the dry run first — the selection's count (`update_many` has no
  // dry run; past `max` it is refused before it is sent), `archive
  // --dry-run true`'s own answer (the subtree with it) — then the write.
  //
  // `call()` answers nothing (CONTRACT), and the bar must say the answer's
  // `changed` rows and a refusal, so each step is a `live` held by `when`
  // until its button (`d_on` / `s_on`): the `d_` and `s_` fields are the
  // step as it was asked, and nothing else moves their params. A selection,
  // a filter or an action that moves lets both go.
  prop("ids");
  state(#{ sel: [], filter: "", action: "status", value: "Ready", max: 500,
           d_on: false, d_archive: false, d_ids: (), d_filter: (), d_max: 500, d_n: 0, d_action: "", d_value: "",
           s_on: false, s_update: false, s_archive: false, s_ids: (), s_filter: (), s_max: 500,
           s_status: (), s_kind: (), s_severity: (), s_label: (), s_unlabel: () });
  on("board.selected", "selected");
  let counts = live(#{ snapshot: "tickets.nav.counts", params: #{ filter: state.filter }, key: "shortcode",
                       on: #{ count: "upsert:." }, debounce_ms: 150, when: state.filter });
  let dry_archive = live(#{ snapshot: "tickets.archive", params: #{ ids: state.d_ids, filter: state.d_filter, max: state.d_max, dry_run: true },
                            key: "dry_run", on: #{ archived: "upsert:." }, when: state.d_archive });
  let archived = live(#{ snapshot: "tickets.archive", params: #{ ids: state.s_ids, filter: state.s_filter, max: state.s_max, dry_run: false },
                         key: "dry_run", on: #{ archived: "upsert:." }, when: state.s_archive });
  let updated = live(#{ snapshot: "tickets.update_many",
                        params: #{ ids: state.s_ids, filter: state.s_filter, max: state.s_max, status: state.s_status, kind: state.s_kind,
                                   severity: state.s_severity, label: state.s_label, unlabel: state.s_unlabel, source: "app" },
                        key: "ids", on: #{ updated_many: "upsert:." }, when: state.s_update });
  // Every change of what is asked lets both steps go.
  fn selected(state, ev) {
    let ids = ev.bus.data.ids;
    state.sel = if ids == () { [] } else { ids };
    state.filter = "";
    state.d_on = false; state.d_archive = false; state.s_on = false; state.s_update = false; state.s_archive = false;
    state
  }
  fn filtered(state, ev) {
    state.filter = ev.value;
    state.d_on = false; state.d_archive = false; state.s_on = false; state.s_update = false; state.s_archive = false;
    state
  }
  fn set_action(state, ev) {
    state.action = ev.value;
    state.value = if ev.value == "status" { "Ready" } else if ev.value == "kind" { "build" } else if ev.value == "severity" { "High" } else { "" };
    state.d_on = false; state.d_archive = false; state.s_on = false; state.s_update = false; state.s_archive = false;
    state
  }
  fn set_value(state, ev) {
    state.value = ev.value;
    state.d_on = false; state.d_archive = false; state.s_on = false; state.s_update = false; state.s_archive = false;
    state
  }
  fn set_max(state, ev) {
    if ev.value != "" { state.max = parse_int(ev.value); }
    state.d_on = false; state.d_archive = false; state.s_on = false; state.s_update = false; state.s_archive = false;
    state
  }
  fn dry(state, ev) {
    let ids = state.sel;
    if ids.len() == 0 && ev.props.ids != () && ev.props.ids != "" { ids = ev.props.ids.split(","); }
    let filter = state.filter;
    filter.trim();
    if filter == "" && ids.len() == 0 { return state; }
    if (state.action == "label" || state.action == "unlabel") && state.value == "" { return state; }
    let n = 0;
    if filter == "" { n = ids.len(); } else { for c in ev.live.counts { n += c.held; } }
    state.d_ids = if filter == "" { ids } else { () };
    state.d_filter = if filter == "" { () } else { filter };
    state.d_max = state.max; state.d_n = n; state.d_action = state.action; state.d_value = state.value;
    state.d_on = true; state.d_archive = state.action == "archive";
    state.s_on = false; state.s_update = false; state.s_archive = false;
    state
  }
  fn apply(state, ev) {
    if !state.d_on { return state; }
    let a = state.d_action;
    let v = state.d_value;
    state.s_ids = state.d_ids; state.s_filter = state.d_filter; state.s_max = state.d_max;
    state.s_status = if a == "status" { v } else { () };
    state.s_kind = if a == "kind" { v } else { () };
    state.s_severity = if a == "severity" { v } else { () };
    state.s_label = if a == "label" { [v] } else { () };
    state.s_unlabel = if a == "unlabel" { [v] } else { () };
    state.s_on = true; state.s_archive = a == "archive"; state.s_update = a != "archive";
    state
  }
  fn cancel(state, ev) {
    state.d_on = false; state.d_archive = false; state.s_on = false; state.s_update = false; state.s_archive = false;
    state
  }
</script>

<div class="bulk" data-surface="bulk-bar">
  <div class="sel">
    {#if state.filter != ""}
      <span class="n" data-bulk-count>{counts.rows.reduce(|a, c| a + c.held, 0)}</span><span class="l">match the filter</span>
      {#if counts.status == "pending"}<span class="skeleton" data-loading aria-hidden="true"></span>{/if}
    {:else}
      <span class="n" data-bulk-count>{if state.sel.len() > 0 { state.sel.len() } else if ids != () && ids != "" { ids.split(",").len() } else { 0 }}</span><span class="l">selected</span>
    {/if}
    <input class="filter" data-field="filter" type="search" spellcheck="false" autocomplete="off" aria-label="or a filter"
           placeholder="or a filter — status Draft and in KILN" value={state.filter} on:input={filtered}/>
    {#if counts.status == "error" || counts.status == "refused"}<span class="refused" data-refused data-refused-of="filter" role="alert">{counts.message}</span>{/if}
  </div>
  <div class="act">
    <select data-field="action" aria-label="action" on:change={set_action}>
      <option value="status">set status</option>
      <option value="label">label</option>
      <option value="unlabel">unlabel</option>
      <option value="kind">set kind</option>
      <option value="severity">set severity</option>
      <option value="archive">archive</option>
    </select>
    {#if state.action == "status"}
      <select data-field="value" aria-label="status" on:change={set_value}>
        {#each ["Ready", "Draft", "Pending", "Coding", "In Review", "Complete", "Superseded", "Canceled"] as s (s)}<option value={s}>{s}</option>{/each}
      </select>
    {/if}
    {#if state.action == "kind"}
      <select data-field="value" aria-label="kind" on:change={set_value}>
        {#each ["build", "gap", "spike", "execution", "scope", "doc"] as s (s)}<option value={s}>{s}</option>{/each}
      </select>
    {/if}
    {#if state.action == "severity"}
      <select data-field="value" aria-label="severity" on:change={set_value}>
        {#each ["High", "Critical", "Medium", "Low", "none"] as s (s)}<option value={s}>{s}</option>{/each}
      </select>
    {/if}
    {#if state.action == "label" || state.action == "unlabel"}
      <input data-field="value" type="text" spellcheck="false" autocomplete="off" aria-label="label" placeholder="a label" value={state.value} on:input={set_value}/>
    {/if}
    <label class="max">max <input data-field="max" type="number" min="1" value={state.max} on:change={set_max}/></label>
    {#if state.filter != "" || state.sel.len() > 0 || (ids != () && ids != "")}
      <button type="button" class="b" data-action="dry-run" on:click={dry}>Dry run</button>
    {:else}
      <button type="button" class="b" data-action="dry-run" disabled="" title="select rows, or type a filter">Dry run</button>
    {/if}
  </div>
  {#if state.d_on}
    <div class="dry" data-dry-run>
      {#if state.d_archive}
        {#if dry_archive.status == "pending"}<span class="skeleton" data-loading aria-hidden="true"></span>{/if}
        {#each dry_archive as d (d.ids.len())}
          <span data-dry-count={d.ids.len()}>archive would take <b>{d.ids.len()}</b> tickets with their subtrees</span>
          {#if d.live.len() > 0}<span class="warn" data-dry-live={d.live.len()}>{d.live.len()} not done</span>{/if}
        {/each}
        {#if dry_archive.status == "error" || dry_archive.status == "refused"}<span class="refused" data-refused role="alert">{dry_archive.message}</span>{/if}
        {#if dry_archive.status == "live" && dry_archive.rows.len() > 0}
          <button type="button" class="b go" data-action="tickets.archive" on:click={apply}>Archive {dry_archive.rows[0].ids.len()}</button>
        {/if}
      {:else}
        {#if state.d_n > state.d_max}
          <span class="refused" data-refused role="alert">{state.d_n} tickets is more than max {state.d_max}: nothing will be sent</span>
        {:else}
          <span data-dry-count={state.d_n}>{state.d_action} {if state.d_value == "" { "" } else { "→ " + state.d_value }} on <b>{state.d_n}</b> tickets</span>
          <button type="button" class="b go" data-action="tickets.update_many" on:click={apply}>Apply to {state.d_n}</button>
        {/if}
      {/if}
      <button type="button" class="b quiet" data-action="cancel" on:click={cancel}>Cancel</button>
    </div>
  {/if}
  {#if state.s_on}
    <div class="answer" data-bulk-answer>
      {#if (state.s_update && updated.status == "pending") || (state.s_archive && archived.status == "pending")}<span class="skeleton" data-loading aria-hidden="true"></span>{/if}
      {#if state.s_update}
        {#each updated as u (u.ids.len())}
          <span class="landed" data-changed={u.ids.len()}>changed {u.ids.len()} — {if u.changed.len() == 0 { "nothing moved" } else { u.changed.reduce(|a, c| if a == () { c } else { a + ", " + c }) }}</span>
          {#if u.unchanged.len() > 0}<span class="l" data-unchanged={u.unchanged.len()}>{u.unchanged.len()} already so</span>{/if}
          <ul class="rows">{#each u.ids as id (id)}<li><ticket-chip id={id} kind="changed"/></li>{/each}</ul>
        {/each}
        {#if updated.status == "error" || updated.status == "refused"}<span class="refused" data-refused role="alert">{updated.message}</span>{/if}
      {:else}
        {#each archived as a (a.ids.len())}
          <span class="landed" data-changed={a.ids.len()}>archived {a.ids.len()}</span>
          <ul class="rows">{#each a.ids as id (id)}<li><ticket-chip id={id} kind="archived"/></li>{/each}</ul>
        {/each}
        {#if archived.status == "error" || archived.status == "refused"}<span class="refused" data-refused role="alert">{archived.message}</span>{/if}
      {/if}
    </div>
  {/if}
</div>

<style>
  :scope { display: block; }
  .bulk { display: flex; flex-direction: column; gap: 6px; padding: 8px 14px; color: var(--ink); font-family: var(--font-text); font-size: var(--text-size); background: var(--panel); border-top: var(--border) solid var(--line); }
  .sel, .act, .dry, .answer { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .n { font-weight: var(--weight-bold); font-variant-numeric: tabular-nums; }
  .l { color: var(--muted); }
  .filter { flex: 1; min-width: 180px; max-width: 420px; }
  input, select { padding: 3px 8px; font: inherit; color: var(--ink); background: var(--bg); border: var(--border) solid var(--line); border-radius: var(--radius); transition: border-color var(--motion-fast) var(--ease); }
  input:hover, select:hover { border-color: var(--muted); }
  input:focus-visible, select:focus-visible { outline: none; border-color: var(--focus); box-shadow: 0 0 0 2px var(--sel); }
  .max { display: inline-flex; gap: 4px; align-items: center; color: var(--muted); }
  .max input { width: 72px; }
  .b { padding: 3px 12px; font: inherit; color: var(--ink); background: var(--card); border: var(--border) solid var(--line); border-radius: var(--radius); cursor: pointer; transition: background-color var(--motion-fast) var(--ease); }
  .b:hover { background: var(--hover); }
  .b:focus-visible { outline: 2px solid var(--focus); outline-offset: 1px; }
  .b[disabled] { color: var(--disabled); cursor: default; background: var(--card); }
  .b.go { color: var(--accent); background: var(--sel); border-color: var(--accent); }
  .b.go:hover { background: var(--row-sel); }
  .b.quiet { color: var(--muted); }
  .warn, .refused { color: var(--warn); }
  .refused { font-size: 12px; }
  .landed { color: var(--live); }
  .rows { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; margin: 0; padding: 0; }
  .skeleton { display: inline-block; width: 80px; height: 12px; background: var(--skeleton); border-radius: var(--radius-sm); animation: breathe var(--motion-pulse) var(--ease) infinite alternate; }
  @keyframes breathe { from { opacity: 1; } to { opacity: .45; } }
  @media (prefers-reduced-motion: reduce) {
    input, select, .b { transition: none; }
    .skeleton { animation: none; }
  }
</style>
