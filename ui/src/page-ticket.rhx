<script>
  // STUDIO-12: the ticket page — an rhx page the studio edits, placing the
  // ticket's parts, each a svelte/1 component the host fills into its bound
  // mark (`<ticket-head id={id}/>`): the head, the body, its questions, the edit, the
  // relations (which place the subtasks and the blockers), the actions, the
  // commits, the history and the revisions; the app's top in its `top`
  // section (app-top by ui/slots.json). It was ticket-page-sv (SURFACE-3);
  // what the page itself decides stays here: the skeleton while `get` is
  // out, "no such ticket", and a ticket deleted — `get` answering `deleted`
  // (folded whole), or the ticket's newest revision saying `deleted` with no
  // `undeleted` after it (ticket-revisions' spec, one collection) — which
  // draws the actions alone (undelete). The ticket is read on ticket-head's
  // spec word for word, so the page holds one `get` and one stream of it.
  // Keys: `e` says `ticket.edit` on the bus (ticket-edit hears it; the page
  // counts it in `data-edit-asked` and the edit's mark flashes), `escape`
  // and `g b` go to the board — `#/` under either prefix: rhx reads no
  // route prefix, and `#/sv/` is the same board's alias; `[` and `]` are
  // ticket-head's, which knows the siblings (and keeps the prefix). The key
  // strip says them; the palette is the page's `palette` section
  // (jump-palette-sv by ui/slots.json: app-top's jump button and ctrl+k).
  prop("id");
  prop("sheet"); // SURFACE-10: the sheet's held state, "loading" its skeleton
  state(#{ knocked: 0 });
  let ticket = live(#{ snapshot: "tickets.get", params: #{ id: id }, changes: "tickets.watch", key: "id",
                       on: #{ amended: "upsert:ticket", status_changed: "upsert:ticket", kind_changed: "upsert:ticket", updated: "upsert:ticket",
                              labels_changed: "upsert:ticket", severity_changed: "upsert:ticket", frozen_changed: "upsert:ticket", hidden_changed: "upsert:ticket",
                              blockers_changed: "upsert:ticket", unlocks_changed: "upsert:ticket", unlocks_removed: "upsert:ticket", parent_changed: "upsert:ticket",
                              commits_linked: "upsert:ticket", commits_unlinked: "upsert:ticket", revision_restored: "upsert:ticket", deleted: "upsert:." } });
  let latest = live(#{ snapshot: "tickets.revisions.list", params: #{ id: id, limit: 1 }, changes: "tickets.watch", changes_params: #{ revisions: true },
                       key: "ticket", on: #{ revised: "upsert:." } });
  keys(#{
    "e": #{ to: "edit", label: "edit the ticket" },
    "escape": #{ to: "board", label: "back to the board" },
    "g b": #{ to: "board", label: "go to the board" },
  });
  fn edit(state, ev) { emit("ticket.edit", #{ id: ev.props.id }); state.knocked += 1; state }
  fn board(state, ev) { navigate("#/"); state }
</script>

<section class="page page-ticket">
  <slot name="top" here="ticket"/>
  <article class="ticket-page" data-surface="ticket-page" data-ticket={id} data-edit-asked={state.knocked}>
    <nav class="crumbs" aria-hidden="true"><span class="keys" data-keys><kbd>e</kbd> edit<i class="sep"></i><kbd>esc</kbd> board<i class="sep"></i><kbd>[</kbd><kbd>]</kbd> siblings<i class="sep"></i><kbd>?</kbd> keys</span></nav>
    {#if latest.rows.filter(|r| r.ticket == id && type_of(r.fields) == "array" && "deleted" in r.fields).len() > 0 || (latest.rows.filter(|r| r.ticket == id && type_of(r.fields) == "array" && "undeleted" in r.fields).len() == 0 && ticket.rows.filter(|r| type_of(r.tombstones) == "array").len() > 0)}
      <section class="tp">
        <div class="gone" data-deleted>
          <p class="gone-line"><span class="badge">deleted</span> <strong>{id}</strong>{" was deleted" + (if ticket.rows.reduce(|a, r| if type_of(r.tombstones) == "array" { r.tombstones.reduce(|b, x| if x.id == id && x.title != () { x.title } else { b }, a) } else { a }, ()) != () { " — " + ticket.rows.reduce(|a, r| if type_of(r.tombstones) == "array" { r.tombstones.reduce(|b, x| if x.id == id && x.title != () { x.title } else { b }, a) } else { a }, ()) } else if ticket.rows.filter(|r| r.title != ()).len() > 0 { " — " + ticket.rows.filter(|r| r.title != ())[0].title } else { "" }) + ". Its body is kept 30 days; undelete brings it back."}</p>
          <div class="hole" data-mark="ticket-actions" data-id={id}><ticket-actions id={id}/></div>
        </div>
      </section>
    {:else}
      {#if sheet == "loading" || ticket.status == "pending" || (ticket.status == "resyncing" && ticket.rows.len() == 0)}
        <div class="tp skeleton" data-loading aria-busy="true">
          <div class="wide"><i class="bone short"></i><i class="bone title"></i><i class="bone third"></i></div>
          <div class="main"><i class="bone"></i><i class="bone"></i><i class="bone half"></i><i class="bone"></i></div>
          <div class="side"><i class="bone"></i><i class="bone half"></i><i class="bone"></i></div>
        </div>
      {:else}
        {#if ticket.rows.filter(|r| r.title != ()).len() == 0}
          <p class="tp empty" data-empty data-not-found>{"No ticket " + id + " here" + (if ticket.message == () { "" } else { " — " + ticket.message }) + "."}</p>
        {:else}
          <div class="tp">
            <div class="cell head"><ticket-head id={id}/></div>
            <div class="cell main">
              <ticket-body id={id}/>
              <ticket-questions id={id}/>
              <div class={if state.knocked == 0 { "hole" } else if state.knocked % 2 == 1 { "hole heard" } else { "hole heard-again" }} data-mark="ticket-edit" data-id={id}><ticket-edit id={id}/></div>
              <ticket-relations id={id}/>
            </div>
            <aside class="cell side">
              <div class="hole" data-mark="ticket-actions" data-id={id}><ticket-actions id={id}/></div>
              <ticket-commits id={id}/>
              <ticket-history id={id}/>
            </aside>
            <div class="cell revs"><ticket-revisions id={id}/></div>
          </div>
        {/if}
      {/if}
    {/if}
  </article>
  <slot name="palette"/>
</section>

<style>
  :scope { display: block; }
  .page-ticket { min-height: 100vh; min-height: 100dvh; color: var(--ink); background: var(--bg); font-family: var(--font-text); font-size: var(--text-size); }
  .page-ticket > [data-slot=top] { position: sticky; top: 0; z-index: 4; }
  .crumbs { display: flex; align-items: center; padding: 8px max(28px, calc((100% - 1284px) / 2)) 0; font-size: 11px; color: var(--muted); }
  .keys { display: flex; gap: 5px; align-items: center; margin-left: auto; }
  .sep { display: inline-block; width: 8px; }
  kbd { display: inline-block; min-width: 16px; padding: 0 4px; font-family: var(--font-text); font-size: 10px; line-height: 15px; text-align: center; color: var(--ink); background: var(--card); border: var(--border) solid var(--line); border-bottom-width: 2px; border-radius: var(--radius-sm); }
  .tp { display: grid; grid-template-columns: minmax(0, 1fr) 400px; gap: 0 36px; align-items: start; max-width: 1340px; margin: 0 auto; padding: 16px 28px 48px; }
  .head { grid-column: 1 / -1; grid-row: 1; }
  .main { grid-column: 1; grid-row: 3 / span 2; min-width: 0; }
  .side { grid-column: 2; grid-row: 3; min-width: 0; }
  .revs { grid-column: 2; grid-row: 4; min-width: 0; }
  .revs:has([data-open="true"]) { grid-column: 1 / -1; grid-row: 2; }
  .hole { margin-top: 14px; border-radius: var(--radius); }
  .side > .hole { margin-top: 0; }
  .hole.heard { animation: heard var(--motion-flash) var(--ease); }
  .hole.heard-again { animation: again var(--motion-flash) var(--ease); }
  @keyframes heard { from { background: var(--sel); } to { background: transparent; } }
  @keyframes again { from { background: var(--sel); } to { background: transparent; } }
  .skeleton .wide { grid-column: 1 / -1; padding-bottom: 14px; }
  .skeleton .main, .skeleton .side { grid-row: 2; }
  .bone { display: block; width: 100%; height: 10px; margin: 6px 0; background: var(--skeleton); border-radius: var(--radius-sm); animation: breathe var(--motion-pulse) var(--ease) infinite alternate; }
  .bone.short { width: 90px; }
  .bone.title { width: 55%; height: 24px; margin: 10px 0; }
  .bone.third { width: 33%; }
  .bone.half { width: 50%; }
  @keyframes breathe { from { opacity: 1; } to { opacity: .45; } }
  .empty { display: block; color: var(--muted); }
  .gone { grid-column: 1 / -1; padding: 14px 16px; background: var(--panel); border: var(--border) solid var(--line); border-radius: var(--radius-lg); }
  .gone-line { margin: 0 0 10px; }
  .badge { padding: 0 6px; font-size: 10px; line-height: 16px; text-transform: uppercase; letter-spacing: .06em; color: var(--warn); border: var(--border) dashed var(--warn); border-radius: var(--radius-sm); }
  @media (max-width: 960px) {
    .tp { grid-template-columns: minmax(0, 1fr); padding: 12px 16px 40px; }
    .crumbs { display: none; }
    .head, .main, .side, .revs, .revs:has([data-open="true"]) { grid-column: 1; grid-row: auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    .bone, .hole.heard, .hole.heard-again { animation: none; }
  }
</style>
