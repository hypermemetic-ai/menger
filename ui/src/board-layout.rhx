<script>
  // UI-8: the board's layout — the filter line in its own top bar, and three
  // sections, each filled by an assignment (UI-9; ui/slots.json the
  // defaults): the nav, the board, the jump palette. The route gives the
  // filter (`#/` none, `#/f/:filter` the text); the nav and the board get it.
  prop("filter");
</script>

<div class="board-layout" data-board-layout data-filter={filter}>
  <header class="topbar">
    <a class="brand" href="#/">menger</a>
    <filter-line filter={filter}/>
    <span class="hint" data-palette-hint>press / to jump</span>
  </header>
  <div class="board-body">
    <slot name="nav" filter={filter}/>
    <slot name="main" filter={filter}/>
  </div>
  <slot name="palette"/>
</div>

<style>
  :scope { display: block; }
  .board-layout { display: flex; flex-direction: column; height: 100vh; height: 100dvh; background: var(--bg); color: var(--ink); font-family: var(--font-text); font-size: var(--text-size); }
  .board-body { flex: 1; min-height: 0; display: flex; }
  .board-body > [data-slot=nav] { width: 260px; flex: none; border-right: var(--border) solid var(--line); overflow: auto; background: var(--panel); }
  .board-body > [data-slot=main] { flex: 1; min-width: 0; display: flex; }
  .board-body > [data-slot=main] > * { flex: 1; min-width: 0; display: flex; }
  [data-slot=top] > * { display: block; }
  @media (max-width: 720px) {
    .board-body > [data-slot=nav] { display: none; }
  }
  .topbar { display: flex; align-items: flex-start; gap: 14px; min-height: 46px; padding: 8px max(14px, env(safe-area-inset-left)); background: var(--panel); border-bottom: var(--border) solid var(--line); }
  .brand { font-family: var(--font-display); font-weight: var(--weight-bold); color: var(--ink); text-decoration: none; padding: 5px 4px 0; border-radius: var(--radius); transition: color var(--motion-fast) var(--ease); }
  .brand:hover { color: var(--accent); }
  .brand:focus-visible { outline: 2px solid var(--focus); outline-offset: 1px; }
  .hint { margin-left: auto; padding-top: 7px; font-size: 11px; color: var(--muted); white-space: nowrap; }
  @media (max-width: 720px) {
    .topbar { gap: 8px; }
    .hint { display: none; }
  }
  :scope filter-line { flex: 1; min-width: 0; }
</style>
