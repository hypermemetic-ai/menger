<script>
  // STUDIO-12: the search page — an rhx page the studio edits, placing
  // search-page (svelte/1: the query's two lists, find and search, and its
  // pager) by its mark, the app's top in its `top` section and the palette
  // in its `palette` section (app-top and jump-palette-sv by ui/slots.json),
  // so ctrl+k jumps from here too. #/search, #/search/:q and
  // #/search/:q/f/:filter: the query and the filter from the route.
  prop("q");
  prop("filter");
</script>

<section class="page page-search">
  <slot name="top" here="search"/>
  <search-page q={q} filter={filter}/>
  <slot name="palette"/>
</section>

<style>
  :scope { display: block; }
  .page-search { min-height: 100vh; min-height: 100dvh; color: var(--ink); background: var(--bg); font-family: var(--font-text); font-size: var(--text-size); }
</style>
