<script>
  // SURFACE-6: the facets under the board's nav — `nav facets { filter,
  // base: "not category done" }`, one chip row per field (status, category,
  // kind, severity, in, ready, blocked, has commits, menger doc: the fields
  // the method answers, in its order), each value with its count. A chip
  // narrows the route's filter (`#/f/<filter> and <rule>`, the field's other
  // rule replaced); one the filter already holds is `[data-selected]` and a
  // click takes it out. Asked again when the route's filter moves (the prop
  // `filter`, as board-rows takes it); placed by a mark, `<nav-facets
  // filter={filter}/>`, or on its own at `#/facets/:filter`.
  prop("filter");
  let facets = live(#{ snapshot: "tickets.nav.facets", params: #{ filter: filter, base: "not category done" }, key: "field" });
  fn narrow(state, ev) {
    let rule = ev.target.data["rule"];
    let field = ev.target.data["facet"];
    let negated = "not " + field;
    let prefix = field + " ";
    let flag = field in ["blocked", "ready", "has commits", "menger doc"];
    let now = "";
    if ev.props.filter != () { now = ev.props.filter; }
    now.trim();
    let parts = [];
    if now != "" { parts = now.split(" and "); }
    let had = rule in parts;
    let t = "";
    if now.contains(" or ") {
      // a filter with a top-level `or`: the rule goes beside it, whole
      t = now;
      if !had { t = "(" + now + ") and " + rule; }
    } else {
      // the field's other rule replaced by this one; this one again takes it out
      if !had { parts.push(rule); }
      for p in parts {
        let same = p.starts_with(prefix);
        if flag && (p == field || p == negated) { same = true; }
        if p == rule && !had { same = false; }
        if same { continue; }
        if t != "" { t += " and "; }
        t += p;
      }
    }
    t.replace("%", "%25");
    t.replace("/", "%2F");
    t.replace("#", "%23");
    if t == "" { navigate("#/"); } else { navigate("#/f/" + t); }
    state
  }
</script>

<section class="nav-facets" data-surface="nav-facets" data-filter={filter} aria-label="facets">
  <h2 class="nf-head">Facets {#if filter != ()}<span class="nf-of" title={filter}>of {filter}</span>{/if}</h2>
  {#if facets.status == "pending"}
    <div class="nf-skel-wrap" data-loading aria-busy="true"><span class="nf-skel"></span><span class="nf-skel"></span><span class="nf-skel"></span></div>
  {:else}
    {#if facets.status == "error" || facets.status == "refused"}
      <p class="nf-note" data-refused role="status">{if facets.message == () { "these facets are not answered for this filter" } else { facets.message }}</p>
    {:else}
      {#if facets.rows.len() == 0}
        <p class="nf-note" data-empty>Nothing open matches — no facet to narrow by.</p>
      {/if}
    {/if}
    {#each ["status", "category", "kind", "severity", "in", "ready", "blocked", "has commits", "menger doc"] as fld (fld)}
      {#if facets.rows.some(|f| f.field == fld)}
        <div class="nf-field" data-field={fld}>
          <span class="nf-name">{fld}</span>
          <div class="nf-chips">
            {#each facets.rows.filter(|f| f.field == fld) as f (f.value)}
              {#each [if fld in ["blocked", "ready", "has commits", "menger doc"] { if f.value == "yes" { fld } else { "not " + fld } } else if f.value.contains(" ") { fld + " \"" + f.value + "\"" } else { fld + " " + f.value }] as rule (rule)}
                {#if filter != () && rule in filter.split(" and ")}
                  <button class="nf-chip" type="button" data-selected="" aria-pressed="true" data-facet={fld} data-value={f.value} data-rule={rule} data-status={f.value} title={"take out: " + rule} on:click={narrow}><span class="nf-v">{f.value}</span><span class="nf-n" data-held>{f.held}</span></button>
                {:else}
                  <button class="nf-chip" type="button" aria-pressed="false" data-facet={fld} data-value={f.value} data-rule={rule} data-status={f.value} title={"narrow: " + rule} on:click={narrow}><span class="nf-v">{f.value}</span><span class="nf-n" data-held>{f.held}</span></button>
                {/if}
              {/each}
            {/each}
          </div>
        </div>
      {/if}
    {/each}
  {/if}
</section>

<style>
  :scope { display: block; }
  .nav-facets { padding: 8px 10px 12px; color: var(--ink); font-family: var(--font-text); font-size: var(--text-size); background: var(--panel); }
  .nf-head { display: flex; gap: 6px; align-items: baseline; margin: 0 0 8px; font-size: 11px; font-weight: var(--weight-medium); color: var(--muted); text-transform: uppercase; letter-spacing: .06em; }
  .nf-of { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-transform: none; letter-spacing: 0; color: var(--accent); }
  .nf-field { margin-bottom: 8px; }
  .nf-name { display: block; margin-bottom: 3px; font-size: 11px; color: var(--muted); }
  .nf-chips { display: flex; flex-wrap: wrap; gap: 4px; }
  .nf-chip { display: inline-flex; gap: 5px; align-items: center; padding: 0 3px 0 8px; font: inherit; font-size: 11px; line-height: 20px; color: var(--chip-fg); background: var(--chip-bg); border: var(--border) solid var(--chip-line); border-radius: var(--radius-pill); cursor: pointer; transition: background-color var(--motion-fast) var(--ease), border-color var(--motion-fast) var(--ease), color var(--motion-fast) var(--ease); }
  .nf-chip > * { pointer-events: none; } /* a click is the chip's: its data-* is what the fold reads off ev.target */
  .nf-chip:hover { color: var(--ink); background: var(--hover); border-color: var(--muted); }
  .nf-chip:focus-visible { outline: 2px solid var(--focus); outline-offset: 1px; }
  .nf-chip[data-selected] { color: var(--accent); background: var(--sel); border-color: var(--accent); }
  .nf-n { padding: 0 6px; line-height: 16px; color: var(--muted); background: var(--card); border-radius: var(--radius-pill); font-variant-numeric: tabular-nums; }
  .nf-chip[data-selected] .nf-n { color: var(--accent); }
  .nf-field[data-field=status] .nf-chip[data-status=Draft] .nf-v { color: var(--st-draft-fg); }
  .nf-field[data-field=status] .nf-chip[data-status=Pending] .nf-v { color: var(--st-pending-fg); }
  .nf-field[data-field=status] .nf-chip[data-status=Ready] .nf-v { color: var(--st-ready-fg); }
  .nf-field[data-field=status] .nf-chip[data-status=Coding] .nf-v { color: var(--st-coding-fg); }
  .nf-field[data-field=status] .nf-chip[data-status="In Review"] .nf-v { color: var(--st-in-review-fg); }
  .nf-field[data-field=status] .nf-chip[data-status=Complete] .nf-v { color: var(--st-complete-fg); }
  .nf-field[data-field=status] .nf-chip[data-status=Blocked] .nf-v { color: var(--st-blocked-fg); }
  .nf-note { margin: 4px 0; font-size: 11px; color: var(--muted); }
  .nf-note[data-refused] { color: var(--warn); }
  .nf-skel-wrap { display: flex; flex-direction: column; gap: 6px; }
  .nf-skel { display: block; height: 12px; border-radius: var(--radius-sm); background: var(--skeleton); animation: nf-pulse var(--motion-pulse) var(--ease) infinite alternate; }
  .nf-skel:nth-child(2) { width: 70%; }
  .nf-skel:nth-child(3) { width: 45%; }
  @keyframes nf-pulse { from { opacity: .55; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .nf-chip { transition: none; }
    .nf-skel { animation: none; }
  }
</style>
