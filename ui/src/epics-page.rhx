<script>
  // SURFACE-9: the epics — `epics.list` (the archived ones too behind a
  // toggle) kept by `epics.watch`: a change comes as `epic_changed { name,
  // what }` and lands on its row as what changed (the watch names no card;
  // the list's snapshot is the card). `epics.current` with the watch's
  // `moved` after it. `switch` and `dismiss` are writes, `call()`: the top
  // says the epic asked at once (`state.base`) and the answer fold puts it
  // right — FRAME-37's `call(method, params, "fold")`, written below and
  // turned on when the compiler takes the third argument: `current { epic }`
  // confirms, `not_found { name }` or a refusal is said beside the action
  // and the top goes back. `get` is one card. A switch is said on the bus
  // as `epic.switched { epic }` for the app's top.
  state(#{ archived: false, switch_at: 0, base: (), was: (), refused_for: (), refused: "", dismissed_at: 0, picked: () });
  let epics = live(#{ snapshot: "epics.list", params: #{ archived: state.archived }, changes: "epics.watch", key: "name",
                      on: #{ epic_changed: "upsert:." } });
  let current = live(#{ snapshot: "epics.current", params: #{}, changes: "epics.watch", key: "org",
                        on: #{ current: "upsert:.", moved: "upsert:." } });
  let one = live(#{ snapshot: "epics.get", params: #{ name: state.picked }, key: "name", when: state.picked,
                    on: #{ epic: "upsert:epic" } });
  fn switch_to(state, ev) {
    let cu = ev.live.current;
    // What the top says now: the epic a refused switch goes back to.
    let last = if cu.len() > 1 { cu[cu.len() - 1].moved } else { () };
    let now = if cu.len() > 0 && cu[0].epic != () { cu[0].epic.name } else { () };
    if last != () { now = last.to; }
    if state.base != () && cu.len() <= state.switch_at { now = state.base; }
    let name = ev.target.data.name;
    // FRAME-37: answer fold "switched"
    call("epics.switch", #{ name: name });
    state.was = now;
    state.base = name;
    state.refused_for = ();
    state.switch_at = cu.len();
    emit("epic.switched", #{ epic: name });
    state
  }
  // FRAME-37's answer to epics.switch: ev = #{ method, params, ok, events, message }.
  fn switched(state, ev) {
    let epic = ();
    if ev.events != () { for e in ev.events { if e.type == "current" { epic = e.epic.name; } } }
    if ev.ok && epic != () { state.base = epic; return state; }
    state.refused_for = ev.params.name;
    state.refused = if !ev.ok { ev.message } else { "no epic " + ev.params.name + " here" };
    state.base = state.was;
    state
  }
  fn dismiss(state, ev) {
    // FRAME-37: answer fold "dismissed"
    call("epics.dismiss", #{});
    state.dismissed_at = ev.live.current.len();
    state
  }
  // FRAME-37's answer to epics.dismiss: a refusal brings the notice back, its words beside it.
  fn dismissed(state, ev) {
    if !ev.ok { state.dismissed_at = 0; state.refused_for = "dismiss"; state.refused = ev.message; }
    state
  }
  fn pick(state, ev) { state.picked = ev.target.data.name; state }
  fn toggle_archived(state, ev) { state.archived = ev.checked; state }
</script>

<section class="epics-page" data-surface="epics-page">
  <nav class="crumbs"><a href="#/" data-back>← board</a></nav>
  {#each [if current.rows.len() > state.switch_at && current.rows.len() > 1 && current.rows[current.rows.len() - 1].moved != () { current.rows[current.rows.len() - 1].moved.to } else if state.base != () { state.base } else if current.rows.len() > 1 && current.rows[current.rows.len() - 1].moved != () { current.rows[current.rows.len() - 1].moved.to } else if current.rows.len() > 0 && current.rows[0].epic != () { current.rows[0].epic.name } else { "" }] as cur (cur)}
  <header class="head">
    <h1>Epics</h1>
    <p class="now">you are in <strong data-field="current">{cur}</strong></p>
    {#if current.status != "live"}<span class="state" data-loading>{current.status}</span>{/if}
  </header>
  {#each current.rows.filter(|r| r.moved != () && r.org != ()) as m (m.moved.at_unix)}
    {#if current.rows.len() > state.dismissed_at}
      <p class="notice" data-field="moved">
        an archive of <strong>{m.moved.from}</strong> moved you to <strong>{m.moved.to}</strong>
        <button class="act" data-action="epics.dismiss" on:click={dismiss}>dismiss</button>
        {#if state.refused_for == "dismiss"}<span class="refused" data-refused>refused: {state.refused}</span>{/if}
      </p>
    {/if}
  {/each}
  <div class="tools" data-form="epics.list">
    <label><input type="checkbox" on:change={toggle_archived}/> the archived ones too</label>
  </div>
  <div class="rows">
    {#each epics as e (e.name)}
      <div class="row" data-id={e.name} data-current={e.name == cur} data-archived={e.archived != () || e.what == "archived"} data-changed={if e.what == () { "" } else { e.what }}>
        <button class="name" data-action="epics.get" data-name={e.name} on:click={pick}>{e.name}</button>
        {#if e.what == ()}
          <span class="meta"><span data-field="tickets">{e.tickets}</span> tickets</span>
          <span class="meta"><span data-field="shortcodes">{e.shortcodes}</span> shortcodes</span>
          <span class="meta"><span data-field="members_on">{e.members_on}</span> on it</span>
          <span class="tags">{#if e["default"]}<span class="tag" data-field="default">default</span>{/if}{#if e.archived != ()}<span class="tag archived">archived</span>{/if}</span>
        {:else}
          <span class="meta changed" data-field="what">{e.what}</span><span></span><span></span><span class="tags"></span>
        {/if}
        {#if e.name == cur}
          <span class="here">here</span>
        {:else}
          <button class="act" data-action="epics.switch" data-name={e.name} on:click={switch_to}>switch</button>
        {/if}
        {#if state.refused_for == e.name}<span class="refused" data-refused>refused: {state.refused}</span>{/if}
      </div>
    {/each}
    {#if epics.status == "pending"}<div class="row skeleton" data-loading><span></span></div>{/if}
    {#if epics.status == "live" && epics.rows.len() == 0}<p class="empty" data-empty>No epics here.</p>{/if}
  </div>
  {#if state.picked != ()}
    <aside class="card" data-field="detail">
      {#each one as d (d.name)}
        {#if d.org != ()}
          <h2 data-field="name">{d.name}</h2>
          <dl>
            <dt>organization</dt><dd data-field="org">{d.org}</dd>
            <dt>tickets</dt><dd data-field="tickets">{d.tickets}</dd>
            <dt>shortcodes</dt><dd data-field="shortcodes">{d.shortcodes}</dd>
            <dt>people on it</dt><dd data-field="members_on">{d.members_on}</dd>
            <dt>made</dt><dd data-field="created">{d.created_unix}</dd>
            <dt>first</dt><dd>{if d.first { "yes" } else { "no" }}</dd>
            <dt>default</dt><dd>{if d["default"] { "yes" } else { "no" }}</dd>
            {#if d.archived != ()}<dt>archived</dt><dd data-field="archived">by {d.archived.by}</dd>{/if}
          </dl>
        {:else}
          <p class="refused" data-refused>no epic {d.name} here</p>
        {/if}
      {/each}
      {#if one.status == "error" || one.status == "refused"}<p class="refused" data-refused>refused: {one.message}</p>{/if}
    </aside>
  {/if}
  {/each}
</section>

<style>
  :scope { display: block; }
  .epics-page { max-width: 860px; margin: 0 auto; padding: 16px 20px 40px; color: var(--ink); font-family: var(--font-text); font-size: var(--text-size); }
  .crumbs { margin-bottom: 12px; font-size: 12px; }
  .crumbs a { color: var(--muted); border-radius: var(--radius-sm); }
  .crumbs a:hover { color: var(--accent); }
  .crumbs a:focus-visible { outline: 2px solid var(--focus); outline-offset: 1px; }
  .head { display: flex; gap: 14px; align-items: baseline; }
  .head h1 { margin: 0; font-family: var(--font-display); font-size: 22px; font-weight: var(--weight-strong); }
  .now { margin: 0; color: var(--muted); }
  .now strong { color: var(--accent); font-weight: var(--weight-medium); }
  .state { margin-left: auto; font-size: 11px; color: var(--muted); }
  .notice { display: flex; gap: 8px; align-items: center; margin: 12px 0 0; padding: 6px 10px; background: var(--sel); border: var(--border) solid var(--line); border-radius: var(--radius); }
  .tools { margin: 14px 0 6px; font-size: 12px; color: var(--muted); }
  .tools input:focus-visible { outline: 2px solid var(--focus); }
  .rows { border-top: var(--border) solid var(--line); }
  .row { display: grid; grid-template-columns: minmax(120px, 1fr) auto auto auto minmax(0, 1fr) auto; gap: 12px; align-items: center; min-height: var(--pitch); padding: 0 8px; border-bottom: var(--border) solid var(--line); transition: background-color var(--motion-fast) var(--ease); }
  .row:hover { background: var(--hover); }
  .row[data-current=true] { background: var(--row-sel); box-shadow: inset 2px 0 0 var(--accent); }
  .row[data-archived=true] .name { color: var(--muted); }
  .row[data-changed=deleted] .name { color: var(--disabled); text-decoration: line-through; }
  .name { justify-self: start; padding: 0; color: var(--accent); background: none; border: 0; cursor: pointer; border-radius: var(--radius-sm); }
  .name:hover { text-decoration: underline; }
  .name:focus-visible, .act:focus-visible { outline: 2px solid var(--focus); outline-offset: 1px; }
  .meta { color: var(--muted); font-size: 12px; font-variant-numeric: tabular-nums; }
  .meta span { color: var(--ink); }
  .changed { font-style: italic; }
  .tags { display: flex; gap: 6px; }
  .tag { padding: 0 7px; font-size: 11px; line-height: 18px; color: var(--chip-fg); background: var(--chip-bg); border: var(--border) solid var(--chip-line); border-radius: var(--radius-pill); }
  .tag.archived { color: var(--muted); }
  .here { font-size: 11px; color: var(--accent); }
  .act { padding: 1px 8px; font-size: 12px; color: var(--ink); background: var(--card); border: var(--border) solid var(--line); border-radius: var(--radius); cursor: pointer; transition: background-color var(--motion-fast) var(--ease); }
  .act:hover { background: var(--hover); }
  .act:disabled { color: var(--disabled); cursor: default; }
  .refused { grid-column: 1 / -1; margin: 0 0 6px; font-size: 12px; color: var(--warn); }
  .skeleton span { display: block; height: 10px; width: 40%; background: var(--skeleton); border-radius: var(--radius-sm); animation: breathe var(--motion-pulse) var(--ease) infinite alternate; }
  .empty { color: var(--muted); }
  .card { margin-top: 18px; padding: 12px 14px; background: var(--panel); border: var(--border) solid var(--line); border-radius: var(--radius-lg); }
  .card h2 { margin: 0 0 8px; font-size: 15px; font-weight: var(--weight-strong); }
  .card dl { display: grid; grid-template-columns: max-content 1fr; gap: 4px 14px; margin: 0; }
  .card dt { color: var(--muted); }
  .card dd { margin: 0; overflow-wrap: anywhere; }
  @keyframes breathe { from { opacity: .55; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .row, .act { transition: none; } .skeleton span { animation: none; } }
  @media (max-width: 720px) { .row { grid-template-columns: 1fr auto; } .meta, .tags { display: none; } }
</style>
