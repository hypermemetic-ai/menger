        "deleted": "remove:ids"
      },
      "params": {
        "limit": 200,
        "summary": true
      },
      "snapshot": "tickets.list"
    }
  },
  "name": "hello-list",
  "props": [],
  "state": {
    "seen": ""
  },
  "tree": [
    {
      "attrs": {
        "class": "hello"
      },
      "children": [
        {
          "text": "Hello from v1"
        }
      ],
      "el": "h1"
    },
    {
      "attrs": {
        "class": "status"
      },
      "children": [
        {
          "text": {
            "expr": "rows.status"
          }
        }
      ],
      "el": "p"
    },
    {
      "attrs": {
        "class": "seen"
      },
      "children": [
        {
          "text": {
            "expr": "state.seen"
          }
        }
      ],
      "el": "p"
    },
    {
      "attrs": {
        "class": "keys"
      },
      "children": [],
      "el": "input",
      "on": {
        "keydown": "keyed"
      }
    },
    {
      "attrs": {
        "class": "tick",
        "type": "checkbox"
      },
      "children": [],
      "el": "input",
      "on": {
        "change": "ticked"
      }
    },
    {
      "attrs": {
        "class": "rows",
        "style": "max-height: 240px; overflow: auto; margin: 0"
      },
      "children": [
        {
          "body": [
            {
              "attrs": {
                "data-id": {
                  "expr": "r.id"
