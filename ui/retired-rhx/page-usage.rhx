<script>
  // V2-31: a person's usage page — #/usage (yours), #/usage/:principal (an
  // admin's look at another): the app's top in its `top` section, the
  // palette in its `palette` section (ui/slots.json), quota-usage between.
  prop("principal");
</script>

<section class="page page-usage">
  <slot name="top" here="usage"/>
  <header class="page-title"><h1>usage</h1></header>
  <quota-usage principal={principal}/>
  <slot name="palette"/>
</section>

