  // STUDIO-12: the waves page — an rhx page the studio edits, placing its
  // svelte/1 component by its mark, the app's top in its `top` section and the palette in its
  // `palette` section (app-top's jump button and ctrl+k open it)
  // (app-top by ui/slots.json); a full-height column, so the list scrolls
  // in its own box under its bar and the title sits in the panel above it. #/waves, #/waves/in/:epics, #/waves/:id and #/waves/to/:to: work-waves, the mode from the route.
  prop("epics");
  prop("id");
  prop("to");
</script>

<section class="page page-waves">
  <slot name="top" here="waves"/>
  <header class="page-title"><h1>waves</h1></header>
  <work-waves epics={epics} id={id} to={to}/>
  <slot name="palette"/>
</section>

