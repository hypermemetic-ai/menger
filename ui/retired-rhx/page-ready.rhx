<script>
  // STUDIO-12: the ready page — an rhx page the studio edits, placing its
  // svelte/1 component by its mark, the app's top in its `top` section and the palette in its
  // `palette` section (app-top's jump button and ctrl+k open it)
  // (app-top by ui/slots.json); a full-height column, so the list scrolls
  // in its own box under its bar and the title sits in the panel above it. #/ready and #/ready/:filter: work-ready, under the route's filter.
  prop("filter");
</script>

<section class="page page-ready">
  <slot name="top" here="ready"/>
  <header class="page-title"><h1>ready</h1></header>
  <work-ready filter={filter}/>
  <slot name="palette"/>
</section>

<style>
  :scope { display: block; }
