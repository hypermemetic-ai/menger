#!/usr/bin/env bash
# DEPLOY-12: deploy/pipeline's deployment records, on a throwaway environment
# root — HOME is a scratch directory (the env files, the releases, what each
# env runs, the log, the outbox) and systemctl, ss, node, npm, curl, sqlite3
# and synapse are stand-ins, so a whole deploy test, sync, promote (with the
# drill's automatic rollback), rollback and backfill run in seconds and touch
# nothing real: no unit, no port, no database, no tracker. The stand-in
# synapse keeps what it is sent and answers as DEPLOY-11 does — a record it
# already has (project, environment, state, revision, run) is `duplicate`.
# ACCESS-27: and `install`'s split of the settings into their templated and
# local halves, and the smoke's login-mode assertion (STUB_MODE is the
# server's mode), with no secret in any argv.
# `cargo test` runs it (tests/deploy_record.rs).
#
#   deploy/tests/pipeline       exit 1 if any check failed
set -uo pipefail

HERE=$(dirname "$(readlink -f "$0")")
DEPLOY=$(dirname "$HERE")
REPO=$(git -C "$DEPLOY" rev-parse --show-toplevel)
SCRATCH=$(mktemp -d); trap 'chmod -R u+w "$SCRATCH"; rm -rf "$SCRATCH"' EXIT # releases are read-only
pass=0 fail=0
ok()  { pass=$((pass + 1)); }
bad() { fail=$((fail + 1)); printf 'FAIL %s\n' "$*" >&2; }
same() { [[ $2 == "$3" ]] && ok || bad "$1: got '$2', wanted '$3'"; }
has()  { [[ $2 == *"$3"* ]] && ok || bad "$1: wanted '$3' in: $2"; }

# ── the throwaway root ──────────────────────────────────────────────────────
export HOME=$SCRATCH/home
unset MENGER_DEPLOY_HOME MENGER_DEPLOY_OUTBOX MENGER_DEPLOY_TRACKER_HOST MENGER_DEPLOY_TRACKER_TOKEN DEPLOY_SMOKE_FAIL SMOKE_DRILLED MENGER_DEPLOY_KEY MENGER_DEPLOY_KEY_FILE MENGER_CALL
export MENGER_DEPLOY_TRACKER_PORT=4769
# Belt and braces: even a real systemctl --user would find no bus.
export XDG_RUNTIME_DIR=$SCRATCH/no-runtime DBUS_SESSION_BUS_ADDRESS=unix:path=$SCRATCH/no-bus
D=$HOME/.local/share/menger-deploy
OUT=$D/outbox
mkdir -p "$SCRATCH/bin" "$HOME/.config/menger" "$D/releases"
for e in prod test; do
  printf 'MENGER_DB_PATH=%s\nMENGER_WS_PORT=1\nMENGER_SHELL_PORT=2\nMENGER_REST_PORT=3\nMENGER_DIAGRAMS_PORT=4\nMENGER_EXPECT_LOGIN=off\n' \
    "$SCRATCH/data/$e/tickets.db" >"$HOME/.config/menger/$e.env"
  ( umask 077; echo '# the local half (ACCESS-27)' >"$HOME/.config/menger/$e.local.env" )
done

stub() { printf '#!/usr/bin/env bash\n%s\n' "$2" >"$SCRATCH/bin/$1"; chmod +x "$SCRATCH/bin/$1"; }
stub systemctl '[[ ${STUB_RESTART_FAILS:-} == 1 && " $* " == *" restart "* ]] && exit 1
[[ " $* " == *" is-active "* ]] && { [[ " $* " == *" --quiet "* ]] || echo active; }; exit 0'
for t in ss npm sqlite3; do stub $t 'exit 0'; done
# ACCESS-27: node answers the smoke's mode probe as STUB_MODE says (the
# server's login mode), and health for a token read from stdin; curl signs the
# smoke account in (its form read from stdin) and serves the login page. Both
# keep their argv in $STUB_ARGV, and curl its stdin in $STUB_STDIN, so a
# check can say no secret rode in argv.
# ACCESS-47: and deploy/menger-call.mjs as the tracker under login answers
# the pipeline's key (STUB_TRACKER: gate — the key refused; refuse — in band),
# keeping the key's file and any key in the environment in $STUB_ARGV.
stub node 'echo "node $*" >>"$STUB_ARGV"
case " $* " in
  *smoke-mode.mjs*) echo "login: ${STUB_MODE:-off}" ;;
  *smoke-health.mjs*" - "*) read -r t; [[ -n $t ]] && echo "ticket_count: 3" ;;
  *menger-call.mjs*)
    echo "keyfile=${MENGER_DEPLOY_KEY_FILE:-} key=${MENGER_DEPLOY_KEY:-}" >>"$STUB_ARGV"
    while [[ $# -gt 0 ]]; do [[ $1 == --params ]] && rec=$2; shift; done
    [[ ${STUB_TRACKER:-up} == gate ]] && { echo "{\"code\":\"-32003\",\"error_kind\":\"forbidden\",\"message\":\"needs deployments.record\",\"type\":\"error\"}"; exit 3; }
    case " $* " in *" tickets.health "*) ;; esac
    if [[ $rec == "{}" ]]; then echo "{\"ticket_count\":3,\"type\":\"health\"}"; exit 0; fi
    [[ ${STUB_TRACKER:-up} == refuse ]] && { echo "{\"message\":\"no shortcode MENGER\",\"type\":\"error\"}"; exit 3; }
    key=$(jq -c "[.project, .environment, .state, .revision, (.source.run // .at)]" <<<"$rec")
    grep -qxF -- "$key" "$STUB_KEYS" 2>/dev/null && dup=true || { dup=false; echo "$key" >>"$STUB_KEYS"; echo "$rec" >>"$STUB_SENT"; }
    echo "{\"type\":\"deployed\",\"deployment\":{\"id\":1},\"duplicate\":$dup}" ;;
esac; exit 0'
stub curl '[[ " $* " == *"Host: evil.example"* ]] && { printf %s "${STUB_HOST_CODE:-421}"; exit 0; }
echo "curl $*" >>"$STUB_ARGV"
case " $* " in
  *" -X POST "*) cat >>"$STUB_STDIN"; echo "{\"access_token\":\"tok-$STUB_SECRET\"}" ;;
  *redirect_url*) printf "http://127.0.0.1:2/login?next=%%2F" ;;
  */login" "*) echo "<h1>Sign in</h1>" ;;
  *) echo "<meta name=\"menger-ws-port\" content=\"${STUB_WS_PORT:-1}\">" ;;
esac'
# synapse: the smoke's reads answered; deployments.record kept in $SCRATCH/sent.ndjson
# and answered as DEPLOY-11 does, or as STUB_TRACKER says (down, refuse, hang).
stub synapse 'args=" $* "
echo "synapse $*" >>"${STUB_SYNAPSE_ARGV:-/dev/null}"
[[ $args == *" diagrams "* ]] && { echo "diagram_type: flowchart"; exit 0; }
[[ $args == *" health "* ]] && { [[ ${STUB_HEALTH:-up} == down ]] && exit 1; echo "ticket_count: 3"; exit 0; }
case ${STUB_TRACKER:-up} in
  down) echo "Protocol handshake failed" >&2; exit 1 ;;
  hang) sleep 30; exit 1 ;;
  refuse) printf "message: no shortcode MENGER\ntype: error\n"; exit 0 ;;
esac
while [[ $# -gt 0 ]]; do [[ $1 == -p ]] && rec=$2; shift; done
key=$(jq -c "[.project, .environment, .state, .revision, (.source.run // .at)]" <<<"$rec")
grep -qxF -- "$key" "$STUB_KEYS" 2>/dev/null && dup=true || { dup=false; echo "$key" >>"$STUB_KEYS"; echo "$rec" >>"$STUB_SENT"; }
printf "deployment: \n  id: 1\nduplicate: %s\ntype: deployed\n" "$dup"'
export PATH=$SCRATCH/bin:$PATH STUB_SENT=$SCRATCH/sent.ndjson STUB_KEYS=$SCRATCH/keys \
  STUB_ARGV=$SCRATCH/argv STUB_STDIN=$SCRATCH/stdin STUB_SECRET=s3cret-Pw-7f3a
[[ $(command -v systemctl) == "$SCRATCH/bin/systemctl" && $(command -v synapse) == "$SCRATCH/bin/synapse" ]] \
  || { echo "the stand-ins are not first on PATH — refusing to run the pipeline" >&2; exit 1; }

# Three releases at three real commits, so --commits-from-git has something to list.
mapfile -t C < <(git -C "$REPO" log --first-parent --format=%H -3 HEAD | tac)
[[ ${#C[@]} == 3 ]] || { echo "needs three commits in $REPO" >&2; exit 1; }
release() { # N → a release directory at commit C[N]
  local id=2026100${1}T100000Z-${C[$1]:0:7} r
  r=$D/releases/$id; mkdir -p "$r/bin"
  printf 'release:   %s\ncommit:    %s\nsubject:   r%s\n' "$id" "${C[$1]}" "$1" >"$r/RELEASE"
  # ACCESS-25: a release's menger knows --allowed-host, so the smoke asks every port
  printf '#!/usr/bin/env bash\n[[ ${1:-} == --help ]] && echo "--allowed-host <HOST> --rest-port <PORT>"\nexit 0\n' >"$r/bin/menger"; chmod +x "$r/bin/menger"
  echo "$id"
}
R0=$(release 0) R1=$(release 1) R2=$(release 2)
S0=${C[0]:0:7} S1=${C[1]:0:7} S2=${C[2]:0:7}

P=$DEPLOY/pipeline
run() { "$P" "$@" >"$SCRATCH/out" 2>"$SCRATCH/err"; code=$?; err=$(<"$SCRATCH/err"); }
sent() { jq -c "$1" "$STUB_SENT" 2>/dev/null | tail -n "${2:-+1}" | paste -sd' '; }
: >"$STUB_SENT"
mark() { wc -l <"$STUB_SENT"; }
since() { tail -n +$(($1 + 1)) "$STUB_SENT" | jq -c "$2" | paste -sd' '; }

# ── deploy test: started, then succeeded; the first has no previous ────────
m=$(mark); run deploy test "$R0"
same "deploy test exits 0" "$code" 0
same "deploy test: started, succeeded" "$(since "$m" '[.environment, .state, .revision, .previous]')" \
  "[\"test\",\"started\",\"$S0\",null] [\"test\",\"succeeded\",\"$S0\",null]"
runs=$(since "$m" .source.run | tr -d '"')
[[ $runs =~ ^deploy@[0-9TZ:-]+#[0-9]+\ deploy@[0-9TZ:-]+#[0-9]+$ && ${runs% *} == "${runs#* }" ]] && ok || bad "one run id on both records: $runs"
same "the log line ends with the run id" "$(tail -n 1 "$D/deployments.log" | cut -f2,3,5,6)" $'test\tdeploy\tok\t'"${runs% *}"
has "deploy test says it sent" "$err" "record: test succeeded $S0 → menger :4769 (sent)"
same "outbox empty" "$(ls "$OUT" | grep -c json)" 0

# ── deploy test again: previous, and its commits from git ──────────────────
m=$(mark); run deploy test "$R2"
n=$(git -C "$REPO" rev-list --count "${C[0]}..${C[2]}")
same "second deploy: previous and commits (git log previous..revision)" \
  "$(since "$m" "[.state, .previous, (.commits | length), (.commits | index(\"${C[2]}\") != null)]")" \
  "[\"started\",\"$S0\",$n,true] [\"succeeded\",\"$S0\",$n,true]"

# ── the drill: promote --to test fails its smoke and rolls back by itself ──
m=$(mark); DEPLOY_SMOKE_FAIL=test run promote "$R0" --to test
same "drill exits 1 (not promoted)" "$code" 1
same "drill: started, failed, rolled_back" "$(since "$m" '[.state, .revision, .previous]')" \
  "[\"started\",\"$S0\",\"$S2\"] [\"failed\",\"$S0\",\"$S2\"] [\"rolled_back\",\"$S2\",\"$S0\"]"
same "drill: the rollback carries no commits" "$(since "$m" '.commits // "none"' | cut -d' ' -f3)" '"none"'

# ── promote to prod; then rollback prod ────────────────────────────────────
m=$(mark); run promote "$R0"; same "promote prod exits 0" "$code" 0
m2=$(mark); run promote "$R2"; same "second promote exits 0" "$code" 0
m3=$(mark); run rollback prod; same "rollback exits 0" "$code" 0
same "promote prod: started, succeeded" "$(since "$m" '[.environment, .state, .revision]' | cut -d' ' -f1,2)" \
  "[\"prod\",\"started\",\"$S0\"] [\"prod\",\"succeeded\",\"$S0\"]"
# DEPLOY-21: prod promotes from test — every prod record says so; test's none.
same "promote prod: from test" "$(since "$m" '.from // "none"' | cut -d' ' -f1,2)" '"test" "test"'
same "deploy test: from none" "$(jq -c 'select(.environment == "test") | .from // "none"' "$STUB_SENT" | sort -u | paste -sd' ')" '"none"'
same "rollback: started, rolled_back to the previous" "$(since "$m3" '[.state, .revision, .previous, .source.run[0:9]]')" \
  "[\"started\",\"$S0\",\"$S2\",\"rollback@\"] [\"rolled_back\",\"$S0\",\"$S2\",\"rollback@\"]"

# ── the tracker is down: the deploy is unharmed, the records wait ──────────
m=$(mark); STUB_TRACKER=down run deploy test "$R1"
same "tracker down: deploy test exits 0" "$code" 0
same "tracker down: nothing sent" "$(mark)" "$m"
same "tracker down: two records in the outbox" "$(ls "$OUT" | grep -c '\.json$')" 2
has "tracker down: said" "$err" "2 record(s) wait in $OUT"
run status
has "status: the outbox per env" "$(<"$SCRATCH/out")" "outbox    2 record(s) waiting for menger on :4769"
# a hung tracker: each send is cut at MENGER_DEPLOY_RECORD_TIMEOUT
t0=$SECONDS; STUB_TRACKER=hang MENGER_DEPLOY_RECORD_TIMEOUT=1 run sync test; t=$((SECONDS - t0))
same "tracker hung: sync exits 0" "$code" 0
[[ $t -lt 15 ]] && ok || bad "tracker hung: sync took ${t}s"
same "tracker hung: four records wait" "$(ls "$OUT" | grep -c '\.json$')" 4
# … and the next run sends them first, oldest first
m=$(mark); run sync test
same "next run: the outbox first, then its own" "$(since "$m" '[.state, .source.run[0:5]]')" \
  '["started","deplo"] ["succeeded","deplo"] ["started","sync@"] ["succeeded","sync@"] ["started","sync@"] ["succeeded","sync@"]'
same "next run: outbox empty" "$(ls "$OUT" | grep -c '\.json$')" 0

# ── refused: kept aside, said, never retried; the deploy unharmed ───────────
STUB_TRACKER=refuse run sync test
same "refused: sync exits 0" "$code" 0
same "refused: both in refused/" "$(ls "$OUT/refused" | grep -c '\.json$')" 2
has "refused: said" "$err" "menger refused test started $S1: no shortcode MENGER"

# ── a run that dies after started sends failed on its way out ───────────────
m=$(mark); STUB_RESTART_FAILS=1 run deploy test "$R2"
[[ $code != 0 ]] && ok || bad "a failing restart fails the deploy"
same "died: started, then failed" "$(since "$m" .state)" '"started" "failed"'

# ── status: the last record sent per environment ───────────────────────────
run status
out=$(<"$SCRATCH/out")
has "status: prod's last record" "$out" "record    rolled_back $S0 ($R0) at "
has "status: test's last record" "$out" "record    failed $S2 ($R2) at "

# ── backfill: the log replayed; a run's own line is the record it sent ─────
legacy=$(printf '2026-09-30T10:00:00Z\ttest\tdeploy\t%s\tok\n2026-09-30T10:01:00Z\tprod\tpromote\t%s\tok\n' "$R0" "$R0")
{ echo "$legacy"; cat "$D/deployments.log"; } >"$SCRATCH/log" && cp "$SCRATCH/log" "$D/deployments.log"
m=$(mark); run backfill
same "backfill exits 0" "$code" 0
# new: the two older lines, and the sync whose records menger refused
has "backfill: only what menger has not kept is new" "$err" "record: 3 sent, "
same "backfill: the older lines' records" "$(since "$m" '[.environment, .state, .source.run]' | cut -d' ' -f1,2)" \
  '["test","succeeded","deploy@2026-09-30T10:00:00Z"] ["prod","succeeded","promote@2026-09-30T10:01:00Z"]'
m=$(mark); run backfill
has "backfill again: nothing new" "$err" "record: 0 sent, "
same "backfill again: nothing sent" "$(mark)" "$m"
STUB_TRACKER=down run backfill
same "backfill, tracker down: exits 0" "$code" 0
has "backfill, tracker down: queued" "$err" "wait in $OUT"

# ── DEPLOY-23: a record's commits start at the last run that passed ────────
# A failed run's commits ride with the next run that passes — never lost
# because the range began at the failed (or rolled-back) one.
run backfill # the outbox drained: what follows is only these runs' records
has "backfill drains the outbox" "$err" "record: 0 sent, "
range() { git -C "$REPO" rev-list --count "${C[$1]}..${C[$2]}"; }
holds() { echo "(.commits // [] | index(\"${C[$1]}\") != null)"; }
# test died on R2 above (no log line): the last run that passed ran R1
m=$(mark); run deploy test "$R0"
same "after a run that died: previous the last that passed" "$(since "$m" '[.state, .previous]')" \
  "[\"started\",\"$S1\"] [\"succeeded\",\"$S1\"]"
# fail, then succeed: the success carries both ranges
m=$(mark); DEPLOY_SMOKE_FAIL=test run deploy test "$R1"
same "fail: exits 1" "$code" 1
same "fail: started, failed, from R0" "$(since "$m" "[.state, .revision, .previous, (.commits | length)]")" \
  "[\"started\",\"$S1\",\"$S0\",$(range 0 1)] [\"failed\",\"$S1\",\"$S0\",$(range 0 1)]"
m=$(mark); run deploy test "$R2"
same "then succeed: exits 0" "$code" 0
same "then succeed: previous the last that passed (R0), not the failed R1" \
  "$(since "$m" "[.state, .revision, .previous, (.commits | length), $(holds 1), $(holds 2)]")" \
  "[\"started\",\"$S2\",\"$S0\",$(range 0 2),true,true] [\"succeeded\",\"$S2\",\"$S0\",$(range 0 2),true,true]"
# a sync that passes on a release whose deploy failed carries that deploy's commits
run deploy test "$R0"; same "back on R0" "$code" 0
DEPLOY_SMOKE_FAIL=test run deploy test "$R1"; same "R1 fails" "$code" 1
m=$(mark); run sync test
same "sync after a failed deploy: exits 0" "$code" 0
same "sync after a failed deploy: R1 from R0, its commits" "$(since "$m" "[.state, .revision, .previous, (.commits | length), $(holds 1)]")" \
  "[\"started\",\"$S1\",\"$S0\",$(range 0 1),true] [\"succeeded\",\"$S1\",\"$S0\",$(range 0 1),true]"
m=$(mark); run sync test
same "sync again: nothing new" "$(since "$m" '[.previous, (.commits // [] | length)]')" "[\"$S1\",0] [\"$S1\",0]"
# promote: rolled back by itself, then succeed — from the release it returned to
same "prod runs R0" "$(basename "$(readlink -f "$D/envs/prod/current")")" "$R0"
m=$(mark); DEPLOY_SMOKE_FAIL=prod run promote "$R1"
same "promote rolled back: exits 1" "$code" 1
same "promote rolled back: started, failed from R0; rolled_back to R0" "$(since "$m" '[.state, .revision, .previous]')" \
  "[\"started\",\"$S1\",\"$S0\"] [\"failed\",\"$S1\",\"$S0\"] [\"rolled_back\",\"$S0\",\"$S1\"]"
m=$(mark); run promote "$R2"
same "then promote: exits 0" "$code" 0
same "then promote: from R0, both ranges" "$(since "$m" "[.state, .previous, (.commits | length), $(holds 1), $(holds 2)]")" \
  "[\"started\",\"$S0\",$(range 0 2),true,true] [\"succeeded\",\"$S0\",$(range 0 2),true,true]"
# a rollback whose smoke failed is no start: prod runs R0, last passed on R2
DEPLOY_SMOKE_FAIL=prod run rollback prod; same "a failed rollback exits 1" "$code" 1
same "the failed rollback left prod on R0" "$(basename "$(readlink -f "$D/envs/prod/current")")" "$R0"
m=$(mark); run promote "$R1"
same "promote after a failed rollback: exits 0" "$code" 0
same "promote after a failed rollback: from R2, the last that passed" "$(since "$m" '[.state, .previous, (.commits // [] | length)]')" \
  "[\"started\",\"$S2\",$(range 2 1)] [\"succeeded\",\"$S2\",$(range 2 1)]"

# ── DEPLOY-17: the landing page — infra a stand-in, the export of landing/ real ──
INFRA=$SCRATCH/infra; mkdir -p "$INFRA/bin" "$INFRA/inventory/group_vars/all"
printf '# pins\nmenger_landing_commit: %s\nedge_www: []\n' "${C[0]}" >"$INFRA/inventory/group_vars/all/main.yml"
# the stand-in infra keeps every call; STUB_INFRA=fail fails an apply (never a --check)
printf '#!/usr/bin/env bash\nprintf "%%s\\n" "$*" >>"$STUB_INFRA_LOG"\n[[ ${STUB_INFRA:-ok} == fail && " $* " != *" --check "* ]] && exit 1\nexit 0\n' >"$INFRA/bin/infra"
chmod +x "$INFRA/bin/infra"
export GIT_AUTHOR_NAME=pipeline-test GIT_AUTHOR_EMAIL=t@t GIT_COMMITTER_NAME=pipeline-test GIT_COMMITTER_EMAIL=t@t
git -C "$INFRA" init -q && git -C "$INFRA" add -A && git -C "$INFRA" commit -qm "the pins"
export MENGER_INFRA_DIR=$INFRA MENGER_LANDING_URL=none STUB_INFRA_LOG=$SCRATCH/infra.log
pin() { sed -n 's/^menger_landing_commit: *//p' "$INFRA/inventory/group_vars/all/main.yml"; }
: >"$STUB_INFRA_LOG"

# --check: the gate, then infra's dry run with the commit as an extra var; nothing written, nothing recorded
m=$(mark); run landing --check "${C[2]}"
same "landing --check exits 0" "$code" 0
has "landing --check: infra's dry run, the commit as an extra var" "$(<"$STUB_INFRA_LOG")" "edge.yml --check --diff -e menger_landing_commit=${C[2]}"
same "landing --check: the pin untouched" "$(pin)" "${C[0]}"
same "landing --check: nothing recorded" "$(mark)" "$m"
has "landing --check: says" "$err" "checked: $S2 passes the gate and infra would take it; nothing written"

# the deploy: the pin moved, infra applied, the pin committed, recorded as edge with the old pin as previous
: >"$STUB_INFRA_LOG"; m=$(mark); run landing "${C[2]}"
same "landing exits 0" "$code" 0
same "landing: infra applied" "$(<"$STUB_INFRA_LOG")" "edge.yml"
same "landing: the pin is the commit" "$(pin)" "${C[2]}"
has "landing: the pin committed in infra" "$(git -C "$INFRA" log -1 --format=%s)" "menger.sh at $S2 — "
n=$(git -C "$REPO" rev-list --count "${C[0]}..${C[2]}")
same "landing: started, succeeded for edge; previous the old pin; commits from git" \
  "$(since "$m" '[.environment, .state, .revision, .previous, (.commits | length)]')" \
  "[\"edge\",\"started\",\"$S2\",\"$S0\",$n] [\"edge\",\"succeeded\",\"$S2\",\"$S0\",$n]"
same "landing: the log line" "$(tail -n 1 "$D/deployments.log" | cut -f2,3,5)" $'edge\tdeploy\tok'
has "landing: says" "$err" "menger.sh serves $S2"
# the same commit again: nothing to commit in infra, still recorded
m=$(mark); run landing "${C[2]}"
same "landing again exits 0" "$code" 0
has "landing again: the pin already held it" "$err" "the pin already held $S2 — nothing to commit"
same "landing again: recorded with itself as previous" "$(since "$m" '[.state, .revision, .previous]')" \
  "[\"started\",\"$S2\",\"$S2\"] [\"succeeded\",\"$S2\",\"$S2\"]"

# a failed apply: infra's role has put the old files back; the pin restored, failed recorded, exit 1
k=$(git -C "$INFRA" rev-parse HEAD)
m=$(mark); STUB_INFRA=fail run landing "${C[1]}"
same "failed apply exits 1" "$code" 1
same "failed apply: the pin restored" "$(pin)" "${C[2]}"
same "failed apply: nothing committed in infra" "$(git -C "$INFRA" rev-parse HEAD)" "$k"
same "failed apply: started, failed" "$(since "$m" '[.state, .revision, .previous]')" "[\"started\",\"$S1\",\"$S2\"] [\"failed\",\"$S1\",\"$S2\"]"
has "failed apply: says" "$err" "the edge did not take $S1"

# status shows the edge
run status
out=$(<"$SCRATCH/out")
has "status: the edge's pin" "$out" "landing   $S2"
has "status: the edge's last record" "$out" "record    failed $S1"

# ── ACCESS-47: under login the pipeline signs in with its key, a file ─────
K=$HOME/.plexus/keys/pipeline.key; mkdir -p "${K%/*}"
( umask 077; echo "seed-$STUB_SECRET" >"$K" )
: >"$STUB_ARGV"; m=$(mark); MENGER_DEPLOY_KEY=from-env run sync test
same "the key: sync exits 0" "$code" 0
same "the key: started, succeeded sent" "$(since "$m" '[.environment, .state]')" '["test","started"] ["test","succeeded"]'
has "the key: over the socket, as the pipeline" "$(<"$STUB_ARGV")" "--url ws://127.0.0.1:4769 --agent pipeline deployments.record"
has "the key: menger-call reads its file, no key in its environment" "$(<"$STUB_ARGV")" "keyfile=$K key="$'\n'
[[ $(<"$STUB_ARGV") != *"seed-$STUB_SECRET"* ]] && ok || bad "the pipeline's key rode in argv"
has "the key: said as sent" "$err" "record: test succeeded $S1 → menger :4769 (sent)"
run status
has "status: health signed in as the pipeline key" "$(<"$SCRATCH/out")" "health    3 tickets on :1 (signed in as the pipeline key)"
STUB_TRACKER=gate run status
has "status: the gate's refusal named" "$(<"$SCRATCH/out")" "health    no answer on :1 (forbidden)"
