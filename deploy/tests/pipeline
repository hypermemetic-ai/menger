rrun() { : >"$STUB_DOCKER"; : >"$SCRATCH/infra.argv"; : >"$HF"; HOME=$H3 MENGER_INFRA_DIR=$INF HF_OUTPUTS=$HF run "$@"; }
rrun remote test --image "$LI"
same "remote test, no app.yml: exits 1" "$code" 1
has "remote test, no app.yml: RUN-11 named" "$err" "app-test.menger.sh is not declared yet (RUN-11): menger has no deploy/app.yml"
has "remote test, no app.yml: nothing changed" "$err" "nothing was changed"
same "remote test, no app.yml: no outputs" "$(<"$SCRATCH/out")$(<"$HF")" ""
same "remote test, no app.yml: neither infra nor docker asked" "$(cat "$SCRATCH/infra.argv" "$STUB_DOCKER")" ""
rrun remote prod
same "remote prod, no app.yml: exits 1" "$code" 1
has "remote prod, no app.yml: RUN-11 named" "$err" "app.menger.sh is not declared yet (RUN-11)"
same "remote prod, no app.yml: neither infra nor docker asked" "$(cat "$SCRATCH/infra.argv" "$STUB_DOCKER")" ""
rrun remote staging
same "remote, an unknown environment: exits 1" "$code" 1
has "remote, an unknown environment: usage" "$err" "usage: deploy/pipeline remote test --image IMAGE | remote prod"
# once deploy/app.yml exists: infra's own playbooks, test by the image's commit, prod by promotion only
echo 'app: menger' >"$SCRATCH/app.yml"
MENGER_APP_YML=$SCRATCH/app.yml rrun remote test
same "remote test, no image: exits 1" "$code" 1
has "remote test, no image: said" "$err" "remote test needs an image"
MENGER_APP_YML=$SCRATCH/app.yml rrun remote test --image "$LI"
same "remote test: exits 0" "$code" 0
same "remote test: infra's app.yml, test, the release's commit" "$(<"$SCRATCH/infra.argv")" \
  "infra app.yml -e app_dir=$(dirname "$(git -C "$REPO" rev-parse --path-format=absolute --git-common-dir)") -e env=test -e sha=${IC[1]:0:7}"
same "remote test: url" "$(<"$HF")" "url=https://app-test.menger.sh/"
MENGER_APP_YML=$SCRATCH/app.yml rrun remote prod
same "remote prod: exits 0" "$code" 0
has "remote prod: promote.yml only" "$(<"$SCRATCH/infra.argv")" "infra promote.yml -e app_dir="
same "remote prod: url" "$(<"$HF")" "url=https://app.menger.sh/"
# the pipeline declares these very commands
PT=$REPO/.hyperforge/pipelines.toml
has "pipelines.toml: build is deploy/pipeline image" "$(grep -A3 'name = "build"' "$PT")" "deploy/pipeline image'"
has "pipelines.toml: deploy-local" "$(grep -A4 'name = "deploy-local"' "$PT")" 'deploy/pipeline local --image "$IMAGE"'
has "pipelines.toml: deploy-test" "$(grep -A4 'name = "deploy-test"' "$PT")" 'deploy/pipeline remote test --image "$IMAGE"'
has "pipelines.toml: deploy-prod needs deploy-test" "$(grep -A4 'name = "deploy-prod"' "$PT")" 'needs = ["deploy-test"]'

printf 'deploy/pipeline records: %d passed, %d failed\n' "$pass" "$fail"
[[ $fail == 0 ]]
