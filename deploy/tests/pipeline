# build stamps that: a first build with no --contract, its manifest's components.*.uses read from
# the tar, `ui contract --uses` them asked of the menger just built, the second build carrying
# --contract with its answer. A bundle naming tickets.list and epics.current is stamped over both
# services (not tickets.schema's hash); the studio likewise over its own uses; the log names the
# services; a studio whose contract cannot be read fails the build as the app's does.
T10=the_contract_covers_every_service_the_bundle_names
. "$STUB_CONTRACT_OVER"
gitf checkout -q -b surface v2
printf '<h1>{live(#{ snapshot: "epics.current" })}</h1>\n' >"$BR/ui/src/e-head.rhx"
gitf add -A && gitf commit -qm "surface: a component naming epics" && gitf checkout -q main
SSHA=$(gitf rev-parse surface)
BOTH=$(contract_over tickets epics) STUDIO_C=$(contract_over ui)
[[ -n $BOTH && $BOTH != "$CONTRACT_HASH" && $STUDIO_C != "$BOTH" ]] && ok || bad "$T10: (setup) the stand-in's contracts are not distinct: '$BOTH' '$CONTRACT_HASH' '$STUDIO_C'"
next_second; bb build --branch surface --no-gate
[[ $code == 0 ]] && ok || bad "$T10: build exits 0, got $code: $(tail -n 3 <<<"$err")"
SR=$(tail -n 1 "$SCRATCH/out")
same "$T10: the release is the branch's" "$(field commit "$D5/releases/$SR/RELEASE")" "$SSHA"
same "$T10: the release's manifest names the contract over epics and tickets" "$(contract_of "$SR")" "$BOTH"
syn=$(<"$STUB_BUILD_SYNAPSE")
has "$T10: ui contract asked for the bundle's uses, every one, once each" "$syn" "menger ui contract --uses epics.current,tickets.list"
same "$T10: tickets.schema not asked" "$(grep -c 'tickets schema' <<<"$syn")" 0
has "$T10: the second build stamped with that answer" "$(<"$STUB_UI_TOOL_LOG")" "plexus-ui build $B/menger-build/ui --strict-colours --engine $B/menger-build/dist/engine --contract $BOTH --commit menger@${SSHA:0:7} -o $B/menger-build/dist/ui.tar"
same "$T10: the app built twice: once to read its uses, once stamped" "$(grep -c "plexus-ui build $B/menger-build/ui --strict-colours " "$STUB_UI_TOOL_LOG")" 2
has "$T10: the log names the services the contract covers" "$err" "contract: $BOTH over epics, tickets"
# the studio: its own uses (ui.versions), its own contract
has "$T10: ui contract asked for the studio's uses" "$syn" "menger ui contract --uses ui.versions"
has "$T10: the studio stamped with its own contract" "$(<"$STUB_UI_TOOL_LOG")" "plexus-ui build $B/menger-build/../plexus-ui/studio --strict-colours --engine $B/menger-build/dist/engine --name studio --contract $STUDIO_C --commit"
same "$T10: the release's studio names its contract" "$(tar -xOf "$D5/releases/$SR/dist/studio.tar" manifest.json 2>/dev/null | jq -r .contract 2>/dev/null)" "$STUDIO_C"
has "$T10: the log names the studio's services" "$err" "studio contract: $STUDIO_C over ui"
same "$T10: the menger started once for both" "$(grep -c . "$STUB_MENGER_RAN")" 1
stopped "$T10: after the build"
same "$T10: the build's scratch removed" "$(ls -A "$T5TMP")" ""
# a tickets-only bundle still stamps the tickets service's hash, through the new call (T6 above)
same "$T10: tickets alone: the old path's value" "$(contract_of "$CR")" "$CONTRACT_HASH"
# the studio's contract unreadable: the build fails, named, and no release
for how in fail refused; do
  n=$(ls "$D5/releases" | wc -l)
  next_second; STUB_CONTRACT=$how STUB_CONTRACT_ON=ui MENGER_CONTRACT_WAIT=2 bb build --branch surface --no-gate
  same "$T10: the studio's contract read fails ($how): exits 1" "$code" 1
  has "$T10: the studio's contract read fails ($how): said, naming the studio and ui.contract" "$err" "studio contract: ui.contract"
  none_made "$T10: the studio's contract read fails ($how)" "$n"
  [[ $(grep -c -- '--contract ' "$STUB_UI_TOOL_LOG") == 0 ]] && ok || bad "$T10: the studio's contract read fails ($how): a bundle stamped all the same"
  stopped "$T10: the studio's contract read fails ($how)"
done
# a studio naming no service: built unstamped, never asked, said
cp "$B/plexus-ui/studio/src/s-page.rhx" "$B/s-page.rhx.away"; printf '<p>s</p>\n' >"$B/plexus-ui/studio/src/s-page.rhx"
next_second; bb build --branch surface --no-gate
[[ $code == 0 ]] && ok || bad "$T10: a studio naming no service: build exits 0, got $code: $(tail -n 3 <<<"$err")"
NR=$(tail -n 1 "$SCRATCH/out")
same "$T10: a studio naming no service: its manifest says unknown" "$(tar -xOf "$D5/releases/$NR/dist/studio.tar" manifest.json 2>/dev/null | jq -r .contract 2>/dev/null)" "unknown"
same "$T10: a studio naming no service: the app still stamped over both" "$(contract_of "$NR")" "$BOTH"
same "$T10: a studio naming no service: ui contract asked once, for the app" "$(grep -c 'menger ui contract' "$STUB_BUILD_SYNAPSE")" 1
same "$T10: a studio naming no service: no studio build stamped" "$(grep -- '--name studio' "$STUB_UI_TOOL_LOG" | grep -c -- '--contract ')" 0
has "$T10: a studio naming no service: said" "$err" "studio contract: none"
mv "$B/s-page.rhx.away" "$B/plexus-ui/studio/src/s-page.rhx"
# a bundle whose manifest cannot be read: the build fails, naming it, never "names no service" nor a studio shipped unstamped
for which in app studio; do
  n=$(ls "$D5/releases" | wc -l)
  next_second; STUB_TOOL_BROKEN=$which bb build --branch surface --no-gate
  same "$T10: the $which's manifest unreadable: exits 1" "$code" 1
  has "$T10: the $which's manifest unreadable: said" "$err" "no readable manifest.json"
  [[ $err != *"names no service"* ]] && ok || bad "$T10: the $which's manifest unreadable: said as naming no service: $err"
  none_made "$T10: the $which's manifest unreadable" "$n"
  same "$T10: the $which's manifest unreadable: nothing started" "$(grep -c . "$STUB_MENGER_RAN")" 0
done

# ── V2-7 the_image_carries_the_bundle_and_the_flags ────────────────────────
T2=the_image_carries_the_bundle_and_the_flags
H6=$SCRATCH/home6; D6=$H6/.local/share/menger-deploy; mkdir -p "$D6/releases"
v2release() { # DIR N WASM(0/1) [BUNDLE] [DAY] → a v2 release at IC[N], laid out as build makes one: bin/, dist/, RELEASE
  local id=202610${5:-2$2}T100000Z-${IC[$2]:0:7} r
  r=$1/$id; mkdir -p "$r/bin" "$r/dist"
  printf 'release:   %s\ncommit:    %s\nbranch:    v2\nsubject:   v%s\nsteps:     cargo build, ui-build%s\n' "$id" "${IC[$2]}" "$2" "$([[ $3 == 1 ]] && echo ', ui-compiler-wasm')" >"$r/RELEASE"
  printf '#!/usr/bin/env bash\n[[ ${1:-} == --help-all || ${1:-} == --help ]] && echo "--bind <ADDR>"\nexit 0\n' >"$r/bin/menger"
  cp "$REPO/deploy/launch/run-menger" "$r/bin/run-menger"; chmod +x "$r/bin/"*
  cp "${4:-$UBC/dist/ui.tar}" "$r/dist/ui.tar"
  [[ $3 == 1 ]] && printf '\0asm\1\0\0\0' >"$r/dist/ui-compiler.wasm"
  [[ -n ${STUDIO_TAR:-} ]] && cp "$STUDIO_TAR" "$r/dist/studio.tar"
  chmod -R a-w "$r"; echo "$id"
}
V6=$(v2release "$D6/releases" 1 1) V6N=$(v2release "$D6/releases" 2 0)
export STUB_CTX_COPY=$V2/ctx
stub docker 'echo "docker $*" >>"$STUB_DOCKER"
case $1 in
  build) ctx=${*: -1}; (cd "$ctx" && find . -type f | LC_ALL=C sort | paste -sd" ") >"$STUB_CONTEXT"
         n=$STUB_CTX_COPY.$(date +%s%N); cp -r "$ctx" "$n"; echo "$n" >"$STUB_CTX_COPY.last" ;;
  image) echo "sha256:5ca1ab1e 123 bytes" ;;
esac; exit 0'
irun6() { : >"$STUB_DOCKER"; : >"$STUB_CONTEXT"; rm -f "$STUB_CTX_COPY.last"; HOME=$H6 TMPDIR=$SCRATCH/tmp run "$@"; }
# the entrypoint as the image starts it: its run-menger, menger an echo of its arguments; two signers
entry_args() { local c; c=$(cat "$STUB_CTX_COPY.last" 2>/dev/null) || return 0; [[ -f $c/release/bin/run-menger ]] || return 0
  chmod -R u+w "$c"; printf '#!/bin/sh\necho "$*"\n' >"$c/release/bin/menger"; chmod +x "$c/release/bin/menger"
  env -i PATH="$PATH" MENGER_WS_PORT=8080 MENGER_SHELL_PORT=8081 MENGER_DB_PATH=/data/tickets.db \
    MENGER_UI_SIGNERS="$PUB2;$PUB3" sh "$c/release/bin/run-menger" 2>&1; }
irun6 image "$V6"
same "$T2: image of a v2 release exits 0" "$code" 0
ctxl=$(<"$STUB_CONTEXT")
has "$T2: the context holds dist/ui.tar" "$ctxl" "./release/dist/ui.tar"
has "$T2: the context holds dist/ui-compiler.wasm" "$ctxl" "./release/dist/ui-compiler.wasm"
[[ $ctxl != *./release/app/* ]] && ok || bad "$T2: an app/ in a v2 image: $ctxl"
df=$(cat "$(cat "$STUB_CTX_COPY.last" 2>/dev/null)/Dockerfile" 2>/dev/null)
has "$T2: the Dockerfile copies dist/ into the image" "$df" "release/dist"
has "$T2: … at /opt/menger/dist" "$df" "/opt/menger/dist"
has "$T2: run-menger is the entrypoint" "$df" "/opt/menger/bin/run-menger"
a=$(entry_args)
[[ $a =~ --ui-db-path\ /data/[^\ ]+ ]] && ok || bad "$T2: the entrypoint passes no --ui-db-path under the data volume: '$a'"
has "$T2: the entrypoint passes --ui-signer, the first key" "$a" "--ui-signer $PUB2"
has "$T2: the entrypoint passes --ui-signer, the second key" "$a" "--ui-signer $PUB3"
same "$T2: one --ui-signer per key" "$(grep -o -- '--ui-signer' <<<"$a" | wc -l)" 2
[[ $a =~ --ui-compiler\ [^\ ]*/dist/ui-compiler\.wasm ]] && ok || bad "$T2: the entrypoint passes no --ui-compiler <…/dist/ui-compiler.wasm>: '$a'"
# until UI-5 lands a release may hold no compiler module: imaged all the same, the flag omitted
irun6 image "$V6N"
same "$T2: a release with no compiler module: exits 0" "$code" 0
a=$(entry_args)
has "$T2: … the signer still passed" "$a" "--ui-signer $PUB2"
[[ -n $a && $a != *--ui-compiler* ]] && ok || bad "$T2: --ui-compiler with no module (or no entrypoint ran): '$a'"
# the pipeline's public key is the orchestrator's to write: its format checked only when it is there
if sl=$(grep '^MENGER_UI_SIGNERS=' "$REPO/deploy/env/app-test.env"); then
  [[ ${sl#*=} =~ ^[0-9a-f]{64}(\;[0-9a-f]{64})*$ ]] && ok || bad "$T2: deploy/env/app-test.env's MENGER_UI_SIGNERS is not 64-hex keys: $sl"
else ok; fi

