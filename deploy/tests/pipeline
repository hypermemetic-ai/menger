#!/usr/bin/env bash
# DEPLOY-12: deploy/pipeline's deployment records, on a throwaway root — HOME
# is a scratch directory (the releases, the log, the outbox) and node, curl,
# synapse, docker, gh and hypermemetic-infra are stand-ins, so a whole remote
# test (infra, then the smoke from outside), remote prod, the suite after the
# deploy, backfill and status run in seconds and touch nothing real: no unit,
# no port, no deployment, no tracker. The stand-in tracker (deploy/menger-call.mjs
# as node, and synapse) keeps what it is sent and answers as DEPLOY-11 does — a
# record it already has (project, environment, state, revision, run) is
# `duplicate`. DEPLOY-52: test is app-test.menger.sh and prod app.menger.sh;
# this machine's environments are retired, so their commands say so and exit 2.
# `cargo test` runs it (tests/deploy_record.rs).
#
#   deploy/tests/pipeline       exit 1 if any check failed
set -uo pipefail

HERE=$(dirname "$(readlink -f "$0")")
DEPLOY=$(dirname "$HERE")
REPO=$(git -C "$DEPLOY" rev-parse --show-toplevel)
SCRATCH=$(mktemp -d); trap 'chmod -R u+w "$SCRATCH"; rm -rf "$SCRATCH"' EXIT # releases are read-only
pass=0 fail=0
ok()  { pass=$((pass + 1)); }
bad() { fail=$((fail + 1)); printf 'FAIL %s\n' "$*" >&2; }
same() { [[ $2 == "$3" ]] && ok || bad "$1: got '$2', wanted '$3'"; }
has()  { [[ $2 == *"$3"* ]] && ok || bad "$1: wanted '$3' in: $2"; }

# ── the throwaway root ──────────────────────────────────────────────────────
export HOME=$SCRATCH/home
unset MENGER_DEPLOY_HOME MENGER_DEPLOY_OUTBOX MENGER_DEPLOY_TRACKER_HOST MENGER_DEPLOY_TRACKER_TOKEN DEPLOY_SMOKE_FAIL MENGER_DEPLOY_KEY MENGER_DEPLOY_KEY_FILE MENGER_CALL \
  MENGER_APP_TEST_URL MENGER_APP_URL MENGER_SUITE_CHECKOUT MENGER_APP_YML IMAGE_STORE MENGER_BUILD_CHECKOUT MENGER_BUILD_TARGET MENGER_CODEGEN_IMAGE MENGER_DEPLOY_LOGS MENGER_CONTRACT_WAIT
export MENGER_DEPLOY_TRACKER_PORT=4769
# DEPLOY-28: the tracker is app.menger.sh by default; `local` is :4769, the stand-ins
# below (DEPLOY-28's own checks unset it, and dial app.menger.sh's stand-in)
export MENGER_DEPLOY_TRACKER_URL=local MENGER_SMOKE_WAIT=1
unset MENGER_DEPLOY_COMPLETE_KEY_FILE
# Belt and braces: even a real systemctl --user would find no bus.
export XDG_RUNTIME_DIR=$SCRATCH/no-runtime DBUS_SESSION_BUS_ADDRESS=unix:path=$SCRATCH/no-bus
D=$HOME/.local/share/menger-deploy
OUT=$D/outbox
mkdir -p "$SCRATCH/bin" "$HOME/.config/menger" "$D/releases"
# the pipeline's key, a file (ACCESS-47): the smoke reads health as it, records go as it
K=$HOME/.plexus/keys/pipeline.key; mkdir -p "${K%/*}"
export STUB_SECRET=s3cret-Pw-7f3a
( umask 077; echo "seed-$STUB_SECRET" >"$K" )

stub() { printf '#!/usr/bin/env bash\n%s\n' "$2" >"$SCRATCH/bin/$1"; chmod +x "$SCRATCH/bin/$1"; }
stub systemctl 'echo "systemctl $*" >>"$STUB_SYSTEMCTL"; [[ " $* " == *" is-active "* ]] && echo active; exit 0'
# node: deploy/menger-call.mjs as the tracker under login. health ({} params) for a key,
# `unauthenticated` for none (STUB_HEALTH: down — no answer; gate — forbidden); a record
# kept and answered as DEPLOY-11 does (STUB_TRACKER: down, hang, gate — the key refused,
# refuse — in band). It keeps its argv, the key's file and any key in the environment in
# $STUB_ARGV, so a check can say no secret rode in argv.
stub node 'echo "node $*" >>"$STUB_ARGV"
case " $* " in
  *menger-call.mjs*)
    echo "keyfile=${MENGER_DEPLOY_KEY_FILE:-} key=${MENGER_DEPLOY_KEY:-}" >>"$STUB_ARGV"
    all=" $* "
    [[ $all == *" --principal "* ]] && { echo "key:$(printf "ab%.0s" {1..32})"; exit 0; }
    while [[ $# -gt 0 ]]; do [[ $1 == --params ]] && rec=$2; shift; done
    if [[ $rec == "{}" ]]; then
      # STUB_HEALTH=anon: an anonymous socket reaches past the auth door (what the smoke must catch)
      [[ -z ${MENGER_DEPLOY_KEY_FILE:-}${MENGER_DEPLOY_KEY:-} && ${STUB_HEALTH:-up} != anon ]] && { echo "{\"error_kind\":\"unauthenticated\",\"message\":\"sign in first\",\"type\":\"error\"}"; exit 3; }
      case ${STUB_HEALTH:-up} in
        down) exit 1 ;;
        gate) echo "{\"error_kind\":\"forbidden\",\"message\":\"needs tickets.health\",\"type\":\"error\"}"; exit 3 ;;
      esac
      echo "{\"ticket_count\":3,\"type\":\"health\"}"; exit 0
    fi
    case ${STUB_TRACKER:-up} in
      down) exit 1 ;;
      hang) sleep 30; exit 1 ;;
      gate) echo "{\"code\":\"-32003\",\"error_kind\":\"forbidden\",\"message\":\"needs deployments.record\",\"type\":\"error\"}"; exit 3 ;;
    esac
    # DEPLOY-28: which carried tickets are In Review there (STUB_INREVIEW), and the completion
    case $all in
      *" tickets.nav.member "*) echo "member $rec" >>"$STUB_ARGV"
        jq -c --arg in " ${STUB_INREVIEW:-} " ".ids[] | {type: \"member\", id: ., matched: (. as \$id | \$in | contains(\" \" + \$id + \" \"))}" <<<"$rec"; exit 0 ;;
      *" tickets.update_many "*) echo "$rec" >>"$STUB_COMPLETED"
        [[ ${STUB_COMPLETE:-} == refuse ]] && { echo "{\"code\":\"-32003\",\"error_kind\":\"forbidden\",\"message\":\"needs tickets.update_many on MENGER-7\",\"type\":\"error\"}"; exit 3; }
        echo "{\"type\":\"updated_many\"}"; exit 0 ;;
    esac
    [[ ${STUB_TRACKER:-up} == refuse ]] && { echo "{\"message\":\"no shortcode MENGER\",\"type\":\"error\"}"; exit 3; }
    key=$(jq -c "[.project, .environment, .state, .revision, (.source.run // .at)]" <<<"$rec")
    grep -qxF -- "$key" "$STUB_KEYS" 2>/dev/null && dup=true || { dup=false; echo "$key" >>"$STUB_KEYS"; echo "$rec" >>"$STUB_SENT"; }
    echo "{\"type\":\"deployed\",\"deployment\":{\"id\":1},\"carried\":${STUB_CARRIED:-[]},\"duplicate\":$dup}" ;;
esac; exit 0'
# curl: app-test / app.menger.sh as the smoke meets them from outside (STUB_SMOKE=fail: the
# login page is not menger'"'"'s), and the local app'"'"'s page on loopback.
stub curl 'echo "curl $*" >>"$STUB_ARGV"
url=""; for a in "$@"; do [[ $a == http://* || $a == https://* ]] && url=$a; done
host=${url#*://}; host=${host%%/*}
case $url in
  http://127.0.0.1:*/login) [[ ${STUB_LOCAL_LOGIN:-ok} == ok ]] && echo "<h1>Sign in</h1>" || echo "<h1>Not found</h1>" ;;
  http://127.0.0.1:*) echo "<meta name=\"menger-ws-port\" content=\"${STUB_WS_PORT:-1}\">" ;;
  http://*) printf "308 https://%s/" "$host" ;;
  */.well-known/oauth-protected-resource/ws) printf "{\"resource\":\"https://%s/ws\"}" "$host" ;;
  */ws) printf 403 ;;
  */login) [[ ${STUB_SMOKE:-ok} == fail ]] && { echo "<h1>Not found</h1>"; exit 0; }; echo "<h1>Sign in</h1>" ;;
  */app/*) printf "%s" "${STUB_APP_CODE:-200}" ;;
  */) printf "HTTP/2 303\r\nlocation: /login?next=%%2F\r\nstrict-transport-security: max-age=31536000\r\n\r\n" ;;
esac; exit 0'
# synapse: deployments.record kept in $SCRATCH/sent.ndjson and answered as DEPLOY-11
# does, or as STUB_TRACKER says (down, refuse, hang) — the way with no key.
stub synapse 'args=" $* "
echo "synapse $*" >>"${STUB_SYNAPSE_ARGV:-/dev/null}"
[[ $args == *" health "* ]] && { [[ ${STUB_HEALTH:-up} == down ]] && exit 1; echo "ticket_count: 3"; exit 0; }
case ${STUB_TRACKER:-up} in
  down) echo "Protocol handshake failed" >&2; exit 1 ;;
  hang) sleep 30; exit 1 ;;
  refuse) printf "message: no shortcode MENGER\ntype: error\n"; exit 0 ;;
esac
while [[ $# -gt 0 ]]; do [[ $1 == -p ]] && rec=$2; shift; done
key=$(jq -c "[.project, .environment, .state, .revision, (.source.run // .at)]" <<<"$rec")
grep -qxF -- "$key" "$STUB_KEYS" 2>/dev/null && dup=true || { dup=false; echo "$key" >>"$STUB_KEYS"; echo "$rec" >>"$STUB_SENT"; }
printf "deployment: \n  id: 1\nduplicate: %s\ntype: deployed\n" "$dup"'
export PATH=$SCRATCH/bin:$PATH STUB_SENT=$SCRATCH/sent.ndjson STUB_KEYS=$SCRATCH/keys STUB_COMPLETED=$SCRATCH/completed \
  STUB_ARGV=$SCRATCH/argv STUB_SYSTEMCTL=$SCRATCH/systemctl
[[ $(command -v node) == "$SCRATCH/bin/node" && $(command -v synapse) == "$SCRATCH/bin/synapse" && $(command -v curl) == "$SCRATCH/bin/curl" ]] \
  || { echo "the stand-ins are not first on PATH — refusing to run the pipeline" >&2; exit 1; }

# hypermemetic-infra, a stand-in: it keeps every call; STUB_INFRA=fail fails one (never a
# --check); STUB_INFRA=readonly-log makes deployments.log unwritable (a run that dies half-way).
INFRA=$SCRATCH/infra; mkdir -p "$INFRA/bin" "$INFRA/inventory/group_vars/all"
cat >"$INFRA/bin/infra" <<'INF'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$STUB_INFRA_LOG"
[[ ${STUB_INFRA:-ok} == fail && " $* " != *" --check "* ]] && exit 1
[[ ${STUB_INFRA:-ok} == readonly-log ]] && chmod a-w "$HOME/.local/share/menger-deploy/deployments.log"
exit 0
INF
chmod +x "$INFRA/bin/infra"
export MENGER_INFRA_DIR=$INFRA MENGER_LANDING_URL=none STUB_INFRA_LOG=$SCRATCH/infra.log
: >"$STUB_INFRA_LOG"

# Three releases at three real commits, so --commits-from-git has something to list.
mapfile -t C < <(git -C "$REPO" log --first-parent --format=%H -3 HEAD | tac)
[[ ${#C[@]} == 3 ]] || { echo "needs three commits in $REPO" >&2; exit 1; }
release() { # N → a release directory at commit C[N]
  local id=2026100${1}T100000Z-${C[$1]:0:7} r
  r=$D/releases/$id; mkdir -p "$r/bin" "$r/app"
  printf 'release:   %s\ncommit:    %s\nsubject:   r%s\ngate:      none — the suite runs after the deploy (DEPLOY-52: deploy/pipeline suite)\n' "$id" "${C[$1]}" "$1" >"$r/RELEASE"
  printf '#!/usr/bin/env bash\nexit 0\n' >"$r/bin/menger"; chmod +x "$r/bin/menger"
  echo "// r$1" >"$r/app/menger-app-r$1.js"
  chmod -R a-w "$r"; echo "$id"
}
R0=$(release 0) R1=$(release 1) R2=$(release 2)
S0=${C[0]:0:7} S1=${C[1]:0:7} S2=${C[2]:0:7}
G=ghcr.io/hypermemetic-ai/menger
suite_mark() { chmod u+w "$D/releases/$1"; printf '%s\n' "$2" >"$D/releases/$1/SUITE"; chmod a-w "$D/releases/$1"; }

P=$DEPLOY/pipeline
run() { "$P" "$@" >"$SCRATCH/out" 2>"$SCRATCH/err"; code=$?; err=$(<"$SCRATCH/err"); }
sent() { jq -c "$1" "$STUB_SENT" 2>/dev/null | tail -n "${2:-+1}" | paste -sd' '; }
: >"$STUB_SENT"
mark() { wc -l <"$STUB_SENT"; }
since() { tail -n +$(($1 + 1)) "$STUB_SENT" | jq -c "$2" | paste -sd' '; }
rt() { run remote test --image "$G:$1"; } # remote test of a release, by its GHCR image

# ── DEPLOY-52: the local environments are retired ───────────────────────────
for c in install "deploy test" "sync test" promote "rollback prod" "logs prod"; do
  # shellcheck disable=SC2086
  run $c
  same "retired: $c exits 2" "$code" 2
  has "retired: $c says so" "$err" "is retired (DEPLOY-52)"
  has "retired: $c says its data stays" "$err" "the local data stays untouched"
done
same "retired: nothing asked of systemd" "$(cat "$STUB_SYSTEMCTL" 2>/dev/null)" ""
# V2-9: media captured v1's app; on v2 it is retired, saying so
run media
same "retired on v2: media exits 2" "$code" 2
has "retired on v2: media says so" "$err" "'media' is retired on v2 (V2-9)"
has "retired on v2: media names where its regenerator is" "$err" "tag v0.0.1"
run smoke staging
same "smoke: only test or prod" "$code" 1
has "smoke: the retired ones named" "$err" "the local environments are retired"

# ── remote test: infra, the smoke from outside, recorded as test ───────────
m=$(mark); rt "$R0"
same "remote test exits 0" "$code" 0
has "remote test: infra's app.yml, env test, the release" "$(<"$STUB_INFRA_LOG")" "app.yml -e app_dir=$(dirname "$(git -C "$REPO" rev-parse --path-format=absolute --git-common-dir)") -e env=test -e sha=$R0"
same "remote test: started, succeeded as test, the first with no previous" "$(since "$m" '[.environment, .state, .revision, .previous, .from]')" \
  "[\"test\",\"started\",\"$S0\",null,null] [\"test\",\"succeeded\",\"$S0\",null,null]"
runs=$(since "$m" .source.run | tr -d '"')
[[ $runs =~ ^remote-test@[0-9TZ:-]+#[0-9]+\ remote-test@[0-9TZ:-]+#[0-9]+$ && ${runs% *} == "${runs#* }" ]] && ok || bad "one run id on both records: $runs"
same "the log line: test run, ok, the run id" "$(tail -n 1 "$D/deployments.log" | cut -f2,3,4,6)" $'test\trun\t'"$R0"$'\t'"${runs% *}"
has "remote test says it sent" "$err" "record: test succeeded $S0 → menger :4769 (sent)"
same "outbox empty" "$(ls "$OUT" | grep -c json)" 0
[[ -f $D/releases/$R0/TESTED ]] && ok || bad "remote test: the release is marked TESTED"
for s in "http://app-test.menger.sh/ → https" "https://app-test.menger.sh/ behind its login page, with HSTS" "https://app-test.menger.sh/login is the sign-in page" \
         "the socket's protected-resource metadata names https://app-test.menger.sh/ws" "a socket from another origin is refused (403)" \
         "tickets.health on wss://app-test.menger.sh/ws — 3 tickets (as the pipeline key)" "an anonymous socket reaches nothing" \
         "app-test.menger.sh serves $R0's app (menger-app-r0.js)"; do
  has "smoke: $s" "$err" "ok   $s"
done
[[ $err != *FAIL* ]] && ok || bad "a green smoke said FAIL: $err"
has "remote test: the suite is next" "$err" "its suite runs next (deploy/pipeline suite $R0)"
same "remote test: url" "$(<"$SCRATCH/out")" "url=https://app-test.menger.sh/"
[[ $(<"$STUB_ARGV") != *"seed-$STUB_SECRET"* ]] && ok || bad "the pipeline's key rode in argv"
has "the smoke reads health as the pipeline, from its file" "$(<"$STUB_ARGV")" "keyfile=$K key="$'\n'

# ── remote test again: previous, and its commits from git ──────────────────
m=$(mark); rt "$R2"
n=$(git -C "$REPO" rev-list --count "${C[0]}..${C[2]}")
same "second remote test: previous and commits (git log previous..revision)" \
  "$(since "$m" "[.state, .previous, (.commits | length), (.commits | index(\"${C[2]}\") != null)]")" \
  "[\"started\",\"$S0\",$n,true] [\"succeeded\",\"$S0\",$n,true]"

# ── the smoke fails: failed, recorded, not TESTED, exit 1 ──────────────────
m=$(mark); STUB_SMOKE=fail rt "$R1"
same "smoke fails: exits 1" "$code" 1
same "smoke fails: started, failed" "$(since "$m" '[.state, .revision]')" "[\"started\",\"$S1\"] [\"failed\",\"$S1\"]"
has "smoke fails: named" "$err" "FAIL https://app-test.menger.sh/login is not the sign-in page"
same "smoke fails: the log says so" "$(tail -n 1 "$D/deployments.log" | cut -f2,3,5)" $'test\trun\tsmoke failed'
[[ ! -f $D/releases/$R1/TESTED ]] && ok || bad "a release whose smoke failed is marked TESTED"
m=$(mark); STUB_APP_CODE=404 rt "$R2"
same "another release's app served: exits 1" "$code" 1
has "another release's app served: named" "$err" "FAIL app-test.menger.sh does not serve $R2's app"
m=$(mark); STUB_HEALTH=down rt "$R2"
same "no health: exits 1" "$code" 1
has "no health: named" "$err" "FAIL tickets.health on wss://app-test.menger.sh/ws"
m=$(mark); STUB_HEALTH=anon rt "$R2"
same "an anonymous socket answered: exits 1" "$code" 1
has "an anonymous socket answered: named" "$err" "FAIL an anonymous socket on wss://app-test.menger.sh/ws reaches past the auth door"
m=$(mark); STUB_INFRA=fail rt "$R2"
same "infra fails: exits 1" "$code" 1
same "infra fails: started, failed" "$(since "$m" '[.environment, .state]')" '["test","started"] ["test","failed"]'
same "infra fails: logged" "$(tail -n 1 "$D/deployments.log" | cut -f2,3,5)" $'test\trun\tinfra failed'
DEPLOY_SMOKE_FAIL=test run smoke test
same "the drill fails the smoke" "$code" 1

# ── a run that dies after started sends failed on its way out ───────────────
m=$(mark); STUB_INFRA=readonly-log rt "$R2"
[[ $code != 0 ]] && ok || bad "a run that cannot write its log fails"
same "died: started, then failed" "$(since "$m" .state)" '"started" "failed"'
chmod u+w "$D/deployments.log"

# ── DEPLOY-23: a record's commits start at the last run that passed ────────
range() { git -C "$REPO" rev-list --count "${C[$1]}..${C[$2]}"; }
holds() { echo "(.commits // [] | index(\"${C[$1]}\") != null)"; }
rt "$R0"; same "back on R0" "$code" 0
m=$(mark); STUB_SMOKE=fail rt "$R1"
same "fail: started, failed, from R0" "$(since "$m" "[.state, .revision, .previous, (.commits | length)]")" \
  "[\"started\",\"$S1\",\"$S0\",$(range 0 1)] [\"failed\",\"$S1\",\"$S0\",$(range 0 1)]"
m=$(mark); rt "$R2"
same "then succeed: previous the last that passed (R0), not the failed R1" \
  "$(since "$m" "[.state, .revision, .previous, (.commits | length), $(holds 1), $(holds 2)]")" \
  "[\"started\",\"$S2\",\"$S0\",$(range 0 2),true,true] [\"succeeded\",\"$S2\",\"$S0\",$(range 0 2),true,true]"

# ── the tracker is down: the deploy is unharmed, the records wait ──────────
m=$(mark); STUB_TRACKER=down rt "$R1"
same "tracker down: remote test exits 0" "$code" 0
same "tracker down: nothing sent" "$(mark)" "$m"
same "tracker down: two records in the outbox" "$(ls "$OUT" | grep -c '\.json$')" 2
has "tracker down: said" "$err" "2 record(s) wait in $OUT"
run status
has "status: the outbox per env" "$(<"$SCRATCH/out")" "outbox    2 record(s) waiting for menger on :4769"
# a hung tracker: each send is cut at MENGER_DEPLOY_RECORD_TIMEOUT
t0=$SECONDS; STUB_TRACKER=hang MENGER_DEPLOY_RECORD_TIMEOUT=1 rt "$R1"; t=$((SECONDS - t0))
same "tracker hung: remote test exits 0" "$code" 0
[[ $t -lt 20 ]] && ok || bad "tracker hung: remote test took ${t}s"
same "tracker hung: four records wait" "$(ls "$OUT" | grep -c '\.json$')" 4
# … and the next run sends them first, oldest first
m=$(mark); rt "$R1"
same "next run: the outbox first, then its own" "$(since "$m" '.state' | paste -sd' ')" '"started" "succeeded" "started" "succeeded" "started" "succeeded"'
same "next run: outbox empty" "$(ls "$OUT" | grep -c '\.json$')" 0

# ── refused: kept aside, said, never retried; the deploy unharmed ───────────
STUB_TRACKER=refuse rt "$R1"
same "refused: remote test exits 0" "$code" 0
same "refused: both in refused/" "$(ls "$OUT/refused" | grep -c '\.json$')" 2
has "refused: said" "$err" "menger refused test started $S1: no shortcode MENGER"
# the key refused at the gate (not yet granted): the records wait, said; never refused/
nref=$(ls "$OUT/refused" | grep -c '\.json$')
m=$(mark); STUB_TRACKER=gate rt "$R1"
same "the key refused: remote test exits 0" "$code" 0
same "the key refused: two wait in the outbox" "$(ls "$OUT" | grep -c '\.json$')" 2
same "the key refused: none refused" "$(ls "$OUT/refused" | grep -c '\.json$')" "$nref"
has "the key refused: said" "$err" "refused the pipeline's key (forbidden: needs deployments.record)"
m=$(mark); rt "$R1"
same "granted: the outbox first, then its own" "$(since "$m" '.state' | paste -sd' ')" '"started" "succeeded" "started" "succeeded"'
has "the key: over the socket, as the pipeline" "$(<"$STUB_ARGV")" "--url ws://127.0.0.1:4769 --agent pipeline deployments.record"

# ── remote prod: what test runs, only once its suite passed ────────────────
# test last passed R1 (the runs above); its RELEASE says the gate was none
: >"$STUB_INFRA_LOG"; m=$(mark); run remote prod
same "remote prod, no suite result: exits 1" "$code" 1
has "remote prod, no suite result: said" "$err" "$R1 has no suite result here — run: deploy/pipeline suite $R1"
same "remote prod, no suite result: infra never asked" "$(<"$STUB_INFRA_LOG")" ""
same "remote prod, no suite result: nothing recorded" "$(mark)" "$m"
suite_mark "$R1" "running 2026-10-23T06:00:00Z — deploy/pipeline suite (pid 1)"
run remote prod
same "remote prod, suite running: exits 1" "$code" 1
has "remote prod, suite running: said" "$err" "$R1's suite is still running"
suite_mark "$R1" "failed 2026-10-23T06:30:00Z — workspace red; log /x.log"
run remote prod
same "remote prod, suite red: exits 1" "$code" 1
has "remote prod, suite red: said" "$err" "$R1's suite FAILED (failed 2026-10-23T06:30:00Z — workspace red; log /x.log) — a release whose suite is red never reaches prod"
same "remote prod, refused: infra never asked" "$(<"$STUB_INFRA_LOG")" ""
suite_mark "$R1" "passed 2026-10-23T06:30:00Z — workspace 3 passed, 0 failed; frontend 1 passed, 0 failed"
m=$(mark); run remote prod
same "remote prod, suite passed: exits 0" "$code" 0
same "remote prod: promote.yml only" "$(<"$STUB_INFRA_LOG")" "promote.yml -e app_dir=$(dirname "$(git -C "$REPO" rev-parse --path-format=absolute --git-common-dir)")"
same "remote prod: recorded as app-prod, from test, test's release" "$(since "$m" '[.environment, .state, .revision, .release, .from]')" \
  "[\"app-prod\",\"started\",\"$S1\",\"$R1\",\"test\"] [\"app-prod\",\"succeeded\",\"$S1\",\"$R1\",\"test\"]"
has "remote prod: smoked from outside" "$err" "ok   tickets.health on wss://app.menger.sh/ws"
same "remote prod: the log names the release" "$(tail -n 1 "$D/deployments.log" | cut -f2-5)" $'app-prod\trun\t'"$R1"$'\tok'
same "remote prod: url" "$(<"$SCRATCH/out")" "url=https://app.menger.sh/"
# a release built with the gate (before DEPLOY-52) counts as passed: its gate was the suite
OLDG=$(id=20261001T000000Z-${C[0]:0:7}; r=$D/releases/$id; mkdir -p "$r/app"
  printf 'release:   %s\ncommit:    %s\ngate:      workspace 9 passed, 0 failed; frontend 2 passed, 0 failed\n' "$id" "${C[0]}" >"$r/RELEASE"; chmod -R a-w "$r"; echo "$id")
run suite --status "$OLDG"; same "a gated release: suite passed" "$(<"$SCRATCH/out")" "suite: passed"
run suite --status "$R0"; same "an ungated release with no suite: none" "$(<"$SCRATCH/out")" "suite: none"
run suite --status "$R1"; same "suite --status reads SUITE" "$(<"$SCRATCH/out")" "suite: passed"

# ── status: test and prod, as the log and the deployments say ──────────────
run status
out=$(<"$SCRATCH/out")
has "status: test is app-test" "$out" "test  https://app-test.menger.sh/"
