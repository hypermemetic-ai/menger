#!/usr/bin/env bash
# DEPLOY-12: deploy/pipeline's deployment records, on a throwaway environment
# root — HOME is a scratch directory (the env files, the releases, what each
# env runs, the log, the outbox) and systemctl, ss, node, npm, curl, sqlite3
# and synapse are stand-ins, so a whole deploy test, sync, promote (with the
# drill's automatic rollback), rollback and backfill run in seconds and touch
# nothing real: no unit, no port, no database, no tracker. The stand-in
# synapse keeps what it is sent and answers as DEPLOY-11 does — a record it
# already has (project, environment, state, revision, run) is `duplicate`.
# `cargo test` runs it (tests/deploy_record.rs).
#
#   deploy/tests/pipeline       exit 1 if any check failed
set -uo pipefail

HERE=$(dirname "$(readlink -f "$0")")
DEPLOY=$(dirname "$HERE")
REPO=$(git -C "$DEPLOY" rev-parse --show-toplevel)
SCRATCH=$(mktemp -d); trap 'chmod -R u+w "$SCRATCH"; rm -rf "$SCRATCH"' EXIT # releases are read-only
pass=0 fail=0
ok()  { pass=$((pass + 1)); }
bad() { fail=$((fail + 1)); printf 'FAIL %s\n' "$*" >&2; }
same() { [[ $2 == "$3" ]] && ok || bad "$1: got '$2', wanted '$3'"; }
has()  { [[ $2 == *"$3"* ]] && ok || bad "$1: wanted '$3' in: $2"; }

# ── the throwaway root ──────────────────────────────────────────────────────
export HOME=$SCRATCH/home
unset MENGER_DEPLOY_HOME MENGER_DEPLOY_OUTBOX MENGER_DEPLOY_TRACKER_HOST MENGER_DEPLOY_TRACKER_TOKEN DEPLOY_SMOKE_FAIL SMOKE_DRILLED
export MENGER_DEPLOY_TRACKER_PORT=4769
# Belt and braces: even a real systemctl --user would find no bus.
export XDG_RUNTIME_DIR=$SCRATCH/no-runtime DBUS_SESSION_BUS_ADDRESS=unix:path=$SCRATCH/no-bus
D=$HOME/.local/share/menger-deploy
OUT=$D/outbox
mkdir -p "$SCRATCH/bin" "$HOME/.config/menger" "$D/releases"
for e in prod test; do
  printf 'MENGER_DB_PATH=%s\nMENGER_WS_PORT=1\nMENGER_SHELL_PORT=2\nMENGER_REST_PORT=3\nMENGER_DIAGRAMS_PORT=4\n' \
    "$SCRATCH/data/$e/tickets.db" >"$HOME/.config/menger/$e.env"
done

stub() { printf '#!/usr/bin/env bash\n%s\n' "$2" >"$SCRATCH/bin/$1"; chmod +x "$SCRATCH/bin/$1"; }
stub systemctl '[[ ${STUB_RESTART_FAILS:-} == 1 && " $* " == *" restart "* ]] && exit 1
[[ " $* " == *" is-active "* ]] && { [[ " $* " == *" --quiet "* ]] || echo active; }; exit 0'
for t in ss node npm sqlite3; do stub $t 'exit 0'; done
stub curl 'echo "<meta name=\"menger-ws-port\" content=\"1\">"'
# synapse: the smoke's reads answered; deployments.record kept in $SCRATCH/sent.ndjson
# and answered as DEPLOY-11 does, or as STUB_TRACKER says (down, refuse, hang).
stub synapse 'args=" $* "
[[ $args == *" diagrams "* ]] && { echo "diagram_type: flowchart"; exit 0; }
[[ $args == *" health "* ]] && { echo "ticket_count: 3"; exit 0; }
case ${STUB_TRACKER:-up} in
  down) echo "Protocol handshake failed" >&2; exit 1 ;;
  hang) sleep 30; exit 1 ;;
  refuse) printf "message: no shortcode MENGER\ntype: error\n"; exit 0 ;;
esac
while [[ $# -gt 0 ]]; do [[ $1 == -p ]] && rec=$2; shift; done
key=$(jq -c "[.project, .environment, .state, .revision, (.source.run // .at)]" <<<"$rec")
grep -qxF -- "$key" "$STUB_KEYS" 2>/dev/null && dup=true || { dup=false; echo "$key" >>"$STUB_KEYS"; echo "$rec" >>"$STUB_SENT"; }
printf "deployment: \n  id: 1\nduplicate: %s\ntype: deployed\n" "$dup"'
export PATH=$SCRATCH/bin:$PATH STUB_SENT=$SCRATCH/sent.ndjson STUB_KEYS=$SCRATCH/keys
[[ $(command -v systemctl) == "$SCRATCH/bin/systemctl" && $(command -v synapse) == "$SCRATCH/bin/synapse" ]] \
  || { echo "the stand-ins are not first on PATH — refusing to run the pipeline" >&2; exit 1; }

# Three releases at three real commits, so --commits-from-git has something to list.
mapfile -t C < <(git -C "$REPO" log --first-parent --format=%H -3 HEAD | tac)
[[ ${#C[@]} == 3 ]] || { echo "needs three commits in $REPO" >&2; exit 1; }
release() { # N → a release directory at commit C[N]
  local id=2026100${1}T100000Z-${C[$1]:0:7} r
  r=$D/releases/$id; mkdir -p "$r/bin"
  printf 'release:   %s\ncommit:    %s\nsubject:   r%s\n' "$id" "${C[$1]}" "$1" >"$r/RELEASE"
  printf '#!/usr/bin/env bash\nexit 0\n' >"$r/bin/menger"; chmod +x "$r/bin/menger"
  echo "$id"
}
R0=$(release 0) R1=$(release 1) R2=$(release 2)
S0=${C[0]:0:7} S1=${C[1]:0:7} S2=${C[2]:0:7}

P=$DEPLOY/pipeline
run() { "$P" "$@" >"$SCRATCH/out" 2>"$SCRATCH/err"; code=$?; err=$(<"$SCRATCH/err"); }
sent() { jq -c "$1" "$STUB_SENT" 2>/dev/null | tail -n "${2:-+1}" | paste -sd' '; }
: >"$STUB_SENT"
mark() { wc -l <"$STUB_SENT"; }
since() { tail -n +$(($1 + 1)) "$STUB_SENT" | jq -c "$2" | paste -sd' '; }

# ── deploy test: started, then succeeded; the first has no previous ────────
m=$(mark); run deploy test "$R0"
same "deploy test exits 0" "$code" 0
same "deploy test: started, succeeded" "$(since "$m" '[.environment, .state, .revision, .previous]')" \
  "[\"test\",\"started\",\"$S0\",null] [\"test\",\"succeeded\",\"$S0\",null]"
runs=$(since "$m" .source.run | tr -d '"')
[[ $runs =~ ^deploy@[0-9TZ:-]+#[0-9]+\ deploy@[0-9TZ:-]+#[0-9]+$ && ${runs% *} == "${runs#* }" ]] && ok || bad "one run id on both records: $runs"
same "the log line ends with the run id" "$(tail -n 1 "$D/deployments.log" | cut -f2,3,5,6)" $'test\tdeploy\tok\t'"${runs% *}"
has "deploy test says it sent" "$err" "record: test succeeded $S0 → menger :4769 (sent)"
same "outbox empty" "$(ls "$OUT" | grep -c json)" 0

# ── deploy test again: previous, and its commits from git ──────────────────
m=$(mark); run deploy test "$R2"
n=$(git -C "$REPO" rev-list --count "${C[0]}..${C[2]}")
same "second deploy: previous and commits (git log previous..revision)" \
  "$(since "$m" "[.state, .previous, (.commits | length), (.commits | index(\"${C[2]}\") != null)]")" \
  "[\"started\",\"$S0\",$n,true] [\"succeeded\",\"$S0\",$n,true]"

# ── the drill: promote --to test fails its smoke and rolls back by itself ──
m=$(mark); DEPLOY_SMOKE_FAIL=test run promote "$R0" --to test
same "drill exits 1 (not promoted)" "$code" 1
same "drill: started, failed, rolled_back" "$(since "$m" '[.state, .revision, .previous]')" \
  "[\"started\",\"$S0\",\"$S2\"] [\"failed\",\"$S0\",\"$S2\"] [\"rolled_back\",\"$S2\",\"$S0\"]"
same "drill: the rollback carries no commits" "$(since "$m" '.commits // "none"' | cut -d' ' -f3)" '"none"'

# ── promote to prod; then rollback prod ────────────────────────────────────
m=$(mark); run promote "$R0"; same "promote prod exits 0" "$code" 0
m2=$(mark); run promote "$R2"; same "second promote exits 0" "$code" 0
m3=$(mark); run rollback prod; same "rollback exits 0" "$code" 0
same "promote prod: started, succeeded" "$(since "$m" '[.environment, .state, .revision]' | cut -d' ' -f1,2)" \
  "[\"prod\",\"started\",\"$S0\"] [\"prod\",\"succeeded\",\"$S0\"]"
same "rollback: started, rolled_back to the previous" "$(since "$m3" '[.state, .revision, .previous, .source.run[0:9]]')" \
  "[\"started\",\"$S0\",\"$S2\",\"rollback@\"] [\"rolled_back\",\"$S0\",\"$S2\",\"rollback@\"]"

# ── the tracker is down: the deploy is unharmed, the records wait ──────────
m=$(mark); STUB_TRACKER=down run deploy test "$R1"
same "tracker down: deploy test exits 0" "$code" 0
same "tracker down: nothing sent" "$(mark)" "$m"
same "tracker down: two records in the outbox" "$(ls "$OUT" | grep -c '\.json$')" 2
has "tracker down: said" "$err" "2 record(s) wait in $OUT"
run status
has "status: the outbox per env" "$(<"$SCRATCH/out")" "outbox    2 record(s) waiting for menger on :4769"
# a hung tracker: each send is cut at MENGER_DEPLOY_RECORD_TIMEOUT
t0=$SECONDS; STUB_TRACKER=hang MENGER_DEPLOY_RECORD_TIMEOUT=1 run sync test; t=$((SECONDS - t0))
same "tracker hung: sync exits 0" "$code" 0
[[ $t -lt 15 ]] && ok || bad "tracker hung: sync took ${t}s"
same "tracker hung: four records wait" "$(ls "$OUT" | grep -c '\.json$')" 4
# … and the next run sends them first, oldest first
m=$(mark); run sync test
same "next run: the outbox first, then its own" "$(since "$m" '[.state, .source.run[0:5]]')" \
  '["started","deplo"] ["succeeded","deplo"] ["started","sync@"] ["succeeded","sync@"] ["started","sync@"] ["succeeded","sync@"]'
same "next run: outbox empty" "$(ls "$OUT" | grep -c '\.json$')" 0

# ── refused: kept aside, said, never retried; the deploy unharmed ───────────
STUB_TRACKER=refuse run sync test
same "refused: sync exits 0" "$code" 0
same "refused: both in refused/" "$(ls "$OUT/refused" | grep -c '\.json$')" 2
has "refused: said" "$err" "menger refused test started $S1: no shortcode MENGER"

# ── a run that dies after started sends failed on its way out ───────────────
m=$(mark); STUB_RESTART_FAILS=1 run deploy test "$R2"
[[ $code != 0 ]] && ok || bad "a failing restart fails the deploy"
same "died: started, then failed" "$(since "$m" .state)" '"started" "failed"'

# ── status: the last record sent per environment ───────────────────────────
run status
out=$(<"$SCRATCH/out")
has "status: prod's last record" "$out" "record    rolled_back $S0 ($R0) at "
has "status: test's last record" "$out" "record    failed $S2 ($R2) at "

# ── backfill: the log replayed; a run's own line is the record it sent ─────
legacy=$(printf '2026-09-30T10:00:00Z\ttest\tdeploy\t%s\tok\n2026-09-30T10:01:00Z\tprod\tpromote\t%s\tok\n' "$R0" "$R0")
{ echo "$legacy"; cat "$D/deployments.log"; } >"$SCRATCH/log" && cp "$SCRATCH/log" "$D/deployments.log"
m=$(mark); run backfill
same "backfill exits 0" "$code" 0
# new: the two older lines, and the sync whose records menger refused
has "backfill: only what menger has not kept is new" "$err" "record: 3 sent, "
same "backfill: the older lines' records" "$(since "$m" '[.environment, .state, .source.run]' | cut -d' ' -f1,2)" \
  '["test","succeeded","deploy@2026-09-30T10:00:00Z"] ["prod","succeeded","promote@2026-09-30T10:01:00Z"]'
m=$(mark); run backfill
has "backfill again: nothing new" "$err" "record: 0 sent, "
same "backfill again: nothing sent" "$(mark)" "$m"
STUB_TRACKER=down run backfill
same "backfill, tracker down: exits 0" "$code" 0
has "backfill, tracker down: queued" "$err" "wait in $OUT"

printf 'deploy/pipeline records: %d passed, %d failed\n' "$pass" "$fail"
[[ $fail == 0 ]]
