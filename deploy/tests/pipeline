has "suite: the whole workspace" "$(<"$SCRATCH/ci6/cargo-args")" "test --workspace --no-fail-fast"
has "suite: the release marked passed" "$(<"$D/releases/$SR/SUITE")" "passed "
has "suite: with the counts" "$(<"$D/releases/$SR/SUITE")" "workspace 3 passed, 0 failed"
same "suite: a line in the log, no deployment" "$(tail -n 1 "$D/deployments.log" | cut -f2-5)" $'suite\ttest\t'"$SR"$'\tpassed'
ci6 suite --status "$SR"; same "suite --status: passed" "$(<"$SCRATCH/out")" "suite: passed"
STUB_CARGO_RED=1 ci6 suite "$SR"
same "suite: red exits 1" "$code" 1
has "suite: red names the failing tests" "$err" "FAILED a::one"
has "suite: the release marked failed" "$(<"$D/releases/$SR/SUITE")" "failed "
same "suite: red, its line" "$(tail -n 1 "$D/deployments.log" | cut -f2,3,5)" $'suite\ttest\tfailed workspace'
ci6 suite --status "$SR"; same "suite --status: failed" "$(<"$SCRATCH/out")" "suite: failed"
[[ $(grep -c $'\tbuild\ttest\t' "$D/deployments.log") == 0 || $(tail -n 1 "$D/deployments.log") != *$'build\ttest'* ]] && ok || bad "a red suite logged as a build's gate"
ci6 suite nonesuch
same "suite: no such release" "$code" 1

# ── PERF-6: plexus-bench beside the suite; a red bench marks the release failed ──
# A stand-in plexus-bench beside the scratch repository: its scripts/gate.sh keeps
# what it was run with, and is red when STUB_BENCH_RED=1.
mkdir -p "$SCRATCH/ci6/plexus-bench/scripts"
printf '#!/usr/bin/env bash\necho "$*|${PLEXUS_BENCH_MENGER:-}|${CARGO_TARGET_DIR:-}" >>"%s"\nif [[ ${STUB_BENCH_RED:-} == 1 ]]; then echo "RED  call.one_item p50_us 63.3 against golden 55.0 (+15.0 %% worse)"; echo "check: red: call.one_item (20 held, 1 red, 2 skipped)"; exit 1; fi\necho "check: every golden holds (21 held, 0 red, 2 skipped)"\n' "$SCRATCH/ci6/bench-args" >"$SCRATCH/ci6/plexus-bench/scripts/gate.sh"
chmod +x "$SCRATCH/ci6/plexus-bench/scripts/gate.sh"
: >"$SCRATCH/ci6/bench-args"
ci6 suite "$SR"
same "bench: a green bench, the suite exits 0" "$code" 0
has "bench: plexus-bench's gate ran beside the suite" "$(<"$SCRATCH/ci6/bench-args")" "-bench|"
has "bench: schema.* measure the release's own menger" "$(<"$SCRATCH/ci6/bench-args")" "|$D/releases/$SR/bin/menger|"
has "bench: its verdict on the SUITE line" "$(<"$D/releases/$SR/SUITE")" "; bench every golden holds (21 held, 0 red, 2 skipped)"
same "bench: green, the suite's line" "$(tail -n 1 "$D/deployments.log" | cut -f2,3,5)" $'suite\ttest\tpassed'
STUB_BENCH_RED=1 ci6 suite "$SR"
same "bench: red, the suite exits 1" "$code" 1
has "bench: red marks the release failed" "$(<"$D/releases/$SR/SUITE")" "failed "
has "bench: …and names the bench" "$(<"$D/releases/$SR/SUITE")" "bench red; log "
same "bench: red, the suite's line" "$(tail -n 1 "$D/deployments.log" | cut -f2,3,5)" $'suite\ttest\tfailed bench'
has "bench: red names the scenario" "$err" "RED  call.one_item"
ci6 suite --status "$SR"; same "bench: red, suite --status" "$(<"$SCRATCH/out")" "suite: failed"
MENGER_BENCH_DIR=none ci6 suite "$SR"
same "bench: MENGER_BENCH_DIR=none, the suite exits 0" "$code" 0
has "bench: none, said on the SUITE line" "$(<"$D/releases/$SR/SUITE")" "bench not run (MENGER_BENCH_DIR=none)"

# ── PERF.115-29: plexus-bench's count check beside its gate ──────────────
# The stand-in's scripts/ci-check.sh prints what the real one prints: the lines of
# `plexus-bench check --ci`, red with STUB_COUNTS_RED=1. STUB_COUNTS_BROKEN=1 is one
# that could not run at all (no image, no docker), which says no verdict.
printf '#!/usr/bin/env bash\necho "$*|${CARGO_TARGET_DIR:-}" >>"%s"\nif [[ ${STUB_COUNTS_BROKEN:-} == 1 ]]; then echo "ci-check: no valgrind here and no docker to run it in" >&2; exit 2; fi\nif [[ ${STUB_COUNTS_RED:-} == 1 ]]; then echo "RED  call.one_item instructions_per_op 59,000 against golden 49,442 (+19.3 %% worse)"; echo "check --ci: red: call.one_item (20 held, 1 red, 0 skipped)"; exit 1; fi\necho "check --ci: every golden holds (21 held, 0 red, 0 skipped)"\n' "$SCRATCH/ci6/counts-args" >"$SCRATCH/ci6/plexus-bench/scripts/ci-check.sh"
chmod +x "$SCRATCH/ci6/plexus-bench/scripts/ci-check.sh"
: >"$SCRATCH/ci6/counts-args"; : >"$SCRATCH/ci6/bench-args"
ci6 suite "$SR"
same "counts: green, the suite exits 0" "$code" 0
has "counts: ci-check ran beside the gate" "$(<"$SCRATCH/ci6/counts-args")" "-counts"
has "counts: in the gate's cargo target" "$(<"$SCRATCH/ci6/counts-args")" "|$HOME/.cache/cargo-target/plexus-bench"
has "counts: the gate ran too" "$(<"$SCRATCH/ci6/bench-args")" "-bench"
has "counts: the verdict on the SUITE line" "$(<"$D/releases/$SR/SUITE")" "; counts every golden holds (21 held, 0 red, 0 skipped)"
has "counts: the bench's verdict stays there" "$(<"$D/releases/$SR/SUITE")" "; bench every golden holds (21 held, 0 red, 2 skipped)"
has "counts: said at the end of the suite" "$(<"$SCRATCH/out")$err" "counts every golden holds"
has "counts: green, releases says passed" "$("$CR/deploy/pipeline" releases 2>/dev/null)" "$SR  passed"
: >"$SCRATCH/ci6/bench-args"
STUB_COUNTS_RED=1 ci6 suite "$SR"
same "counts: red, the suite exits 1" "$code" 1
has "counts: red marks the release failed" "$(<"$D/releases/$SR/SUITE")" "failed "
has "counts: …and names the counts" "$(<"$D/releases/$SR/SUITE")" "counts red; log "
same "counts: red, the suite's line" "$(tail -n 1 "$D/deployments.log" | cut -f2,3,5)" $'suite\ttest\tfailed counts'
has "counts: red names the scenario" "$err" "RED  call.one_item"
ci6 suite --status "$SR"; same "counts: red, suite --status" "$(<"$SCRATCH/out")" "suite: failed"
has "counts: red, releases says failed" "$("$CR/deploy/pipeline" releases 2>/dev/null)" "$SR  failed"
same "counts: a count that is red is not waited on: no wall-clock bench after it" "$(<"$SCRATCH/ci6/bench-args")" ""
STUB_COUNTS_BROKEN=1 ci6 suite "$SR"
same "counts: a check that could not run, the suite exits 1" "$code" 1
has "counts: …it is no pass" "$(<"$D/releases/$SR/SUITE")" "counts red; log "
: >"$SCRATCH/ci6/counts-args"
mv "$SCRATCH/ci6/plexus-bench/scripts/ci-check.sh" "$SCRATCH/ci6/ci-check.kept"
ci6 suite "$SR"
same "counts: a plexus-bench with no ci-check, the suite exits 1" "$code" 1
has "counts: …no count read, no pass" "$(<"$D/releases/$SR/SUITE")" "counts red; log "
mv "$SCRATCH/ci6/ci-check.kept" "$SCRATCH/ci6/plexus-bench/scripts/ci-check.sh"
MENGER_BENCH_DIR=none ci6 suite "$SR"
same "counts: MENGER_BENCH_DIR=none, the suite exits 0" "$code" 0
same "counts: none, not run" "$(<"$SCRATCH/ci6/counts-args")" ""
has "counts: none, the line says bench not run" "$(<"$D/releases/$SR/SUITE")" "bench not run (MENGER_BENCH_DIR=none)"

printf 'deploy/pipeline records: %d passed, %d failed\n' "$pass" "$fail"
[[ $fail == 0 ]]
