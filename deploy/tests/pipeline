has "$T15: … the log line" "$(tail -n 1 "$D4/deployments.log")" "promote failed: refused unknown_version"
same "$T15: … prod's pointer where it was" "$(cat "$STUB_UI_STATE/live.prod")" "$BUNDLE_SHA"
[[ $(cat "$STUB_UI_STATE/calls" "$STUB_ARGV" 2>/dev/null | grep -c 'ui.rollback') == 0 ]] && ok || bad "$T15: the pipeline moved the pointer itself (ui.rollback)"
# a refusal the gate makes (the pipeline key holds no deployer on prod): the same, naming it
echo "$BUNDLE_SHA" >"$STUB_UI_STATE/live.test"
STUB_UI_PROMOTE=refuse v2run remote prod
same "$T15: the gate refuses: exits 1" "$code" 1
has "$T15: … said" "$err" "was refused: refused forbidden"
echo "$BUNDLE_SHA" >"$STUB_UI_STATE/live.test"; rm -f "$STUB_UI_STATE/live.prod"

# ── V2-7 a_push_that_fails_fails_the_deploy ────────────────────────────────
# The live version is pinned to the first bundle; the release deployed holds
# the second (other bytes), and the image's signer is another key: ui.push
# answers bad_signature. The deploy fails, says why, the pinned version stays
# live, and nothing moves the pointer.
T4=a_push_that_fails_fails_the_deploy
PREV=$BUNDLE_SHA; mkdir -p "$STUB_UI_STATE"
printf '[{"hash":"%s","commit":null,"contract":"unknown","abi":"engine/1","pushed_by":"key:%s","pushed_at":1}]' "$PREV" "$PUB2" >"$STUB_UI_STATE/versions.json"
for f in live live.test; do echo "$PREV" >"$STUB_UI_STATE/$f"; done; tar -xOf "$UB/dist/ui.tar" index.html >"$STUB_UI_STATE/$PREV.html"
V4B=$(v2release "$D4/releases" 2 1 "$UB2/dist/ui.tar")
export STUB_UI_SIGNER=$PUBBAD
m=$(mark); v2run remote test --image "menger:$V4B"
same "$T4: remote test, a bad signer: exits 1" "$code" 1
has "$T4: the push refused, said" "$err" "bad_signature"
same "$T4: recorded started, failed" "$(since "$m" '[.environment, .state]')" '["test","started"] ["test","failed"]'
tail -n 1 "$D4/deployments.log" | grep -q bad_signature && ok || bad "$T4: the log line names no bad_signature: $(tail -n 1 "$D4/deployments.log")"
has "$T4: … and it is the test run's" "$(tail -n 1 "$D4/deployments.log" | cut -f2,3,4)" $'test\trun\t'"$V4B"
same "$T4: the version live before stays live" "$(cat "$STUB_UI_STATE/live.test")" "$PREV"
[[ ! -f $D4/releases/$V4B/TESTED ]] && ok || bad "$T4: a release whose push failed is marked TESTED"
v2run local --image "menger:$V4B"
same "$T4: local, a bad signer: exits 1" "$code" 1
same "$T4: local: no url" "$(<"$SCRATCH/out")$(<"$HF")" ""
tail -n 1 "$D4/deployments.log" | grep -q bad_signature && ok || bad "$T4: local: the log line names no bad_signature: $(tail -n 1 "$D4/deployments.log")"
has "$T4: … and it is app-local's" "$(tail -n 1 "$D4/deployments.log" | cut -f2,3,4)" $'app-local\trun\t'"$V4B"
same "$T4: local: the version live before stays live" "$(cat "$STUB_UI_STATE/live")" "$PREV"
[[ $(cat "$STUB_UI_STATE/calls" "$STUB_SYNAPSE_ARGV" "$STUB_ARGV" 2>/dev/null | grep -c 'ui.rollback') == 0 ]] && ok || bad "$T4: the pipeline moved the pointer itself (ui.rollback)"
unset STUB_UI_SIGNER

# ── STUDIO-6 the_studio_is_pushed_after_the_app ────────────────────────────
# A release carrying dist/studio.tar (the framework's studio, built --name studio): after the app's
# push the deploy pushes it --no-live as the pipeline key — kept beside, the live pointer the app's —
# before the smoke; a stand-in that refuses it leaves the run ok, the refusal said and recorded as
# `studio … refused: <reason>`, never as a failed run (the backfill would make that a failed test).
T9=the_studio_is_pushed_after_the_app
export STUB_UI_SIGNER=$PUB2
US=$V2/uis; mkdir -p "$US/stage" "$US/dist"
printf '<!doctype html><title>studio</title>\n' >"$US/stage/index.html"
printf '{"abi":"engine/1","name":"studio","contract":"unknown","routes":{},"components":{},"slots":{}}\n' >"$US/stage/manifest.json"
tar --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner --format=gnu -C "$US/stage" -cf "$US/dist/studio.tar" index.html manifest.json
STUDIO_SHA=$(sha256sum "$US/dist/studio.tar" | cut -d' ' -f1)
rm -rf "$STUB_UI_STATE"; mkdir -p "$STUB_UI_STATE"
V9=$(STUDIO_TAR=$US/dist/studio.tar v2release "$D4/releases" 1 1 "" 19)
m=$(mark); v2run remote test --image "menger:$V9"
same "$T9: remote test with a studio: exits 0" "$code" 0
has "$T9: the studio kept, said" "$err" "ok   the studio kept on wss://app-test.menger.sh/ws: ${STUDIO_SHA:0:12}"
order=$(paste -sd' ' "$STUB_ORDER")
[[ $order =~ (^|\ )push\ push-kept\ .*smoke ]] && ok || bad "$T9: the app's push, then the studio's, then the smoke: $order"
same "$T9: the app live, the studio kept beside" "$(cat "$STUB_UI_STATE/live.test")" "$BUNDLE_SHA"
same "$T9: the studio among the versions, by its name" "$(uivers '[.[] | select(.name == "studio") | .hash]')" "[\"$STUDIO_SHA\"]"
has "$T9: pushed --no-live by the release's tool" "$(<"$STUB_ARGV")" "--no-live $D4/releases/$V9/dist/studio.tar"
same "$T9: recorded started, succeeded" "$(since "$m" '[.environment, .state]')" '["test","started"] ["test","succeeded"]'
# refused: the run still ok, the refusal its own record, never a run line
m=$(mark); STUB_UI_REFUSE_KEPT=1 v2run remote test --image "menger:$V9"
same "$T9: the studio refused: the deploy still exits 0" "$code" 0
has "$T9: the refusal said" "$err" "FAIL the studio's push to wss://app-test.menger.sh/ws"
has "$T9: recorded as studio, refused, with the reason" "$(grep -P '\tstudio\t' "$D4/deployments.log" | tail -n 1 | cut -f2-5)" $'test\tstudio\t'"$V9"$'\trefused: '
same "$T9: the run itself succeeded" "$(since "$m" '[.environment, .state]')" '["test","started"] ["test","succeeded"]'
same "$T9: the app still live" "$(cat "$STUB_UI_STATE/live.test")" "$BUNDLE_SHA"
unset STUB_UI_SIGNER

# ── UI-12 the_smoke_holds_the_push_to_its_contract ─────────────────────────
# ui.push answers contract_matches (UI-11): the stand-in compares the manifest's contract with
# the running service's hash, STUB_UI_CONTRACT — `unknown` null, the same hash true, another
# false. A deploy's push line says it, and only `true` passes: a bundle built against no
# service (null) or another one (false — a hand-built tar pushed to another release) fails the
# deploy, naming it, recorded failed.
T7=the_smoke_holds_the_push_to_its_contract
export STUB_UI_SIGNER=$PUB2
VU=$(v2release "$D4/releases" 0 1 "$UB/dist/ui.tar")
# the ticket's third row: a tar stamped against another service, carried by a release of its own
UBO=$V2/uibo; mkdir -p "$UBO/stage" "$UBO/dist"; tar -xf "$UB/dist/ui.tar" -C "$UBO/stage"
jq -c '.contract = "0000000000000000"' "$UBO/stage/manifest.json" >"$UBO/m" && mv "$UBO/m" "$UBO/stage/manifest.json"
tar --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner --format=gnu -C "$UBO/stage" -cf "$UBO/dist/ui.tar" index.html manifest.json
VO=$(v2release "$D4/releases" 1 1 "$UBO/dist/ui.tar" 28)
same "$T7: (setup) the unstamped release's bundle says unknown" "$(tar -xOf "$D4/releases/$VU/dist/ui.tar" manifest.json | jq -r .contract)" "unknown"
m=$(mark); v2run remote test --image "menger:$V4"
same "$T7: remote test, the bundle's contract the service's: exits 0" "$code" 0
grep -E '^ok +pushed .*contract_matches: true' <<<"$err" >/dev/null && ok || bad "$T7: remote test: no push line saying contract_matches: true in: $err"
v2run local --image "menger:$V4"
same "$T7: local, the bundle's contract the service's: exits 0" "$code" 0
grep -E '^ok +pushed .*contract_matches: true' <<<"$err" >/dev/null && ok || bad "$T7: local: no push line saying contract_matches: true in: $err"
for c in null false; do
  if [[ $c == null ]]; then rel=$VU; else rel=$VO; fi
  m=$(mark); v2run remote test --image "menger:$rel"
  same "$T7: remote test, contract_matches $c: exits 1" "$code" 1
  has "$T7: remote test, contract_matches $c: said" "$err" "contract_matches: $c"
  same "$T7: remote test, contract_matches $c: recorded started, failed" "$(since "$m" '[.environment, .state]')" '["test","started"] ["test","failed"]'
  has "$T7: remote test, contract_matches $c: the log line names it" "$(tail -n 1 "$D4/deployments.log")" "contract_matches: $c"
  v2run local --image "menger:$rel"
  same "$T7: local, contract_matches $c: exits 1" "$code" 1
  has "$T7: local, contract_matches $c: said" "$err" "contract_matches: $c"
done
[[ ! -f $D4/releases/$VU/TESTED ]] && ok || bad "$T7: a release whose bundle says unknown is marked TESTED"
[[ ! -f $D4/releases/$VO/TESTED ]] && ok || bad "$T7: a release whose bundle names another service is marked TESTED"
unset STUB_UI_SIGNER

# ── FRAME-21 a_deploy_keeps_every_session ──────────────────────────────────
# `remote test` signs in on the release test runs before infra deploys (auth.login, a short
# session, as the pipeline key), and after the smoke wants /login/me 200 with that cookie, then
# signs it out. The release running at mint time decides the skip: one that does not descend
# from MENGER_SESSIONS_KEPT_SINCE kept its sessions in memory. The stand-in curl answers
# /login/me 200 for a token the stand-in minted, 401 with STUB_SESSIONS_LOST (a restart that
# dropped them).
T8=a_deploy_keeps_every_session
export STUB_UI_SIGNER=$PUB2
kept() { ls "${TMPDIR:-/tmp}"/menger-kept.* 2>/dev/null | wc -l; }
v2run remote test --image "menger:$V4"
same "$T8: (setup) test runs $V4" "$code" 0
# the release running predates FRAME-21: no sign-in, no /login/me, the skip said
: >"$STUB_UI_STATE/calls"; : >"$STUB_UI_STATE/logouts"
MENGER_SESSIONS_KEPT_SINCE=${IC[2]} v2run remote test --image "menger:$V4"
same "$T8: predates: exits 0" "$code" 0
has "$T8: predates: the skip said" "$err" "skip a session across the deploy: $V4 predates FRAME-21: it kept its sessions in memory"
[[ $(<"$STUB_ARGV") != *"/login/me"* ]] && ok || bad "$T8: predates: /login/me was asked"
# it keeps them: signed in before infra, the cookie stands after the smoke, then signed out
before=$(kept); : >"$STUB_UI_STATE/calls"; : >"$STUB_UI_STATE/logouts"; : >"$STUB_UI_STATE/tokens"
m=$(mark); MENGER_SESSIONS_KEPT_SINCE=${IC[0]} v2run remote test --image "menger:$V4"
same "$T8: kept: exits 0" "$code" 0
has "$T8: kept: signed in before the deploy" "$err" "ok   signed in on $V4 before the deploy"
has "$T8: kept: the cookie stands after it" "$err" "ok   a session signed in before the deploy stands after it (https://app-test.menger.sh/login/me: 200)"
first=$(head -n 1 "$STUB_UI_STATE/tokens" 2>/dev/null)
[[ -n $first ]] && ok || bad "$T8: kept: no session minted"
has "$T8: kept: minted as the pipeline, short-lived" "$(grep '^auth.login' "$STUB_UI_STATE/calls" | head -n 1)" "auth.login wss://app-test.menger.sh/ws pipeline"
grep -q '"ttl_secs":900' <<<"$(grep 'auth.login' "$STUB_ARGV" | head -n 1)" && ok || bad "$T8: kept: the session is not the short one: $(grep 'auth.login' "$STUB_ARGV" | head -n 1)"
i_mint=$(grep -n -m1 '^auth.login' "$STUB_UI_STATE/calls" | cut -d: -f1) i_push=$(grep -n -m1 '^ui.push' "$STUB_UI_STATE/calls" | cut -d: -f1)
[[ -n $i_mint && -n $i_push && $i_mint -lt $i_push ]] && ok || bad "$T8: kept: the sign-in came after the deploy (mint $i_mint, push $i_push)"
same "$T8: kept: signed out after the check" "$(head -n 1 "$STUB_UI_STATE/logouts")" "$first"
[[ $(<"$STUB_ARGV") != *"$first"* ]] && ok || bad "$T8: kept: the token rode in argv"
same "$T8: kept: the cookie's file removed" "$(kept)" "$before"
same "$T8: kept: recorded started, succeeded" "$(since "$m" .state)" '"started" "succeeded"'
# a deploy that dropped them: the deploy fails, said and recorded, and still signs out
: >"$STUB_UI_STATE/logouts"; : >"$STUB_UI_STATE/tokens"
m=$(mark); STUB_SESSIONS_LOST=1 MENGER_SESSIONS_KEPT_SINCE=${IC[0]} v2run remote test --image "menger:$V4"
same "$T8: lost: exits 1" "$code" 1
has "$T8: lost: said" "$err" "FAIL a session signed in before the deploy is gone after it (https://app-test.menger.sh/login/me: 401)"
has "$T8: lost: the deploy dies naming it" "$err" "a session signed in before the deploy is gone (FRAME-21)"
same "$T8: lost: recorded started, failed" "$(since "$m" '[.environment, .state]')" '["test","started"] ["test","failed"]'
has "$T8: lost: the log line says it" "$(tail -n 1 "$D4/deployments.log")" "sessions lost"
same "$T8: lost: still signed out" "$(head -n 1 "$STUB_UI_STATE/logouts")" "$(head -n 1 "$STUB_UI_STATE/tokens")"
same "$T8: lost: the cookie's file removed" "$(kept)" "$before"
unset STUB_UI_SIGNER

# ── V2-7 the_runner_targets_the_branch (status: MENGER_RUNNER_BRANCH in deploy-runner.env, the one
# source; the runner's half is deploy/tests/runner.test.mjs) ──
T5=the_runner_targets_the_branch
printf 'MENGER_RUNNER_MODE=--watch\nMENGER_RUNNER_BRANCH=v2\n' >"$HOME/.config/menger/deploy-runner.env"
run status
has "$T5: status says the runner's branch" "$(<"$SCRATCH/out")" "  branch    v2"
printf 'MENGER_RUNNER_MODE=--watch\n' >"$HOME/.config/menger/deploy-runner.env"
run status
has "$T5: status, no branch set: main" "$(<"$SCRATCH/out")" "  branch    main"

# ── UI-17 ui_goes_live_on_test_with_no_release ──────────────────────────────
# deploy/pipeline ui: this checkout's ui/ with the tool and the engine of the release test runs,
# the contract asked of test, pushed; no cargo, no docker, no infra. --watch again on each change,
# a refusal said and the watch goes on. ui promote moves prod's pointer and pushes nothing.
T17=ui_goes_live_on_test_with_no_release
export MENGER_UI_CACHE=$SCRATCH/ui-cache
mkdir -p "$MENGER_UI_CACHE/$V4/engine"; echo x >"$MENGER_UI_CACHE/$V4/engine/engine.js"; echo x >"$MENGER_UI_CACHE/$V4/engine/engine.wasm"
: >"$STUB_UI_STATE/calls"; : >"$SCRATCH/infra.argv"; : >"$STUB_ARGV"
STUB_UI_SIGNER=$PUB2 v2run ui
same "$T17: exits 0" "$code" 0
has "$T17: built with --contract-from test's socket" "$(cat "$STUB_ARGV")" "--contract-from wss://app-test.menger.sh/ws"
has "$T17: pushed to test" "$(cat "$STUB_UI_STATE/calls")" "ui.push wss://app-test.menger.sh/ws pipeline"
same "$T17: no infra" "$(wc -c <"$SCRATCH/infra.argv" | tr -d ' ')" 0
has "$T17: said" "$err" "live on test"
: >"$STUB_UI_STATE/calls"
v2run ui promote
same "$T17: promote exits 0" "$code" 0
has "$T17: one promote on prod's socket" "$(cat "$STUB_UI_STATE/calls")" "ui.promote wss://app.menger.sh/ws pipeline argv"
[[ $(grep -c '^ui.push' "$STUB_UI_STATE/calls") == 0 ]] && ok || bad "$T17: promote pushed"
v2run ui nonsense
same "$T17: usage exits 1" "$code" 1

printf 'deploy/pipeline records: %d passed, %d failed\n' "$pass" "$fail"
[[ $fail == 0 ]]
