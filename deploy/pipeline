  done
  return 1
}
bundle_uses() { # TAR → every method its manifest's components use, once each, sorted, comma-separated ("" for none);
  # 1 when the tar holds no manifest.json, or one that is no JSON — never read as a bundle naming nothing
  local m
  m=$(tar -xOf "$1" manifest.json 2>/dev/null) && [[ -n $m ]] || return 1
  jq -er '[.components // {} | .[] | .uses // [] | .[]] | unique | join(",")' <<<"$m" 2>/dev/null
}
uses_services() { # USES (comma-separated) → the services they name, once each: "orgs, tickets"
  jq -rR 'split(",") | map(select(. != "") | split(".")[0]) | unique | join(", ")' <<<"$1"
