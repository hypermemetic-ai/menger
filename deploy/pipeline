#!/usr/bin/env bash
# DEPLOY-2: menger's deployment pipeline (DEPLOY-1 defines it; deploy/README.md
# explains it). Build once from a commit, a release; its image; test is
# app-test.menger.sh, prod app.menger.sh, both on the Linode through
# hypermemetic-infra (RUN-11). DEPLOY-52 (owner, 2026-10-22/23: "we need to work
# directly against the test deployment", "we run the tests after the deployment
# to test", "we need to remove the non remote environments"): this machine runs
# no environment any more — the suite runs here after the deploy to test,
# against the release's own tree, and a release whose suite is red never
# reaches prod.
#
#   deploy/pipeline build [REV] [--branch B] [--no-gate]  gate + release (default REV: B, else main;
#                                           V2-7: B named in the release; a tree with no frontend/ builds
#                                           its UI with plexus-ui's tool at the tag of the version its
#                                           Cargo.lock takes, FRAME-8, V2-47); --no-gate: the
#                                           release alone, the suite to run after the deploy
#                                           (DEPLOY-52); refused up front on a low disk (CI-2:
#                                           scripts/disk-check.sh — under 50 GB free or 90% used);
#                                           V2-9: the release builds menger alone, v1 commits included
#   deploy/pipeline suite RELEASE           DEPLOY-52: the full suite (cargo test --workspace +
#                                           the frontend's) at RELEASE's commit, in its own
#                                           checkout (../menger-suite); marks the release
#                                           `suite running`, then `passed` or `failed` (its SUITE)
#   deploy/pipeline suite --status RELEASE  `suite: passed|failed|running|none` — what remote prod reads
#   deploy/pipeline image [RELEASE]         RUN-10: a release (default: the newest) as an image —
#                                           IMAGE_STORE=local (default): menger:<release> in this
#                                           machine's Docker; ghcr: ghcr.io/hypermemetic-ai/menger:<release>
#                                           + :latest, pushed. Prints image=… and release=… (and
#                                           appends them to $HF_OUTPUTS when set)
#   deploy/pipeline remote test --image IMAGE
#                                           app-test.menger.sh through infra's app.yml, then the smoke
#                                           against https://app-test.menger.sh; recorded as `test`
#                                           (DEPLOY-52: test is app-test); passing marks it TESTED
#   deploy/pipeline ui [--watch]            UI-17: ui/ of this checkout live on test, no image, no cargo
#   deploy/pipeline ui promote              UI-17: what test has live onto prod (a pointer move; the owner's)
#   deploy/pipeline remote prod             app.menger.sh through infra's promote.yml: what test runs, then
#                                           `ui promote --to prod --from test` (UI-15: one store, prod's pointer
#                                           onto test's live version, no second push), then the smoke —
#                                           refused unless that release's suite passed (DEPLOY-52)
#   deploy/pipeline smoke test|prod         the smoke against app-test / app.menger.sh, on its own
#   deploy/pipeline local --image IMAGE     RUN-25: IMAGE here as the container menger-app-local
#                                           (127.0.0.1:4470 WebSocket, :4471 shell, volume
#                                           menger-app-local-data) — a CI throwaway, not an
#                                           environment; replaced when run again; prints url=…
#   deploy/pipeline remote-secret test|prod [--check] [--from FILE]
#                                           IDENTITY-45: the WorkOS API key on app-test / app.menger.sh
#                                           (infra's secret.yml: a 0400 file the container reads, then
#                                           health; the old key back if unhealthy). The value from
#                                           $WORKOS_API_KEY (ledger-secret run workos-prod WORKOS_API_KEY
#                                           -- deploy/pipeline remote-secret prod), --from FILE, or stdin;
#                                           never an argument, never printed
#   deploy/pipeline status                  what test and prod run, their health, their suites, the
#                                           last deployment record of each; the runner; the disk (CI-2)
#   deploy/pipeline releases                every release: its suite, tested?, where it runs
#   deploy/pipeline backfill                deployments.log → menger's deployments
#                                           (idempotent: a record kept is not kept twice)
#   deploy/pipeline landing [REV] [--check] DEPLOY-17: landing/ at REV (default main) → gate →
#                                           infra's pin moved, the edge applied, the live page
#                                           verified, the pin committed; recorded as env `edge`
#                                           (--check: the gate and infra's dry run, nothing written)
#
# Retired by DEPLOY-52 (this machine's test and prod, :4450–4458): install,
# deploy test, sync, promote, rollback, logs — each says so and exits 2. Their
# data stays where it was (~/.local/share/menger/tickets.db and backups/,
# ~/.local/share/menger-test/); deploy/README.md "The local environments, retired".
# Retired on v2 (V2-9): media — landing/media was captured from v1's app; its
# regenerator is at tag v0.0.1 until the landing is redone for v2. It says so
# and exits 2; landing/media stays as committed.
#
# DEPLOY-12: remote test and remote prod each tell menger what they did — a
# deployment record (deploy/record → deployments.record): `started` before it
# begins, then `succeeded` or `failed`. Every record goes through the outbox,
# oldest first; one the tracker does not take waits there for the next run. A
# record never fails a deploy, nor holds one up longer than a bounded send. Where:
#   MENGER_DEPLOY_TRACKER_URL (wss://app.menger.sh/ws) — DEPLOY-28: the tracker since RUN-13,
#   reached as the pipeline's key; `local`: a tracker on this machine —
#   MENGER_DEPLOY_TRACKER_PORT (4455) · MENGER_DEPLOY_TRACKER_HOST · MENGER_DEPLOY_TRACKER_TOKEN
#   MENGER_DEPLOY_OUTBOX (~/.local/share/menger-deploy/outbox) · MENGER_DEPLOY_RECORD_TIMEOUT (10 s a send)
#   MENGER_DEPLOY_KEY_FILE (~/.plexus/keys/pipeline.key; `none`: no key) — ACCESS-47:
#   the pipeline's own key; where the file is, records go over the socket
#   signed in as it (deploy/menger-call.mjs reads the file — the seed is never
#   in an environment or an argv), and status and the smoke read health as it
#   MENGER_DEPLOY_COMPLETE_KEY_FILE (~/.plexus/keys/builder.key; `none`: no completion) —
#   DEPLOY-28: a succeeded record to test, once kept, sets Complete on the In Review
#   tickets it carried that now run their current version there (DEPLOY-22), as this
#   key (an editor's: the pipeline's own key is viewer + deployer)
set -euo pipefail

# ── where things are ────────────────────────────────────────────────────────
REPO=$(git -C "$(dirname "$(readlink -f "$0")")" rev-parse --show-toplevel)
# The build checkout is a sibling of the repo: of menger's plexus dependencies,
# a tree before V2-47 took plexus-login and plexus-ui by relative path (PLEXUS-16), so a checkout anywhere else could not build it.
# V2-7: MENGER_BUILD_CHECKOUT names another sibling (a worktree's own build, beside the runner's)
BUILD=${MENGER_BUILD_CHECKOUT:-$(dirname "$REPO")/menger-build}
HOME_DIR=${MENGER_DEPLOY_HOME:-$HOME/.local/share/menger-deploy}
RELEASES=$HOME_DIR/releases
LOG=$HOME_DIR/deployments.log
# CI-6: every log a run writes is a file of its own, <UTC stamp>-<sha>-<step>.log, never overwritten;
# a red run is marked (<stamp>.red) so the sweep keeps its logs past the 60 days it keeps the green ones.
LOGS=${MENGER_DEPLOY_LOGS:-$HOME/.local/state/menger-deploy/logs}
LOG_STAMP="" LOG_SHA=""
KEEP_RELEASES=10
# DEPLOY-52: the suite's own checkout, a sibling (the plexus paths resolve) apart from the
# build's, so a suite running after one deploy never holds up the next build.
SUITE_CHECKOUT=${MENGER_SUITE_CHECKOUT:-$(dirname "$REPO")/menger-suite}
# DEPLOY-52: test is app-test.menger.sh, prod app.menger.sh (MENGER_APP_TEST_URL, MENGER_APP_URL)
APP_TEST_URL=${MENGER_APP_TEST_URL:-https://app-test.menger.sh}
APP_URL=${MENGER_APP_URL:-https://app.menger.sh}
APP_TEST_URL=${APP_TEST_URL%/} APP_URL=${APP_URL%/}
RECORD=$REPO/deploy/record
TRACKER_PORT=${MENGER_DEPLOY_TRACKER_PORT:-4455}
TRACKER_HOST=${MENGER_DEPLOY_TRACKER_HOST:-}
TRACKER_TOKEN=${MENGER_DEPLOY_TRACKER_TOKEN:-}
# DEPLOY-28: the tracker moved to app.menger.sh (RUN-13); `local` is :TRACKER_PORT here.
TRACKER_URL=${MENGER_DEPLOY_TRACKER_URL:-wss://app.menger.sh/ws}
[[ $TRACKER_URL == local ]] && TRACKER_URL=""
case $TRACKER_URL in ""|ws://*|wss://*) ;; *) printf 'pipeline: MENGER_DEPLOY_TRACKER_URL=%s: ws:// or wss:// (or local)\n' "$TRACKER_URL" >&2; exit 1 ;; esac
if [[ -n $TRACKER_URL ]]; then TRACKER_NAME=$(sed -E 's|^wss?://||; s|/.*$||' <<<"$TRACKER_URL"); else TRACKER_NAME=:$TRACKER_PORT; fi
# ACCESS-47: prod behind login — the pipeline signs in with its key, a file.
DEPLOY_KEY_FILE=${MENGER_DEPLOY_KEY_FILE:-$HOME/.plexus/keys/pipeline.key}
[[ $DEPLOY_KEY_FILE == none || ! -f $DEPLOY_KEY_FILE ]] && DEPLOY_KEY_FILE=""
# DEPLOY-28: who sets Complete after a deploy to test — an editor's key, a file.
COMPLETE_KEY_FILE=${MENGER_DEPLOY_COMPLETE_KEY_FILE:-$HOME/.plexus/keys/builder.key}
[[ $COMPLETE_KEY_FILE == none || ! -f $COMPLETE_KEY_FILE ]] && COMPLETE_KEY_FILE=""
CALL_JS=$REPO/deploy/menger-call.mjs
OUTBOX=${MENGER_DEPLOY_OUTBOX:-$HOME_DIR/outbox}
SENT=$HOME_DIR/sent
SEND_TIMEOUT=${MENGER_DEPLOY_RECORD_TIMEOUT:-10}
RUN="" RUN_AT="" # this run's id and when it began (begin_run): its records and its log line carry the id
# DEPLOY-17: the landing page — menger.sh is landing/ at the commit pinned in
# hypermemetic-infra (menger_landing_commit), which the edge role reads with
# git show and git archive from this checkout, never a working tree.
INFRA=${MENGER_INFRA_DIR:-$(dirname "$REPO")/hypermemetic-infra}
INFRA_PIN=inventory/group_vars/all/main.yml
LANDING_URL=${MENGER_LANDING_URL:-https://menger.sh}   # `none`: no live verification
LANDING_CHECK=$REPO/deploy/landing-check.mjs
LANDING_EXPORT="" # the export a landing run made, removed on exit

say()  { printf '%s\n' "$*" >&2; }
die()  { say "pipeline: $*"; exit 1; }
step() { say "── $*"; }
record() { # env action release result — one line of deployments.log, a run's ending with its id
  mkdir -p "$HOME_DIR"
  printf '%s\t%s\t%s\t%s\t%s%s\n' "$(date -u +%FT%TZ)" "$1" "$2" "$3" "$4" "${RUN:+$'\t'$RUN}" >> "$LOG"
}
log_path() { # step → a new file in $LOGS for this run (the run's stamp; its sha when it has one)
  mkdir -p "$LOGS"
  [[ -n $LOG_STAMP ]] || LOG_STAMP=$(date -u +%Y%m%dT%H%M%SZ)
  local f=$LOGS/$LOG_STAMP${LOG_SHA:+-$LOG_SHA}-$1.log n=1
  while [[ -e $f ]]; do n=$((n + 1)); f=$LOGS/$LOG_STAMP${LOG_SHA:+-$LOG_SHA}-$1.$n.log; done
  : > "$f"; printf '%s\n' "$f"
}
red_run() { mkdir -p "$LOGS"; : > "$LOGS/$LOG_STAMP.red"; } # this run's logs are kept whatever their age
GATE_ON_RED="" # DEPLOY-52: what a red gate does before it dies (the suite marks its release)
gate_red() { # LABEL LOGFILE SHORT — the gate failed: marked, recorded, every failing test named, the log said
  local label=$1 f=$2
  red_run
  if [[ -n $GATE_ON_RED ]]; then "$GATE_ON_RED" "$label" "$f"; else record build test "$3" "gate failed"; fi
  grep -E '^test .* \.\.\. FAILED$' "$f" | sort -u | sed 's/^test \(.*\) \.\.\. FAILED$/FAILED \1/' >&2 || true
  die "$label gate failed — $f"
}
need() { command -v "$1" >/dev/null || die "needs $1 on PATH"; }
# DEPLOY-23: the release ENV last ran with its smoke passed — where a record's
# commits start, so a failed run's commits ride with the next run that passes.
# Read from deployments.log, the last of: a run that ended ok (remote's `run`,
# and the retired local deploy, sync, promote: its release; rollback: the
# release it returned to), or a promote whose automatic rollback passed (the
# release it returned to). A failed run, a run that died, a rollback whose
# smoke failed is never the start. ENV with no run in the log yet: none.
# DEPLOY-52: `test` is app-test.menger.sh from the first `remote test` on; the
# lines before it are this machine's test, retired — its last good release is
# where the first remote test's commits start.
last_good() {
  local runs='$2 == e && $3 ~ /^(deploy|sync|promote|rollback|run)$/'
  if [[ -f $LOG ]] && awk -F'\t' -v e="$1" "$runs {f = 1} END {exit !f}" "$LOG"; then
    awk -F'\t' -v e="$1" "$runs"' {
      if ($4 == "-") next
      if ($5 == "ok" || ($3 == "run" && $5 ~ /^ok /)) g = $4; else if (match($5, /rolled back to [^ ]+$/)) g = substr($5, RSTART + 15) }
      END { if (g != "") print g }' "$LOG"
  fi
}
ran_before() { # ENV → the release it ran ok before its last good one (a rollback's target), or empty
  [[ -f $LOG ]] || return 0
  awk -F'\t' -v e="$1" '$2 == e && $3 ~ /^(deploy|sync|promote|rollback|run)$/ && $4 != "-" && ($5 == "ok" || ($3 == "run" && $5 ~ /^ok /)) {
      if ($4 != g) { p = g; g = $4 } } END { if (p != "") print p }' "$LOG"
}
resolve_release() { # NAME or empty → a release directory name that exists
  local r=${1:-}
  if [[ -z $r ]]; then
    r=$(ls -1 "$RELEASES" 2>/dev/null | grep -v '\.tmp$' | sort | tail -n 1 || true)
    [[ -n $r ]] || die "no releases yet — run: deploy/pipeline build"
  fi
  [[ -d $RELEASES/$r && -f $RELEASES/$r/RELEASE ]] || die "no release '$r' (see: deploy/pipeline releases)"
  echo "$r"
}

# ── the deployment record (DEPLOY-12) ───────────────────────────────────────
# A run that changes what an environment runs tells menger (DEPLOY-11) what it
# did, in DEPLOY-10's record, made and sent by deploy/record. Its run id —
# `promote@<when it began>#<pid>` — is on each of its records and at the end of its
# log line, so the record `backfill` makes from that line is the one the run
# sent (same environment, state, revision and run: menger keeps one).
begin_run() { RUN_AT=$(date -u +%FT%TZ); RUN="$1@$RUN_AT#$$"; } # e.g. promote@2026-10-12T22:04:02Z#4242
PENDING=() # ENV RELEASE PREVIOUS of a run that told `started` and has not ended
on_exit() {
  local rc=$?
  contract_stop # UI-12: the menger a build started to read its hash, never left running
  [[ $rc -ne 0 && -n $LOG_STAMP ]] && red_run # CI-6: a run that failed keeps its logs
  [[ ${#PENDING[@]} -eq 3 ]] && tell "${PENDING[0]}" failed "${PENDING[1]}" "${PENDING[2]}"
  [[ -n $LANDING_EXPORT && -d $LANDING_EXPORT ]] && rm -rf "$LANDING_EXPORT"
  [[ -n ${KEPT_HDR:-} ]] && rm -f "$KEPT_HDR" # FRAME-21: the check's cookie, never left behind
  [[ -n ${IMAGE_CONTEXT:-} && -d $IMAGE_CONTEXT ]] && { chmod -R u+w "$IMAGE_CONTEXT"; rm -rf "$IMAGE_CONTEXT"; }
  # what the run said goes through tee into its log: close our ends and let the tees finish,
  # or the last lines (a die's) can be lost to whoever reads the output. V2-7: both tees, by
  # their pids — `wait` alone waits for the last process substitution only (stderr's), and
  # stdout's could still be writing when the caller read it (the harness's flaky empty
  # stdout). Polled until each has gone, at most 10 s (a child that kept our pipe open).
  if [[ -n ${_l:-} ]]; then
    exec 1>&- 2>&-
    local t n
    for t in ${_tees:-}; do n=0; while kill -0 "$t" 2>/dev/null && (( n++ < 500 )); do sleep 0.02; done; done
  fi
  return 0
}
trap on_exit EXIT
sha_of() { [[ ${1:-} =~ -([0-9a-f]{7,40})$ ]] && echo "${BASH_REMATCH[1]}" || true; }
git_repo() { if git -C "$BUILD" rev-parse --git-dir >/dev/null 2>&1; then echo "$BUILD"; else echo "$REPO"; fi; }

# tell ENV STATE RELEASE [PREVIOUS] — the record of this run; never fails, and
# never holds the run up past a bounded send (MENGER_DEPLOY_RECORD_TIMEOUT).
tell() {
  if [[ $2 == started ]]; then PENDING=("$1" "$3" "${4:-}"); else PENDING=(); fi
  ( set +e; tell_ "$@" ) || true
}
# DEPLOY-21: the environment ENV promotes from — test and the landing page's
# edge from none (each its own track). DEPLOY-52: test is app-test.menger.sh, and
# app-prod (app.menger.sh) promotes from it — the record's `from` moves app-prod's
# source from the retired app-test environment to test.
promotes_from() { case $1 in app-prod) echo test ;; esac; }
tell_() {
  local env=$1 state=$2 rel=$3 prev=${4:-} rev p at rec="" from
  rev=$(sha_of "$rel"); p=$(sha_of "$prev")
  [[ -n $rev ]] || { say "record: release '$rel' names no commit — nothing recorded"; return 0; }
  at=$(date -u +%FT%TZ); [[ $state == started && -n $RUN ]] && at=$RUN_AT
  local args=(--project menger --env "$env" --state "$state" --revision "$rev" --release "$rel" --at "$at"
              --source-system menger-pipeline --source-run "${RUN:-$state@$at}" -c)
  [[ -n $p ]] && args+=(--previous "$p")
  from=$(promotes_from "$env"); [[ -n $from ]] && args+=(--promotes-from "$from")
  # DEPLOY-37: run for a request (deploy/runner.mjs sets MENGER_REQUEST), its records name it.
  [[ -n ${MENGER_REQUEST:-} ]] && args+=(--request "$MENGER_REQUEST")
  # Its commits: git log previous..revision in the build checkout, when the
  # run moves forward (a rollback carries none). Without them menger works
  # from the commits it has seen.
  if [[ -n $p && $p != "$rev" && $state != rolled_back ]]; then
    rec=$(timeout -k 2 "$SEND_TIMEOUT" "$RECORD" "${args[@]}" --commits-from-git --repo "$(git_repo)" 2>/dev/null)
  fi
  [[ -n $rec ]] || rec=$("$RECORD" "${args[@]}") || { say "record: could not make the $env $state record — nothing recorded"; return 0; }
  enqueue "$rec" && flush_outbox
}

QSEQ=0
enqueue() { # RECORD → the outbox, named to sort in the order queued
  mkdir -p "$OUTBOX" || return 1
  QSEQ=$((QSEQ + 1))
  local f; f=$OUTBOX/$(date -u +%Y%m%dT%H%M%S%N)-$$-$(printf %06d "$QSEQ").json
  printf '%s\n' "$1" > "$f.part" && mv "$f.part" "$f"
}
queued() { ls -1 "$OUTBOX" 2>/dev/null | grep '\.json$' | sort || true; }
what() { jq -r '"\(.environment) \(.state) \(.revision)"' "$1" 2>/dev/null; }

# Sends what waits in the outbox, oldest first. A record menger keeps (or
# already kept) leaves it, and becomes its environment's last record sent; one
# menger refuses moves to refused/, said and never retried; at the first that
# gets no answer the rest wait for the next run. QUIET=1: a sum, not a line each.
flush_outbox() {
  [[ -d $OUTBOX ]] || return 0
  local lock f out rc sent=0 dup=0 refused=0 left
  exec {lock}>>"$OUTBOX/.lock"
  flock -n "$lock" || { say "record: another run is sending the outbox"; return 0; }
  local sargs=(--send --port "$TRACKER_PORT") via=synapse kenv=()
  [[ -n $TRACKER_HOST ]] && sargs+=(--host "$TRACKER_HOST")
  [[ -n $TRACKER_TOKEN ]] && sargs+=(--token "$TRACKER_TOKEN")
  # ACCESS-47: with the pipeline's key (and no token given), over the socket
  # signed in as it; the seed stays in its file, read by menger-call.
  # DEPLOY-28: app.menger.sh (MENGER_DEPLOY_TRACKER_URL) is under login: always the key.
  if [[ -n $TRACKER_URL ]]; then
    via=key sargs=(--send --url "$TRACKER_URL" --agent pipeline)
    kenv=(env -u MENGER_DEPLOY_KEY MENGER_DEPLOY_KEY_FILE="$DEPLOY_KEY_FILE")
  elif [[ -n $DEPLOY_KEY_FILE && -z $TRACKER_TOKEN ]]; then
    via=key sargs=(--send --url "ws://${TRACKER_HOST:-127.0.0.1}:$TRACKER_PORT" --agent pipeline)
    kenv=(env -u MENGER_DEPLOY_KEY MENGER_DEPLOY_KEY_FILE="$DEPLOY_KEY_FILE")
  fi
  [[ $via == key && -z $DEPLOY_KEY_FILE ]] && { say "record: no key for $TRACKER_NAME (MENGER_DEPLOY_KEY_FILE: $HOME/.plexus/keys/pipeline.key) — the records wait in $OUTBOX"; exec {lock}>&-; return 0; }
  # A run's flush stops after a few sends' worth of time; backfill's does not.
  local until=$((SECONDS + 3 * SEND_TIMEOUT))
  for f in $(queued); do
    [[ ${QUIET:-} == 1 || $SECONDS -lt $until ]] || break
    # DEPLOY-28 (DEPLOY-22): a succeeded record to test, the lowest environment, completes its work
    # (three calls, three sends' time; the key's file named to deploy/record, never read here)
    local cargs=() cenv=() tmo=$SEND_TIMEOUT
    if [[ $via == key && -n $COMPLETE_KEY_FILE ]] && jq -e '.environment == "test" and .state == "succeeded"' "$OUTBOX/$f" >/dev/null 2>&1; then
      cargs=(--complete) cenv=(MENGER_DEPLOY_COMPLETE_KEY_FILE="$COMPLETE_KEY_FILE") tmo=$((3 * SEND_TIMEOUT))
    fi
    # V2-15: -k — a record that outlives its TERM (the fifth suite's nested one did) is killed.
    rc=0; out=$("${kenv[@]}" "${cenv[@]}" timeout -k 2 "$tmo" "$RECORD" --from json "$OUTBOX/$f" "${sargs[@]}" "${cargs[@]}" 2>&1) || rc=$?
    grep '^record: complete: ' <<<"$out" >&2 || true
    # menger-call answers JSON lines, synapse its text: one reading of both
    if [[ $via == key ]]; then
      out=$(jq -Rr 'fromjson? // {line: .} | if .type == "deployed" then "type: deployed", "duplicate: \(.duplicate)"
             elif .type == "error" and has("error_kind") then "gate: \(.error_kind): \(.message)"
             elif .type == "error" then "type: error", "message: \(.message)" else (.line // empty) end' <<<"$out")
      [[ $rc == 3 ]] && grep -q '^type: error' <<<"$out" && rc=0
    fi
    if [[ $rc == 0 ]] && grep -q '^type: deployed' <<<"$out"; then
      local env how=sent; env=$(jq -r .environment "$OUTBOX/$f")
      if grep -q '^duplicate: true' <<<"$out"; then dup=$((dup + 1)); how="already kept"; else sent=$((sent + 1)); fi
      [[ ${QUIET:-} == 1 ]] || say "record: $(what "$OUTBOX/$f") → menger $TRACKER_NAME ($how)"
      mkdir -p "$SENT"
      jq -c --arg t "$(date -u +%FT%TZ)" --arg how "$how" '. + {sent_at: $t, sent: $how}' "$OUTBOX/$f" > "$SENT/${env//\//_}.json"
      rm -f "$OUTBOX/$f"
    elif [[ $rc == 2 ]] || grep -q '^type: error' <<<"$out"; then
      refused=$((refused + 1))
      say "record: menger refused $(what "$OUTBOX/$f"): $(sed -n 's/^message: //p; s/^record: //p' <<<"$out" | head -n 3 | tr '\n' ' ')— kept in $OUTBOX/refused/"
      mkdir -p "$OUTBOX/refused"; mv "$OUTBOX/$f" "$OUTBOX/refused/"
    else
      # a gate's refusal (the key not signed in, or not granted) is the
      # tracker's setup, not the record's: it waits, and is said once
      grep -q '^gate: ' <<<"$out" && say "record: menger $TRACKER_NAME refused the pipeline's key ($(sed -n 's/^gate: //p' <<<"$out" | head -n 1)) — grant it deployer on MENGER (deploy/README.md \"Recording deployments\")"
      break
    fi
  done
  left=$(queued | wc -l)
  [[ $left -gt 0 ]] && say "record: $left record(s) wait in $OUTBOX for the next run (menger $TRACKER_NAME did not take them in time)"
  [[ ${QUIET:-} == 1 ]] && say "record: $sent sent, $dup already kept, $refused refused, $left waiting"
  exec {lock}>&-
  return 0
}

# ── build: commit → gate → release ──────────────────────────────────────────
# checkout DIR SHA — DIR (a sibling worktree, so menger's relative plexus paths
# resolve) at SHA, clean but for build outputs and installed node modules.
checkout() {
  local dir=$1 sha=$2
  if [[ ! -d $dir/.git && ! -f $dir/.git ]]; then
    git -C "$REPO" worktree add --detach "$dir" "$sha" >/dev/null
  else
