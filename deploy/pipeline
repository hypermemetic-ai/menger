#!/usr/bin/env bash
# DEPLOY-2: menger's deployment pipeline (DEPLOY-1 defines it; deploy/README.md
# explains it). Build once from a commit, gate, release, deploy to test,
# promote to prod — test and prod both running locally under systemd --user.
#
#   deploy/pipeline install                 units + env files; enable both envs
#                                           (ACCESS-27: the templated half only —
#                                           <env>.local.env and <env>.smoke.env
#                                           are made once, from the old file, and
#                                           never rewritten)
#   deploy/pipeline build [REV]             gate + release (default REV: main)
#   deploy/pipeline deploy test [RELEASE]   prod data → test; switch; restart; smoke
#   deploy/pipeline sync test               prod data → test, same release; restart; smoke
#   deploy/pipeline promote [RELEASE] [--adopt]
#                                           a TESTED release to prod; smoke;
#                                           automatic rollback on failure
#   deploy/pipeline rollback ENV [--restore BACKUP]
#   deploy/pipeline smoke ENV               the smoke checks, on their own
#   deploy/pipeline status                  what each env runs, and how it is;
#                                           the last deployment record of each
#   deploy/pipeline releases                every release: tested? where?
#   deploy/pipeline logs ENV [journalctl args…]
#   deploy/pipeline backfill                deployments.log → menger's deployments
#                                           (idempotent: a record kept is not kept twice)
#   deploy/pipeline landing [REV] [--check] DEPLOY-17: landing/ at REV (default main) → gate →
#                                           infra's pin moved, the edge applied, the live page
#                                           verified, the pin committed; recorded as env `edge`
#                                           (--check: the gate and infra's dry run, nothing written)
#   deploy/pipeline media [RELEASE]         landing/media regenerated from a release's own binary
#                                           (default: what prod runs); the worker commits them
#
# DEPLOY-12: deploy test, sync, promote and rollback each tell menger what they
# did — a deployment record (deploy/record → deployments.record): `started`
# before it begins, then `succeeded`, `failed` or `rolled_back`. Every record
# goes through the outbox, oldest first; one the tracker does not take waits
# there for the next run. A record never fails a deploy, nor holds one up
# longer than a bounded send. Where:
#   MENGER_DEPLOY_TRACKER_PORT (4455) · MENGER_DEPLOY_TRACKER_HOST · MENGER_DEPLOY_TRACKER_TOKEN
#   MENGER_DEPLOY_OUTBOX (~/.local/share/menger-deploy/outbox) · MENGER_DEPLOY_RECORD_TIMEOUT (10 s a send)
set -euo pipefail

# ── where things are ────────────────────────────────────────────────────────
REPO=$(git -C "$(dirname "$(readlink -f "$0")")" rev-parse --show-toplevel)
# The build checkout is a sibling of the repo: menger's plexus dependencies are
# relative paths (../plexus-core …), so a checkout anywhere else cannot build.
BUILD=$(dirname "$REPO")/menger-build
HOME_DIR=${MENGER_DEPLOY_HOME:-$HOME/.local/share/menger-deploy}
RELEASES=$HOME_DIR/releases
LOG=$HOME_DIR/deployments.log
CONFIG=$HOME/.config/menger
UNITS=$HOME/.config/systemd/user
BACKUPS=$HOME/.local/share/menger/backups
KEEP_RELEASES=10
RECORD=$REPO/deploy/record
TRACKER_PORT=${MENGER_DEPLOY_TRACKER_PORT:-4455}
TRACKER_HOST=${MENGER_DEPLOY_TRACKER_HOST:-}
TRACKER_TOKEN=${MENGER_DEPLOY_TRACKER_TOKEN:-}
OUTBOX=${MENGER_DEPLOY_OUTBOX:-$HOME_DIR/outbox}
SENT=$HOME_DIR/sent
SEND_TIMEOUT=${MENGER_DEPLOY_RECORD_TIMEOUT:-10}
RUN="" RUN_AT="" # this run's id and when it began (begin_run): its records and its log line carry the id
# DEPLOY-17: the landing page — menger.sh is landing/ at the commit pinned in
# hypermemetic-infra (menger_landing_commit), which the edge role reads with
# git show and git archive from this checkout, never a working tree.
INFRA=${MENGER_INFRA_DIR:-$(dirname "$REPO")/hypermemetic-infra}
INFRA_PIN=inventory/group_vars/all/main.yml
LANDING_URL=${MENGER_LANDING_URL:-https://menger.sh}   # `none`: no live verification
LANDING_CHECK=$REPO/deploy/landing-check.mjs
LANDING_EXPORT="" # the export a landing run made, removed on exit

say()  { printf '%s\n' "$*" >&2; }
die()  { say "pipeline: $*"; exit 1; }
step() { say "── $*"; }
record() { # env action release result — one line of deployments.log, a run's ending with its id
  mkdir -p "$HOME_DIR"
  printf '%s\t%s\t%s\t%s\t%s%s\n' "$(date -u +%FT%TZ)" "$1" "$2" "$3" "$4" "${RUN:+$'\t'$RUN}" >> "$LOG"
}
need() { command -v "$1" >/dev/null || die "needs $1 on PATH"; }

# ACCESS-27: an environment's settings are three files in $CONFIG.
#   <env>.env        the templated half (deploy/env/<env>.env): ports, database,
#                    registry, MENGER_EXPECT_LOGIN — rewritten by every install
#   <env>.local.env  menger's login and secrets, 0600, never templated; the
#                    unit loads it after <env>.env
#   <env>.smoke.env  the smoke account (MENGER_SMOKE_*), 0600, read by the
#                    smoke alone — never in menger's environment
env_file()   { echo "$CONFIG/$1.env"; }
local_file() { echo "$CONFIG/$1.local.env"; }
smoke_file() { echo "$CONFIG/$1.smoke.env"; }
load_env() { # ENV → exports the templated half; reads the local half without exporting it
  local f l v; f=$(env_file "$1"); l=$(local_file "$1")
  [[ -f $f ]] || die "no $f — run: deploy/pipeline install"
  # Each load starts clean: one env's login settings never linger into the next's.
  for v in $(compgen -v MENGER_); do [[ $v == MENGER_DEPLOY_* ]] || unset "$v"; done
  set -a; # shellcheck disable=SC1090
  source "$f"; set +a
  # The local half is read (the smoke asks what login it configures), never
  # exported: menger's secrets stay out of every command the pipeline runs.
  # shellcheck disable=SC1090
  if [[ -f $l ]]; then source "$l"; fi
}
check_env() { [[ $1 == prod || $1 == test ]] || die "unknown environment '$1' (prod or test)"; }
envdir() { echo "$HOME_DIR/envs/$1"; }
running_release() { local l; l=$(envdir "$1")/current; [[ -L $l ]] && basename "$(readlink -f "$l")" || true; }
previous_release() { local l; l=$(envdir "$1")/previous; [[ -L $l ]] && basename "$(readlink -f "$l")" || true; }
resolve_release() { # NAME or empty → a release directory name that exists
  local r=${1:-}
  if [[ -z $r ]]; then
    r=$(ls -1 "$RELEASES" 2>/dev/null | grep -v '\.tmp$' | sort | tail -n 1 || true)
    [[ -n $r ]] || die "no releases yet — run: deploy/pipeline build"
  fi
  [[ -d $RELEASES/$r && -f $RELEASES/$r/RELEASE ]] || die "no release '$r' (see: deploy/pipeline releases)"
  echo "$r"
}
units_of() { echo "menger@$1.service menger-diagrams@$1.service"; }

# ── the deployment record (DEPLOY-12) ───────────────────────────────────────
# A run that changes what an environment runs tells menger (DEPLOY-11) what it
# did, in DEPLOY-10's record, made and sent by deploy/record. Its run id —
# `promote@<when it began>#<pid>` — is on each of its records and at the end of its
# log line, so the record `backfill` makes from that line is the one the run
# sent (same environment, state, revision and run: menger keeps one).
begin_run() { RUN_AT=$(date -u +%FT%TZ); RUN="$1@$RUN_AT#$$"; } # e.g. promote@2026-10-12T22:04:02Z#4242
PENDING=() # ENV RELEASE PREVIOUS of a run that told `started` and has not ended
on_exit() {
  [[ ${#PENDING[@]} -eq 3 ]] && tell "${PENDING[0]}" failed "${PENDING[1]}" "${PENDING[2]}"
  [[ -n $LANDING_EXPORT && -d $LANDING_EXPORT ]] && rm -rf "$LANDING_EXPORT"
  return 0
}
trap on_exit EXIT
sha_of() { [[ ${1:-} =~ -([0-9a-f]{7,40})$ ]] && echo "${BASH_REMATCH[1]}" || true; }
git_repo() { if git -C "$BUILD" rev-parse --git-dir >/dev/null 2>&1; then echo "$BUILD"; else echo "$REPO"; fi; }

# tell ENV STATE RELEASE [PREVIOUS] — the record of this run; never fails, and
# never holds the run up past a bounded send (MENGER_DEPLOY_RECORD_TIMEOUT).
tell() {
  if [[ $2 == started ]]; then PENDING=("$1" "$3" "${4:-}"); else PENDING=(); fi
  ( set +e; tell_ "$@" ) || true
}
tell_() {
  local env=$1 state=$2 rel=$3 prev=${4:-} rev p at rec=""
  rev=$(sha_of "$rel"); p=$(sha_of "$prev")
  [[ -n $rev ]] || { say "record: release '$rel' names no commit — nothing recorded"; return 0; }
  at=$(date -u +%FT%TZ); [[ $state == started && -n $RUN ]] && at=$RUN_AT
  local args=(--project menger --env "$env" --state "$state" --revision "$rev" --release "$rel" --at "$at"
              --source-system menger-pipeline --source-run "${RUN:-$state@$at}" -c)
  [[ -n $p ]] && args+=(--previous "$p")
  # Its commits: git log previous..revision in the build checkout, when the
  # run moves forward (a rollback carries none). Without them menger works
  # from the commits it has seen.
  if [[ -n $p && $p != "$rev" && $state != rolled_back ]]; then
    rec=$(timeout "$SEND_TIMEOUT" "$RECORD" "${args[@]}" --commits-from-git --repo "$(git_repo)" 2>/dev/null)
  fi
  [[ -n $rec ]] || rec=$("$RECORD" "${args[@]}") || { say "record: could not make the $env $state record — nothing recorded"; return 0; }
  enqueue "$rec" && flush_outbox
}

QSEQ=0
enqueue() { # RECORD → the outbox, named to sort in the order queued
  mkdir -p "$OUTBOX" || return 1
  QSEQ=$((QSEQ + 1))
  local f; f=$OUTBOX/$(date -u +%Y%m%dT%H%M%S%N)-$$-$(printf %06d "$QSEQ").json
  printf '%s\n' "$1" > "$f.part" && mv "$f.part" "$f"
}
queued() { ls -1 "$OUTBOX" 2>/dev/null | grep '\.json$' | sort || true; }
what() { jq -r '"\(.environment) \(.state) \(.revision)"' "$1" 2>/dev/null; }

# Sends what waits in the outbox, oldest first. A record menger keeps (or
# already kept) leaves it, and becomes its environment's last record sent; one
# menger refuses moves to refused/, said and never retried; at the first that
# gets no answer the rest wait for the next run. QUIET=1: a sum, not a line each.
flush_outbox() {
  [[ -d $OUTBOX ]] || return 0
  local lock f out rc sent=0 dup=0 refused=0 left
  exec {lock}>>"$OUTBOX/.lock"
  flock -n "$lock" || { say "record: another run is sending the outbox"; return 0; }
  local sargs=(--send --port "$TRACKER_PORT")
  [[ -n $TRACKER_HOST ]] && sargs+=(--host "$TRACKER_HOST")
  [[ -n $TRACKER_TOKEN ]] && sargs+=(--token "$TRACKER_TOKEN")
  # A run's flush stops after a few sends' worth of time; backfill's does not.
  local until=$((SECONDS + 3 * SEND_TIMEOUT))
  for f in $(queued); do
    [[ ${QUIET:-} == 1 || $SECONDS -lt $until ]] || break
    rc=0; out=$(timeout "$SEND_TIMEOUT" "$RECORD" --from json "$OUTBOX/$f" "${sargs[@]}" 2>&1) || rc=$?
    if [[ $rc == 0 ]] && grep -q '^type: deployed' <<<"$out"; then
      local env how=sent; env=$(jq -r .environment "$OUTBOX/$f")
      if grep -q '^duplicate: true' <<<"$out"; then dup=$((dup + 1)); how="already kept"; else sent=$((sent + 1)); fi
      [[ ${QUIET:-} == 1 ]] || say "record: $(what "$OUTBOX/$f") → menger :$TRACKER_PORT ($how)"
      mkdir -p "$SENT"
      jq -c --arg t "$(date -u +%FT%TZ)" --arg how "$how" '. + {sent_at: $t, sent: $how}' "$OUTBOX/$f" > "$SENT/${env//\//_}.json"
      rm -f "$OUTBOX/$f"
    elif [[ $rc == 2 ]] || grep -q '^type: error' <<<"$out"; then
      refused=$((refused + 1))
      say "record: menger refused $(what "$OUTBOX/$f"): $(sed -n 's/^message: //p; s/^record: //p' <<<"$out" | head -n 3 | tr '\n' ' ')— kept in $OUTBOX/refused/"
      mkdir -p "$OUTBOX/refused"; mv "$OUTBOX/$f" "$OUTBOX/refused/"
    else
      break
    fi
  done
  left=$(queued | wc -l)
  [[ $left -gt 0 ]] && say "record: $left record(s) wait in $OUTBOX for the next run (menger :$TRACKER_PORT did not take them in time)"
  [[ ${QUIET:-} == 1 ]] && say "record: $sent sent, $dup already kept, $refused refused, $left waiting"
  exec {lock}>&-
  return 0
}

# ── install ─────────────────────────────────────────────────────────────────
# ACCESS-27 (ACCESS-4 H3): install rewrites only the templated half. Where an
# environment has no <env>.local.env yet, it is made — once, 0600 — from what
# the old <env>.env held beyond its template (login, admins, secrets, and the
# notes beside them), the smoke account's MENGER_SMOKE_* going to
# <env>.smoke.env; the old file is kept as <env>.env.before-local (0600).
# Values are never printed, only names. A later install leaves both alone, and
# refuses — changing nothing — if <env>.env has since gained a setting its
# template lacks (it would be dropped): move it into the local half.
assign_re='^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)='
keys_of() { sed -nE "s/$assign_re.*/\2/p" "$1" | sort -u; }
extras_of() { # OLD TEMPLATE → the keys OLD sets that TEMPLATE does not
  comm -23 <(keys_of "$1") <(keys_of "$2")
}
render_env() { # ENV NODE → deploy/env/ENV.env, filled in
  sed -e "s|@HOME@|$HOME|g" -e "s|@NODE@|$2|g" "$REPO/deploy/env/$1.env"
}
# split_old OLD TEMPLATE LOCAL SMOKE — the lines of OLD beyond TEMPLATE into
# LOCAL (MENGER_SMOKE_* into SMOKE). Comments go with them, except the header
# before the first setting (the template's, whichever version wrote it) and
# lines the template itself has.
split_old() {
  local old=$1 tpl=$2 lo=$3 sm=$4 line key seen=0
  while IFS= read -r line || [[ -n $line ]]; do
    if [[ $line =~ $assign_re ]]; then
      seen=1; key=${BASH_REMATCH[2]}
      grep -qxF -- "$key" <(keys_of "$tpl") && continue
      if [[ $key == MENGER_SMOKE_* ]]; then printf '%s\n' "$line" >>"$sm"; else printf '%s\n' "$line" >>"$lo"; fi
    elif [[ $seen == 1 && -n ${line// /} ]] && ! grep -qxF -- "$line" "$tpl"; then
      printf '%s\n' "$line" >>"$lo"
    fi
  done <"$old"
}
local_header() { # ENV WHAT
  printf '# ACCESS-27: %s for %s — never templated. `deploy/pipeline install` makes\n' "$2" "$1"
  printf '# this file once (0600) and never rewrites it; deploy/README.md "Settings".\n'
}

cmd_install() {
  need systemctl; need sqlite3; need node
  # Node by its real path: the diagrams unit sees no home but what it binds.
  local node; node=$(readlink -f "$(command -v node)")
  mkdir -p "$CONFIG" "$UNITS" "$HOME_DIR/envs/prod" "$HOME_DIR/envs/test" "$RELEASES" "$BACKUPS" \
           "$HOME/.local/share/menger-test"
  chmod 0700 "$CONFIG"
  local e cur lo sm new x
  # First every check, then every write: a refusal changes nothing.
  for e in prod test; do
    cur=$(env_file $e) lo=$(local_file $e) sm=$(smoke_file $e) new=$CONFIG/.$e.env.new
    ( umask 077; render_env $e "$node" >"$new" )
    [[ -f $cur ]] || continue
    x=$(extras_of "$cur" "$new" | paste -sd' ')
    if [[ -f $lo && -n $x ]]; then
      rm -f "$CONFIG"/.*.env.new
      die "$cur sets what its template does not ($x) and $lo exists already — move them into $lo (or ${sm##*/} for MENGER_SMOKE_*), then install again; nothing was changed"
    fi
    if [[ ! -f $lo && -f $sm ]] && grep -qE '^[[:space:]]*(export[[:space:]]+)?MENGER_SMOKE_' "$cur"; then
      rm -f "$CONFIG"/.*.env.new
      die "$cur sets MENGER_SMOKE_* and $sm exists already — merge them by hand, then install again; nothing was changed"
    fi
  done
  for e in prod test; do
    cur=$(env_file $e) lo=$(local_file $e) sm=$(smoke_file $e) new=$CONFIG/.$e.env.new
    if [[ ! -f $lo ]]; then
      ( umask 077
        local_header $e "menger's login and secrets" >"$lo.tmp"
        if [[ -f $cur ]]; then
          [[ -e $cur.before-local ]] || cp "$cur" "$cur.before-local"
          chmod 0600 "$cur.before-local"
          [[ -f $sm ]] || local_header $e "the smoke account (MENGER_SMOKE_*), read by the smoke alone," >"$sm.tmp"
          split_old "$cur" "$new" "$lo.tmp" "$sm.tmp"
        fi )
      chmod 0600 "$lo.tmp"; mv "$lo.tmp" "$lo"
      local moved smoked; moved=$(keys_of "$lo" | paste -sd' ')
      if [[ -f $sm.tmp ]] && [[ -n $(keys_of "$sm.tmp") ]]; then
        smoked=$(keys_of "$sm.tmp" | paste -sd' '); chmod 0600 "$sm.tmp"; mv "$sm.tmp" "$sm"
      else smoked=""; rm -f "$sm.tmp"; fi
      say "$e: made ${lo##*/} (0600)${moved:+ with $moved}${smoked:+; ${sm##*/} (0600) with $smoked}${moved:+ — the old file is ${cur##*/}.before-local (0600)}"
    fi
    if [[ -f $cur ]]; then
      x=$(comm -12 <(keys_of "$cur") <(keys_of "$new") | while read -r k; do
            [[ $(grep -E "^[[:space:]]*(export[[:space:]]+)?$k=" "$cur" | tail -n 1) == "$(grep -E "^$k=" "$new" | tail -n 1)" ]] || echo "$k"
          done | paste -sd' ')
      [[ -n $x ]] && say "$e: the template's $x replace(s) the old file's"
    fi
    mv "$new" "$cur"
    # The unit's writable path and the diagrams unit's view of Node, per
    # environment (unit drop-ins; deploy/README.md "Hardening").
    local db; db=$(set -a; source "$cur"; echo "$MENGER_DB_PATH")
    mkdir -p "$(dirname "$db")"
    mkdir -p "$UNITS/menger@$e.service.d" "$UNITS/menger-diagrams@$e.service.d"
    printf '# ACCESS-27: written by deploy/pipeline install — the one place menger@%s writes.\n[Service]\nReadWritePaths=%s\n' \
      "$e" "$(dirname "$db")" >"$UNITS/menger@$e.service.d/50-data.conf"
    printf '# ACCESS-27: written by deploy/pipeline install — the Node menger-diagrams@%s runs.\n[Service]\nBindReadOnlyPaths=%s\n' \
      "$e" "$(dirname "$(dirname "$node")")" >"$UNITS/menger-diagrams@$e.service.d/50-paths.conf"
  done
  install -m 0644 "$REPO/deploy/systemd/menger@.service" "$REPO/deploy/systemd/menger-diagrams@.service" "$UNITS/"
  install -m 0644 "$REPO/deploy/README.md" "$HOME_DIR/README.md"
  systemctl --user daemon-reload
  # Enabled means started at boot (lingering is on); an env with no release
  # yet is enabled but not started.
  systemctl --user enable menger@prod menger-diagrams@prod menger@test menger-diagrams@test >/dev/null 2>&1
  say "installed: $CONFIG/{prod,test}.env (+ .local.env, .smoke.env kept), $UNITS/menger{,-diagrams}@.service and their drop-ins; enabled for prod and test"
}

# ── build: commit → gate → release ──────────────────────────────────────────
cmd_build() {
  need cargo; need trunk; need npm
  local rev=${1:-main} sha short id stage
  sha=$(git -C "$REPO" rev-parse --verify "$rev^{commit}") || die "no commit '$rev'"
  short=${sha:0:7}
  step "build $short — $(git -C "$REPO" log -1 --format=%s "$sha")"

  if [[ ! -d $BUILD/.git && ! -f $BUILD/.git ]]; then
    git -C "$REPO" worktree add --detach "$BUILD" "$sha" >/dev/null
  else
    git -C "$BUILD" checkout --quiet --detach --force "$sha"
  fi
  # A clean tree at the commit; build outputs and installed node modules stay
  # so a build is incremental.
  git -C "$BUILD" clean -ffdxq -e /target/ -e /frontend/target/ -e /perf/node_modules/ -e /diagrams/node/node_modules/

  step "gate: cargo test --workspace"
  local gate_ws gate_fe
  gate_ws=$(cd "$BUILD" && cargo test --workspace 2>&1 | tee "$BUILD/.gate-workspace.log" | grep -E '^test result' \
            | awk '{p+=$4; f+=$6} END {print p+0 " passed, " f+0 " failed"}') \
    || { record build test "$short" "gate failed"; die "gate failed — $BUILD/.gate-workspace.log"; }
  grep -q '^test result: FAILED' "$BUILD/.gate-workspace.log" && { record build test "$short" "gate failed"; die "gate failed: $gate_ws"; }
  step "gate: frontend tests"
  gate_fe=$(cd "$BUILD/frontend" && cargo test 2>&1 | tee "$BUILD/.gate-frontend.log" | grep -E '^test result' \
            | awk '{p+=$4; f+=$6} END {print p+0 " passed, " f+0 " failed"}') \
    || { record build test "$short" "gate failed"; die "frontend gate failed — $BUILD/.gate-frontend.log"; }
  grep -q '^test result: FAILED' "$BUILD/.gate-frontend.log" && { record build test "$short" "gate failed"; die "frontend gate failed: $gate_fe"; }
  say "gate: workspace $gate_ws; frontend $gate_fe"

  step "release build"
  (cd "$BUILD" && cargo build --release -p menger -p menger-diagrams > "$BUILD/.build-release.log" 2>&1) \
    || die "release build failed — $BUILD/.build-release.log"
  (cd "$BUILD/frontend" && trunk build --release >/dev/null 2>&1) || die "trunk build failed"
  (cd "$BUILD/diagrams/node" && npm ci --silent >/dev/null)

  id=$(date -u +%Y%m%dT%H%M%SZ)-$short
  stage=$RELEASES/$id.tmp
  mkdir -p "$stage/bin" "$stage/diagrams-node"
  cp "$BUILD/target/release/menger" "$BUILD/target/release/menger-diagrams" "$stage/bin/"
  cp "$REPO/deploy/launch/run-menger" "$REPO/deploy/launch/run-diagrams" "$stage/bin/"
  chmod 0755 "$stage/bin/"*
  cp -r "$BUILD/frontend/dist" "$stage/app"
  cp -r "$BUILD/diagrams/node/." "$stage/diagrams-node/"
  {
    echo "release:   $id"
    echo "commit:    $sha"
    echo "subject:   $(git -C "$REPO" log -1 --format=%s "$sha")"
    echo "built:     $(date -u +%FT%TZ)"
    echo "rustc:     $(rustc --version)"
    echo "gate:      workspace $gate_ws; frontend $gate_fe"
  } > "$stage/RELEASE"
  chmod -R a-w "$stage"
  mv "$stage" "$RELEASES/$id"
  record build - "$id" ok
  prune
  say "release $id"
  echo "$id"
}

prune() { # keep what an env runs or can roll back to, and the newest few
  local keep; keep=$( { for e in prod test; do running_release $e; previous_release $e; done; \
                        ls -1 "$RELEASES" | grep -v '\.tmp$' | sort | tail -n $KEEP_RELEASES; } | sort -u)
  for r in $(ls -1 "$RELEASES" | grep -v '\.tmp$'); do
    grep -qx "$r" <<<"$keep" || { chmod -R u+w "$RELEASES/$r"; rm -rf "${RELEASES:?}/$r"; say "pruned $r"; }
  done
}

# ── switching and services ──────────────────────────────────────────────────
switch_to() { # ENV RELEASE — current becomes previous
  local d; d=$(envdir "$1"); mkdir -p "$d"
  local cur; cur=$(running_release "$1")
  if [[ -n $cur && $cur != "$2" ]]; then ln -sfn "$RELEASES/$cur" "$d/previous"; fi
  ln -sfn "$RELEASES/$2" "$d/current"
}
restart() { systemctl --user enable $(units_of "$1") >/dev/null 2>&1 || true; systemctl --user restart $(units_of "$1"); }
stop()    { systemctl --user stop $(units_of "$1") 2>/dev/null || true; }

backup_db() { # ENV LABEL → path of the backup (empty when there is no db)
  load_env "$1"
  [[ -f $MENGER_DB_PATH ]] || { echo ""; return; }
  local dir; [[ $1 == prod ]] && dir=$BACKUPS || dir=$(dirname "$MENGER_DB_PATH")/backups
  mkdir -p "$dir"
  local out=$dir/tickets.db.$(date -u +%Y%m%dT%H%M%SZ)-$2
  sqlite3 "$MENGER_DB_PATH" ".backup '$out'"
  echo "$out"
}
restore_db() { # ENV BACKUP — the env's services must be stopped
  load_env "$1"
  rm -f "$MENGER_DB_PATH" "$MENGER_DB_PATH-wal" "$MENGER_DB_PATH-shm"
  cp "$2" "$MENGER_DB_PATH"
}

# ── smoke ───────────────────────────────────────────────────────────────────
cmd_smoke() {
  local env=$1; check_env "$env"; load_env "$env"
  local rel; rel=$(running_release "$env"); [[ -n $rel ]] || { say "smoke $env: no release"; return 1; }
  local bin=$RELEASES/$rel/bin fail=0
  step "smoke $env ($rel)"
  # A drill: DEPLOY_SMOKE_FAIL=ENV fails the first smoke of ENV in this run
  # (so a promote rolls back), and only the first (so the rollback can pass).
  if [[ ${DEPLOY_SMOKE_FAIL:-} == "$env" && -z ${SMOKE_DRILLED:-} ]]; then
    SMOKE_DRILLED=1; say "smoke: DEPLOY_SMOKE_FAIL=$env — failing on purpose (a drill)"; return 1
  fi
  for u in $(units_of "$env"); do
    systemctl --user is-active --quiet "$u" && say "ok   $u active" || { say "FAIL $u not active"; fail=1; }
  done
  local h="" login="" mode="" expect=${MENGER_EXPECT_LOGIN:-} lo sm
  lo=$(local_file "$env") sm=$(smoke_file "$env")
  # ACCESS-27: the settings' secrets are 0600 files, the local half there.
  if [[ ! -f $lo ]]; then say "FAIL no $lo — run: deploy/pipeline install"; fail=1
  elif [[ $(stat -c %a "$lo") != [46]00 ]]; then say "FAIL $lo is readable by others ($(stat -c %a "$lo"); 0600)"; fail=1
  else say "ok   ${lo##*/} is the owner's alone"; fi
  if [[ -f $sm ]]; then
    if [[ $(stat -c %a "$sm") != [46]00 ]]; then say "FAIL $sm is readable by others ($(stat -c %a "$sm"); 0600)"; fail=1; fi
    # shellcheck disable=SC1090
    source "$sm" # not exported: the smoke hands each value to the one command that needs it
  fi
  # ACCESS-27 (ACCESS-4 H3): the login mode this environment must be in is
  # its templated half's MENGER_EXPECT_LOGIN — not the local half, which is
  # what an install could once lose. The settings must configure it, and the
  # server must be in it; the checks below follow it, never the server.
  case $expect in
    off|on|required) ;;
    *) say "FAIL MENGER_EXPECT_LOGIN is '${expect}' in $(env_file "$env") — off, on or required (run: deploy/pipeline install)"; fail=1; expect=off ;;
  esac
  local configured=off
  [[ -n ${MENGER_AUTH_PROVIDERS:-}${MENGER_IDENTITY:-} ]] && configured=on
  [[ ${MENGER_REQUIRE_LOGIN:-} =~ ^(1|true|yes)$ ]] && configured=required
  if [[ $configured == "$expect" ]]; then say "ok   the settings configure login: $expect, as MENGER_EXPECT_LOGIN says"
  else say "FAIL the settings configure login: $configured, but MENGER_EXPECT_LOGIN says $expect — is ${lo##*/} the one $env had?"; fail=1; fi
  for _ in $(seq 1 60); do
    mode=$(timeout 12 node "$REPO/deploy/smoke-mode.mjs" "$MENGER_WS_PORT" "$MENGER_SHELL_PORT" 2>/dev/null | grep -E '^login: ' || true)
    [[ -n $mode ]] && break; sleep 0.5
  done
  if [[ $mode == "login: $expect" ]]; then say "ok   the server on :$MENGER_WS_PORT is in login: $expect"
  else say "FAIL the server on :$MENGER_WS_PORT says ${mode:-nothing}, but MENGER_EXPECT_LOGIN says $expect"; fail=1; fi
  # IDENTITY-23: an environment that requires login is checked as a person
  # would meet it — signed in as the smoke account (AUTH-7: which needs
  # tickets.health, viewer somewhere), and without it: AUTH-7 admits that
  # upgrade into the anonymous view, which reaches nothing but the auth door.
  [[ $expect == required ]] && login=1
  if [[ -n $login ]]; then
    local token=""
    # ACCESS-27 (L3): the password and the token never ride in argv — the
    # form goes to curl on stdin, the token to smoke-health.mjs on stdin.
    token=$(printf '%s\n%s\n%s' "${MENGER_SMOKE_USER:-}" "${MENGER_SMOKE_PASSWORD:-}" "${MENGER_SMOKE_AUDIENCE:-}" \
              | jq -jRs 'split("\n") as [$u, $p, $a] | "grant_type=password&username=\($u|@uri)&password=\($p|@uri)&audience=\($a // "" | @uri)"' \
              | curl -fsS -m 5 -X POST "${MENGER_SMOKE_TOKEN_URL:-}" --data-binary @- 2>/dev/null | jq -r '.access_token // empty' || true)
    [[ -n $token ]] && say "ok   the smoke account signs in" || { say "FAIL the smoke account signs in (MENGER_SMOKE_* in ${sm##*/})"; fail=1; }
    for _ in $(seq 1 60); do
      h=$(timeout 12 node "$REPO/deploy/smoke-health.mjs" "$MENGER_WS_PORT" - <<<"$token" 2>/dev/null | grep -E 'ticket_count' || true)
      [[ -n $h ]] && break; sleep 0.5
    done
    if node "$REPO/deploy/smoke-health.mjs" "$MENGER_WS_PORT" >/dev/null 2>&1; then
      say "ok   an anonymous socket on :$MENGER_WS_PORT sees only the auth door and reaches nothing"
    else
      say "FAIL an anonymous socket on :$MENGER_WS_PORT reaches past the auth door"; fail=1
    fi
  else
    for _ in $(seq 1 60); do
      h=$(timeout 5 synapse -P "$MENGER_WS_PORT" menger tickets health 2>/dev/null | grep -E 'ticket_count' || true)
      [[ -n $h ]] && break; sleep 0.5
    done
  fi
  [[ -n $h ]] && say "ok   tickets.health on :$MENGER_WS_PORT —${h#*:} tickets" || { say "FAIL tickets.health on :$MENGER_WS_PORT"; fail=1; }
  if "$bin/menger" --verify-derived --db-path "$MENGER_DB_PATH" >/dev/null 2>&1; then
    say "ok   --verify-derived consistent"
  else
    say "FAIL --verify-derived"; fail=1
  fi
  # DEPLOY-6: grep reads the whole page (no -q): under pipefail, a grep that
  # quits at its first match makes curl's next write fail (exit 23).
  if [[ -n $login ]]; then
    # IDENTITY-23: the app is behind the login page.
    local to; to=$(curl -s -o /dev/null -m 5 -w '%{redirect_url}' "http://127.0.0.1:$MENGER_SHELL_PORT/")
    if [[ $to == */login?next=* ]] && curl -fsS -m 5 "http://127.0.0.1:$MENGER_SHELL_PORT/login" | grep '<h1>Sign in</h1>' >/dev/null; then
      say "ok   app on :$MENGER_SHELL_PORT behind its login page"
    else
      say "FAIL app on :$MENGER_SHELL_PORT: not behind its login page ($to)"; fail=1
    fi
  elif curl -fsS -m 5 "http://127.0.0.1:$MENGER_SHELL_PORT/" | grep "name=\"menger-ws-port\" content=\"$MENGER_WS_PORT\"" >/dev/null; then
    say "ok   app on :$MENGER_SHELL_PORT, stamped with :$MENGER_WS_PORT"
  else
    say "FAIL app on :$MENGER_SHELL_PORT"; fail=1
  fi
  local d=""
  for _ in $(seq 1 20); do
    d=$(timeout 10 synapse -P "$MENGER_DIAGRAMS_PORT" diagrams mermaid parse --source 'graph LR; a-->b' 2>/dev/null | grep -E 'diagram_type' || true)
    [[ -n $d ]] && break; sleep 0.5
  done
  [[ -n $d ]] && say "ok   diagrams on :$MENGER_DIAGRAMS_PORT parses" || { say "FAIL diagrams on :$MENGER_DIAGRAMS_PORT"; fail=1; }
  [[ -d $REPO/perf/node_modules/playwright ]] || (cd "$REPO/perf" && npm ci --silent >/dev/null)
  # The smoke account reaches the browser through its environment, never argv.
  if MENGER_SMOKE_USER=${MENGER_SMOKE_USER:-} MENGER_SMOKE_PASSWORD=${MENGER_SMOKE_PASSWORD:-} \
       node "$REPO/deploy/smoke-browser.mjs" "http://127.0.0.1:$MENGER_SHELL_PORT/" >&2; then :; else fail=1; fi
  # IDENTITY-38: where the dev sign-in lets the smoke be anyone (test), it
  # plays the login's known attacks against the live server; any that
  # works fails the smoke, so no release reaches prod with one open.
  if [[ $env == test && -n ${MENGER_DEV_LOGIN:-} && -n $login ]]; then
    if timeout 120 node "$REPO/deploy/probe-auth.mjs" "$MENGER_WS_PORT" "$MENGER_SHELL_PORT" >&2; then :; else fail=1; fi
  fi
  return $fail
}

# ── deploy test ─────────────────────────────────────────────────────────────
# Test's database becomes a live snapshot of prod's: SQLite's online backup,
# consistent while prod keeps running. Test's services must be stopped.
# `deploy test` and `sync test` both take it here.
snapshot_prod_into_test() {
  load_env test; local test_db=$MENGER_DB_PATH
  load_env prod; local prod_db=$MENGER_DB_PATH
  mkdir -p "$(dirname "$test_db")"
  rm -f "$test_db" "$test_db-wal" "$test_db-shm"
  if [[ -f $prod_db ]]; then
    sqlite3 "$prod_db" ".backup '$test_db'"
    say "test data: a snapshot of prod's ($(sqlite3 "$test_db" 'select count(*) from tickets') tickets)"
  else
    say "test data: prod has no database yet; test starts empty"
  fi
}

cmd_deploy() {
  [[ ${1:-} == test ]] || die "only 'deploy test' — production changes through 'promote'"
  local rel; rel=$(resolve_release "${2:-}")
  local was; was=$(running_release test)
  begin_run deploy
  step "deploy $rel to test"
  tell test started "$rel" "$was"
  stop test
  snapshot_prod_into_test
  switch_to test "$rel"
  restart test
  if cmd_smoke test; then
    chmod u+w "$RELEASES/$rel"; date -u +%FT%TZ > "$RELEASES/$rel/TESTED"; chmod a-w "$RELEASES/$rel"
    record test deploy "$rel" ok
    tell test succeeded "$rel" "$was"
    say "test runs $rel — smoke passed; the release is TESTED"
  else
    record test deploy "$rel" "smoke failed"
    tell test failed "$rel" "$was"
    die "test runs $rel and its smoke FAILED — prod untouched; see: deploy/pipeline logs test"
  fi
}

# ── sync ────────────────────────────────────────────────────────────────────
# DEPLOY-4: test's data refreshed from prod on demand — the snapshot `deploy
# test` takes, keeping the release test runs. One way only: a sync never
# writes prod. Test's previous data is backed up first (the newest few kept).
SYNC_BACKUPS_KEPT=5
cmd_sync() {
  [[ ${1:-} == test ]] || die "only 'sync test' — prod's data is never overwritten by a sync"
  local rel; rel=$(running_release test)
  [[ -n $rel ]] || die "test runs no release yet — 'deploy/pipeline deploy test' first"
  begin_run sync
  step "sync test from prod's data (test keeps $rel)"
  tell test started "$rel" "$rel"
  stop test
  local backup; backup=$(backup_db test before-sync)
  if [[ -n $backup ]]; then
    say "test's previous data: $backup"
    ls -1t "$(dirname "$backup")"/tickets.db.*-before-sync 2>/dev/null \
      | tail -n +$((SYNC_BACKUPS_KEPT + 1)) | xargs -r rm -f
  fi
  snapshot_prod_into_test
  restart test
  if cmd_smoke test; then
    record test sync "$rel" ok
    tell test succeeded "$rel" "$rel"
    say "test runs $rel on a fresh snapshot of prod's data — smoke passed"
  else
    record test sync "$rel" "smoke failed"
    tell test failed "$rel" "$rel"
    die "test's smoke FAILED after the sync — prod untouched; previous data: ${backup:-none}; see: deploy/pipeline logs test"
  fi
}

# ── promote ─────────────────────────────────────────────────────────────────
# Moves an environment (prod; `--to test` exists for the rollback drill) to a
# tested release, rolling back by itself if the smoke checks fail.
cmd_promote() {
  local rel="" adopt=0 to=prod
  while [[ $# -gt 0 ]]; do
    case $1 in
      --adopt) adopt=1 ;;
      --to) to=$2; shift ;;
      -*) die "unknown flag $1" ;;
      *) rel=$1 ;;
    esac; shift
  done
  check_env "$to"
  [[ -n $rel ]] || rel=$(running_release test)
  rel=$(resolve_release "$rel")
  [[ -f $RELEASES/$rel/TESTED ]] || die "$rel has not passed the test environment — run: deploy/pipeline deploy test $rel"
  load_env "$to"

  # Whatever holds the env's ports must be the env's own services, unless
  # adopting: the one-time retirement of a hand-started menger (DEPLOY-3).
  local holders; holders=$(foreign_holders "$to")
  if [[ -n $holders ]]; then
    [[ $adopt == 1 ]] || die "ports held by processes outside systemd: $holders — pass --adopt to stop them"
    for p in $holders; do
      local comm; comm=$(ps -o comm= -p "$p")
      [[ $comm == menger || $comm == menger-diagram* ]] || die "pid $p ($comm) holds a port and is not menger — not stopping it"
      say "adopting: stopping pid $p ($comm, $(readlink -f /proc/$p/exe))"
      kill -TERM "$p"; for _ in $(seq 1 40); do kill -0 "$p" 2>/dev/null || break; sleep 0.25; done
      kill -0 "$p" 2>/dev/null && die "pid $p did not stop"
    done
  fi

  local was; was=$(running_release "$to")
  begin_run promote
  step "promote $rel to $to (was: ${was:-none})"
  tell "$to" started "$rel" "$was"
  local backup; backup=$(backup_db "$to" "before-$rel")
  [[ -n $backup ]] && say "backup: $backup"
  switch_to "$to" "$rel"
  restart "$to"
  if cmd_smoke "$to"; then
    record "$to" promote "$rel" ok
    tell "$to" succeeded "$rel" "$was"
    say "$to runs $rel — smoke passed"
    return 0
  fi
  tell "$to" failed "$rel" "$was"
  say "smoke FAILED on $to — rolling back"
  stop "$to"
  [[ -n $backup ]] && restore_db "$to" "$backup" && say "restored $backup"
  if [[ -n $was ]]; then
    ln -sfn "$RELEASES/$was" "$(envdir "$to")/current"
    restart "$to"
    if cmd_smoke "$to"; then
      record "$to" promote "$rel" "smoke failed; rolled back to $was"
      tell "$to" rolled_back "$was" "$rel"
      die "$to is back on $was (smoke passed); $rel was not promoted"
    fi
    record "$to" promote "$rel" "smoke failed; rollback to $was ALSO failed"
    die "$to rollback to $was failed its smoke too — see: deploy/pipeline logs $to"
  fi
  record "$to" promote "$rel" "smoke failed; no previous release; $to stopped"
  die "$to had no previous release to return to; its services are stopped and its database restored"
}
foreign_holders() { # ENV → pids listening on the env's ports that are not its units' main pids
  load_env "$1"
  local mine=" " p
  for u in $(units_of "$1"); do mine+="$(systemctl --user show -p MainPID --value "$u" 2>/dev/null) "; done
  for port in "$MENGER_WS_PORT" "$MENGER_SHELL_PORT" "$MENGER_REST_PORT" "$MENGER_DIAGRAMS_PORT"; do
    for p in $(ss -ltnpH sport = :"$port" 2>/dev/null | grep -o 'pid=[0-9]*' | cut -d= -f2 | sort -u); do
      [[ $mine == *" $p "* ]] || echo "$p"
    done
  done | sort -u | tr '\n' ' ' | sed 's/ $//'
}

# ── rollback ────────────────────────────────────────────────────────────────
cmd_rollback() {
  local env=${1:-}; shift || true; check_env "$env"
  local restore=""
  [[ ${1:-} == --restore ]] && { restore=${2:-}; [[ -f $restore ]] || die "no backup '$restore'"; }
  local prev; prev=$(previous_release "$env"); [[ -n $prev ]] || die "$env has no previous release"
  local cur; cur=$(running_release "$env")
  begin_run rollback
  step "rollback $env: $cur → $prev"
  tell "$env" started "$prev" "$cur"
  stop "$env"
  [[ -n $restore ]] && { restore_db "$env" "$restore"; say "restored $restore"; }
  switch_to "$env" "$prev"
  restart "$env"
  if cmd_smoke "$env"; then record "$env" rollback "$prev" ok; tell "$env" rolled_back "$prev" "$cur"; say "$env runs $prev"
  else record "$env" rollback "$prev" "smoke failed"; tell "$env" failed "$prev" "$cur"; die "$env runs $prev but its smoke FAILED"; fi
}

# ── backfill ────────────────────────────────────────────────────────────────
# DEPLOY-12: deployments.log replayed into records (deploy/record --from
# pipeline-log, each with its commits from git where they can be listed),
# queued and sent like a run's. Idempotent: menger keeps a record it already
# has once (DEPLOY-11: project, environment, state, revision, run), and a run's
# own log line makes the record that run sent.
cmd_backfill() {
  [[ -f $LOG ]] || die "no $LOG"
  local recs r filled n=0 repo; repo=$(git_repo)
  recs=$("$RECORD" --from pipeline-log "$LOG" -c) || die "deploy/record could not read $LOG"
  while IFS= read -r r; do
    [[ -n $r ]] || continue
    filled=$("$RECORD" --from json --commits-from-git --repo "$repo" -c <<<"$r" 2>/dev/null) || filled=$r
    enqueue "$filled" || die "cannot write $OUTBOX"; n=$((n + 1))
  done <<<"$recs"
  say "backfill: $n records from $LOG → menger :$TRACKER_PORT"
  QUIET=1 flush_outbox
}

# ── status, releases, logs ──────────────────────────────────────────────────
# ── the landing page (DEPLOY-17) ────────────────────────────────────────────
# One command from a commit on main to menger.sh: landing/ exported at the
# commit, gated (the CSP's constraints, every referenced file present, both
# pages rendered clean), infra's pin moved to it, the edge applied by infra's
# own role (which validates, reloads and puts the old files back on a failed
# check), the live page compared byte for byte with the commit's, the pin
# committed in infra, and the whole thing recorded in menger as the `edge`
# environment of project menger, like a deploy to test or prod.
pinned_landing() { sed -n 's/^menger_landing_commit: *\([0-9a-f]\{7,40\}\).*/\1/p' "$INFRA/$INFRA_PIN" | head -n 1; }
set_pin() { sed -i "s/^menger_landing_commit: .*/menger_landing_commit: $1/" "$INFRA/$INFRA_PIN"; }
landing_gate() { # DIR (landing/ at the commit) — dies at the first failure
  local dir=$1 page ref f
  step "gate: the page's constraints"
  node --check "$dir/main.js" || die "gate: main.js does not parse"
  for page in index.html guide/index.html; do
    [[ -f $dir/$page ]] || die "gate: no $page in the commit"
    grep -q ' style="' "$dir/$page" && die "gate: $page has an inline style attribute — the CSP allows none"
    grep -q '<script>' "$dir/$page" && die "gate: $page has an inline script — the CSP allows none"
    # every file a page names on its own origin is in the commit
    while read -r ref; do
      [[ -z $ref || $ref =~ ^(https?:|data:|mailto:|#|\.\./#|\./$) ]] && continue
      f=$dir/$(dirname "$page")/${ref%%[?#]*}; f=${f%/}
      [[ -e $f ]] || die "gate: $page refers to $ref, which the commit does not hold"
    done < <(grep -o '\(src\|srcset\|href\)="[^"]*"' "$dir/$page" | sed 's/^[a-z]*="//; s/"$//' | tr ',' '\n' | awk '{print $1}' | sort -u)
  done
  step "gate: both pages render (deploy/landing-check.mjs)"
  node "$LANDING_CHECK" "$dir" >&2 || die "gate: the pages do not render clean"
}
cmd_landing() {
  local rev=main check=0 a
  for a in "$@"; do case $a in --check) check=1 ;; -*) die "unknown flag $a" ;; *) rev=$a ;; esac; done
  need git; need node; need jq
  [[ -x $INFRA/bin/infra && -f $INFRA/$INFRA_PIN ]] || die "no infra at $INFRA — MENGER_INFRA_DIR names a hypermemetic-infra checkout with bin/infra and $INFRA_PIN"
  local sha short was rel subject
  sha=$(git -C "$REPO" rev-parse --verify "$rev^{commit}" 2>/dev/null) || die "no commit '$rev'"
  short=${sha:0:7}
  subject=$(git -C "$REPO" log -1 --format=%s "$sha" | cut -c1-80)
  was=$(pinned_landing); [[ -n $was ]] || die "no menger_landing_commit in $INFRA/$INFRA_PIN"
  step "landing $short — $subject"
  [[ $was == "$sha" ]] && say "the pin already holds $short"

  # infra reads the commit from a checkout it mounts read-only: the main
  # repository, not a worktree (whose .git is a file pointing outside the
  # mount); every worktree's commits are in it. Playwright for the render
  # gate comes from the same place when this checkout has none installed.
  local src; src=$(dirname "$(git -C "$REPO" rev-parse --path-format=absolute --git-common-dir)")
  [[ -d $REPO/perf/node_modules/playwright ]] || export PLAYWRIGHT_FROM=${PLAYWRIGHT_FROM:-$src/perf}

  LANDING_EXPORT=$(mktemp -d)
  git -C "$REPO" archive "$sha" landing | tar -x -C "$LANDING_EXPORT" || die "no landing/ at $short"
  landing_gate "$LANDING_EXPORT/landing"

  if [[ $check == 1 ]]; then
    step "infra: what would change (bin/infra edge.yml --check --diff)"
    INFRA_MENGER_DIR=$src "$INFRA/bin/infra" edge.yml --check --diff -e "menger_landing_commit=$sha" >&2 \
      || die "infra's dry run failed"
    say "checked: $short passes the gate and infra would take it; nothing written"
    return 0
  fi

  rel=landing-$(date -u +%Y%m%dT%H%M%SZ)-$short
  begin_run landing
  tell edge started "$rel" "pin-${was:0:7}"
  step "infra: pin $short, apply the edge (bin/infra edge.yml)"
  set_pin "$sha"
  if ! INFRA_MENGER_DIR=$src "$INFRA/bin/infra" edge.yml >&2; then
    set_pin "$was"
    record edge deploy "$rel" "infra apply failed; pin restored to ${was:0:7}"
    tell edge failed "$rel" "pin-${was:0:7}"
    die "the edge did not take $short — infra put the old files back; the pin holds ${was:0:7} again"
  fi
  if [[ $LANDING_URL != none ]]; then
    step "verify: $LANDING_URL/ serves the commit's index.html"
    local want got
    want=$(git -C "$REPO" show "$sha:landing/index.html" | sha256sum | cut -d' ' -f1)
    got=$(curl -fsS -H 'Cache-Control: no-cache' "$LANDING_URL/" 2>/dev/null | sha256sum | cut -d' ' -f1)
    if [[ $want != "$got" ]]; then
      record edge deploy "$rel" "applied, but $LANDING_URL/ does not serve the commit's index.html"
      tell edge failed "$rel" "pin-${was:0:7}"
      die "$LANDING_URL/ does not serve $short's index.html — the pin is moved and infra's checks passed; see: bin/infra status.yml"
    fi
  fi
  git -C "$INFRA" add "$INFRA_PIN"
  if git -C "$INFRA" diff --cached --quiet; then
    say "infra: the pin already held $short — nothing to commit"
  else
    git -C "$INFRA" commit -q -m "menger.sh at $short — $subject (deploy/pipeline landing)" \
      || die "infra: the pin changed but could not be committed — commit $INFRA/$INFRA_PIN by hand"
  fi
  record edge deploy "$rel" ok
  tell edge succeeded "$rel" "pin-${was:0:7}"
  say "menger.sh serves $short"
}
cmd_media() {
  local rel; rel=$(resolve_release "${1:-$(running_release prod)}")
  step "media from $rel — $(sed -n 's/^subject: *//p' "$RELEASES/$rel/RELEASE" | cut -c1-70)"
  MENGER_BIN=$RELEASES/$rel/bin/menger MENGER_APP_DIST=$RELEASES/$rel/app PLAYWRIGHT_FROM=$REPO/perf \
    "$REPO/scripts/landing-media.sh" all || die "scripts/landing-media.sh failed"
  say "changed under landing/media:"
  git -C "$REPO" status --short landing/media | sed 's/^/  /' >&2
  say "commit them, merge, then: deploy/pipeline landing"
}
edge_status() {
  [[ -f $INFRA/$INFRA_PIN ]] || return 0
  local pin behind title
  pin=$(pinned_landing)
  printf 'edge\n'
  if [[ -n $pin ]] && git -C "$REPO" cat-file -e "$pin^{commit}" 2>/dev/null; then
    printf '  landing   %s  %s\n' "${pin:0:7}" "$(git -C "$REPO" log -1 --format=%s "$pin" | cut -c1-70)"
    behind=$(git -C "$REPO" rev-list --count "$pin..main" -- landing 2>/dev/null || echo "?")
    printf '  main      %s commit(s) touching landing/ since the pin\n' "$behind"
  else
    printf '  landing   %s (not a commit this checkout has)\n' "${pin:-no pin}"
  fi
  if [[ $LANDING_URL != none ]]; then
    title=$(timeout 10 curl -fsS "$LANDING_URL/" 2>/dev/null | sed -n 's/.*<title>\([^<]*\).*/\1/p' | head -n 1)
    if [[ -n $title ]]; then printf '  live      %s/ — %s\n' "$LANDING_URL" "$title"
    else printf '  live      no answer from %s/\n' "$LANDING_URL"; fi
  fi
  record_status edge
}

cmd_status() {
  for env in prod test; do
    [[ -f $(env_file $env) ]] || { say "$env: not installed"; continue; }
    load_env "$env"
    local rel; rel=$(running_release "$env")
    printf '%s\n' "$env"
    printf '  release   %s%s\n' "${rel:-none}" "$([[ -n $rel && -f $RELEASES/$rel/TESTED ]] && echo '  (tested)')"
    [[ -n $rel ]] && printf '  commit    %s\n' "$(sed -n 's/^subject: *//p' "$RELEASES/$rel/RELEASE" | cut -c1-90)"
    printf '  previous  %s\n' "$(previous_release "$env" || true)"
    for u in $(units_of "$env"); do
      printf '  %-28s %s since %s\n' "$u" "$(systemctl --user is-active "$u" 2>/dev/null || true)" \
        "$(systemctl --user show -p ActiveEnterTimestamp --value "$u" 2>/dev/null)"
    done
    # a refused or silent health (test behind its login) is a line, never the end of status
    local h; h=$(timeout 5 synapse -P "$MENGER_WS_PORT" menger tickets health 2>/dev/null | sed -n 's/^ *ticket_count: *//p' || true)
    if [[ -n $h ]]; then printf '  health    %s tickets on :%s\n' "$h" "$MENGER_WS_PORT"
    else printf '  health    no answer on :%s\n' "$MENGER_WS_PORT"; fi
    printf '  app       http://127.0.0.1:%s/\n' "$MENGER_SHELL_PORT"
    local f; f=$(foreign_holders "$env"); [[ -n $f ]] && printf '  outside   pids %s hold its ports outside systemd\n' "$f"
    record_status "$env"
  done
  edge_status
}
record_status() { # ENV → its last deployment record sent (DEPLOY-12), and what waits to be
  local f=$SENT/${1//\//_}.json n=0 q
  if [[ -f $f ]]; then
    printf '  record    %s\n' "$(jq -r '"\(.state) \(.revision)\(if .release then " (\(.release))" else "" end) at \(.at), \(.source.run // "-") — sent \(.sent_at)\(if .sent == "already kept" then ", already kept" else "" end)"' "$f")"
  else
    printf '  record    none sent yet\n'
  fi
  for q in $(queued); do [[ $(jq -r .environment "$OUTBOX/$q" 2>/dev/null) == "$1" ]] && n=$((n + 1)); done
  [[ $n -gt 0 ]] && printf '  outbox    %s record(s) waiting for menger on :%s\n' "$n" "$TRACKER_PORT"
  n=$(ls -1 "$OUTBOX/refused" 2>/dev/null | grep -c '\.json$' || true)
  [[ $n -gt 0 ]] && printf '  refused   %s record(s) menger refused, in %s/refused\n' "$n" "$OUTBOX"
  return 0
}
cmd_releases() {
  for r in $(ls -1 "$RELEASES" 2>/dev/null | grep -v '\.tmp$' | sort); do
    local where=""
    for e in prod test; do [[ $(running_release $e) == "$r" ]] && where+=" $e"; [[ $(previous_release $e) == "$r" ]] && where+=" $e(previous)"; done
    printf '%s  %-6s %-22s %s\n' "$r" "$([[ -f $RELEASES/$r/TESTED ]] && echo tested || echo -)" "${where# }" \
      "$(sed -n 's/^subject: *//p' "$RELEASES/$r/RELEASE" | cut -c1-70)"
  done
}
cmd_logs() { local env=${1:-}; check_env "$env"; shift; journalctl --user -u "menger@$env" -u "menger-diagrams@$env" "$@"; }

# ── dispatch ────────────────────────────────────────────────────────────────
cmd=${1:-}; shift || true
case $cmd in
  install)  cmd_install "$@" ;;
  build)    cmd_build "$@" ;;
  deploy)   cmd_deploy "$@" ;;
  sync)     cmd_sync "$@" ;;
  promote)  cmd_promote "$@" ;;
  rollback) cmd_rollback "$@" ;;
  smoke)    cmd_smoke "$@" ;;
  status)   cmd_status ;;
  releases) cmd_releases ;;
  logs)     cmd_logs "$@" ;;
  backfill) cmd_backfill ;;
  landing)  cmd_landing "$@" ;;
  media)    cmd_media "$@" ;;
  *) sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 2 ;;
esac
