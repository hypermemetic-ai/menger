  (cd "$CONTRACT_SCRATCH" && exec "${env[@]}" "$bin" --port "$port" --shell-port "$shell" --data-dir "$CONTRACT_SCRATCH/data") >>"$lg" 2>&1 &
  CONTRACT_PID=$!
  # signed in as the binary's own admin (the key it made; menger-local), once it answers
  until=$((SECONDS + CONTRACT_WAIT))
  while :; do
    if ! kill -0 "$CONTRACT_PID" 2>/dev/null; then
      local rc=0; wait "$CONTRACT_PID" 2>/dev/null || rc=$?; CONTRACT_PID=""
      red_run; die "contract: the release's menger exited ($rc) before it answered on :$port — $lg"
    fi
