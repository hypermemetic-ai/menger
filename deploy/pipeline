# ── UI-12: the contract a release's bundle is built against ──────────────────
# The bundle names the services it was built against (manifest.contract), and ui.push answers
# whether the running services are those (contract_matches): its hash over the services the
# bundle's components' `uses` name (contract_named → contract_over, ../plexus-ui/service/src/push.rs).
# SURFACE-11: the build stamps that hash, never tickets.schema's alone — a bundle naming orgs,
# orgs or ui beside tickets hashes differently. The bundle is built once unstamped, its
# manifest's components.*.uses read from the tar (bundle_uses), and the menger just built is
# asked `ui contract --uses` them (ui.contract: the hash a push of them computes). The build reads
# that from the menger it has just built: it starts that binary on two free loopback ports in
# local mode — no login provider, so the binary makes its own admin key in its (scratch) data
# directory and links it for synapse as menger-local: the build holds no key material, and a
# throwaway key is all there is — under a scratch HOME and XDG_RUNTIME_DIR (mktemp's), signs
# in with that key, asks `ui contract` for each bundle with synapse (--no-hold: no connection holder
# outlives the build; the sign-in lands in the scratch HOME, so no default agent of this
# machine's moves), and stops it — always, by on_exit's contract_stop too. The hash goes to the
# bundle's second build as `plexus-ui build --contract HASH`: the tool asks no socket of its own. A binary that dies, never answers within MENGER_CONTRACT_WAIT seconds (60), or
# a read with no hash (a refusal, a bundle naming no service), fails the build, named: no bundle saying `unknown` is released.
CONTRACT_WAIT=${MENGER_CONTRACT_WAIT:-60}
CONTRACT="" CONTRACTS=() CONTRACT_PID="" CONTRACT_SCRATCH=""
contract_stop() {
  local n=0
  if [[ -n $CONTRACT_PID ]]; then
    kill -TERM "$CONTRACT_PID" 2>/dev/null || true
    while kill -0 "$CONTRACT_PID" 2>/dev/null && (( n++ < 100 )); do sleep 0.05; done
    kill -0 "$CONTRACT_PID" 2>/dev/null && kill -KILL "$CONTRACT_PID" 2>/dev/null
    wait "$CONTRACT_PID" 2>/dev/null || true
    CONTRACT_PID=""
  fi
  if [[ -n $CONTRACT_SCRATCH && -d $CONTRACT_SCRATCH ]]; then rm -rf "$CONTRACT_SCRATCH"; fi
  CONTRACT_SCRATCH=""
  return 0
}
free_port() { # [NOT] → a port on loopback nothing listens on, far from every environment's (4450–4471)
  local p i
  for i in $(seq 200); do
    p=$((20000 + RANDOM % 40000))
    [[ $p == "${1:-}" ]] && continue
    (exec 3<>"/dev/tcp/127.0.0.1/$p") 2>/dev/null && continue
