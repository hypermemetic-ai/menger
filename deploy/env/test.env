# DEPLOY-1: the test environment. Its database is a snapshot of prod's, taken
# by every `deploy/pipeline deploy test`. It never registers with a registry,
# so nothing can mistake it for production. `deploy/pipeline install` writes
# this to ~/.config/menger/test.env with @HOME@ and @NODE@ filled in.
MENGER_ENV=test
MENGER_WS_PORT=4450
MENGER_SHELL_PORT=4451
MENGER_REST_PORT=4452
MENGER_DIAGRAMS_PORT=4453
MENGER_DB_PATH=@HOME@/.local/share/menger-test/tickets.db
MENGER_DIAGRAMS_NODE=@NODE@
PLEXUS_NO_REGISTRY=1
