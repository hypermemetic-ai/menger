# RUN-11: app.menger.sh — menger's production on the Linode. DECLARED, NOT
# DEPLOYED until RUN-13 (the release; prod's data moved here, ACCESS-47
# `move`). Until then infra refuses `app.yml -e env=prod` (prod runs nothing;
# its image changes only through promote.yml). Settings only, as
# app-test.env.
MENGER_ENV=prod
MENGER_PUBLIC_URL=https://app.menger.sh
MENGER_BIND=0.0.0.0
MENGER_TRUSTED_PROXIES=172.30.0.2/32
# Sign-in: WorkOS AuthKit (the owner's `sign-in` answer on RUN-11, 2026-10-17)
# on WorkOS's PRODUCTION environment (RUN-3 `workos-env` = production) — no
# WorkOS secret on the box; the production key stays sealed to the owner's
# Ledger. The production client id (not a secret) replaces this placeholder
# before the first promote: it is the owner's `prod-ids` input on RUN-11.
# RUN-12 registers https://app.menger.sh/login/callback in production
# (deploy/workos-redirect-uris, through ledger-secret).
MENGER_AUTH_PROVIDERS=workos=client_PRODUCTION_CLIENT_ID_RUN_13;key=wss://app.menger.sh/ws
MENGER_LOGIN_EMAIL=workos:authkit
MENGER_LOGIN_BUTTONS=Google=workos:GoogleOAuth;Apple=workos:AppleOAuth;Microsoft=workos:MicrosoftOAuth;GitHub=workos:GitHubOAuth
MENGER_REQUIRE_LOGIN=1
MENGER_NO_REST=1
# Admins: the owner — their user in WorkOS PRODUCTION, the account made by
# signing in there with GitHub as `hypermemetic` (a new environment, so not
# staging's user_01M4GTJS…) — added as oidc:workos/<production user id> when
# RUN-11's `prod-ids` names it (`deploy/workos-redirect-uris user <email>`
# through ledger-secret prints it); and the `operator` key. menger has no
# admin-by-email form: until the id is here, the owner's first sign-in waits
# in `members requests` and the operator key grants it admin on `*`.
MENGER_ADMINS=key:ba720a3d0cfbbf974cf6d57fe57832ad2c2c6198375691be98e28afbe3974b8e
