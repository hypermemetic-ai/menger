# RUN-11: app.menger.sh — menger's production on the Linode. DECLARED, NOT
# DEPLOYED: it waits on the owner's `sign-in` input on RUN-11 and on RUN-13
# (the release: prod's data moved here, ACCESS-47 `move`). Until then infra
# refuses `app.yml -e env=prod` (prod runs nothing; its image changes only
# through promote.yml). Settings only, as app-test.env.
MENGER_ENV=prod
MENGER_PUBLIC_URL=https://app.menger.sh
MENGER_BIND=0.0.0.0
MENGER_TRUSTED_PROXIES=172.30.0.2/32
# The WorkOS PRODUCTION client (RUN-3 `workos-env` = production) replaces
# this placeholder before the first promote — RUN-12 registers
# https://app.menger.sh/login/callback there. With AuthKit no key is on the
# box; with our own page (`own-page`) the key goes in the box's secret.env.
MENGER_AUTH_PROVIDERS=workos=client_PRODUCTION_CLIENT_ID_RUN_13;key=wss://app.menger.sh/ws
MENGER_LOGIN_EMAIL=workos:authkit
MENGER_LOGIN_BUTTONS=Google=workos:GoogleOAuth;Apple=workos:AppleOAuth;Microsoft=workos:MicrosoftOAuth;GitHub=workos:GitHubOAuth
MENGER_REQUIRE_LOGIN=1
MENGER_NO_REST=1
# The owner's principal in the production WorkOS environment is not known
# yet (a new environment, a new user id): RUN-13 sets it. The operator key.
MENGER_ADMINS=key:ba720a3d0cfbbf974cf6d57fe57832ad2c2c6198375691be98e28afbe3974b8e
