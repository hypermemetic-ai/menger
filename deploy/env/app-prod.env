# RUN-11: app.menger.sh — menger's production on the Linode, prod's data
# moved here by RUN-13 (ACCESS-47 `move`). Its image changes only through
# infra's promote.yml (`deploy/pipeline remote prod`). Settings only, as
# app-test.env.
MENGER_ENV=prod
MENGER_PUBLIC_URL=https://app.menger.sh
MENGER_BIND=0.0.0.0
MENGER_TRUSTED_PROXIES=172.30.0.2/32
# Sign-in: WorkOS AuthKit (the owner's `sign-in` answer on RUN-11, 2026-10-17)
# on WorkOS's PRODUCTION environment (RUN-3 `workos-env` = production).
# IDENTITY-45: the production API key is a secret FILE on the box, never in
# this file — `deploy/pipeline remote-secret prod` (deploy/README.md "The
# WorkOS key on the box"); infra names it to menger as
# MENGER_WORKOS_API_KEY_FILE, and the GitHub button then completes through
# WorkOS's API on menger's own page (email verification, Radar). Without
# the file, the PKCE path. The production client id (not a secret) is from the owner's
# dashboard (RUN-11 `prod-ids`, 2026-10-17); its redirect URIs,
# https://app.menger.sh/login/callback and app-test's, were added by the
# owner's run of deploy/workos-redirect-uris through ledger-secret (RUN-12).
# TRANSPORT-24: a third provider, the generic OIDC one named `authkit`, admits
# the tokens WorkOS AuthKit mints for MCP clients (Connect: `iss` the
# environment's AuthKit domain, `aud` this server's MCP resource) as
# oidc:authkit/<WorkOS user id> — a principal of its own until TRANSPORT-20
# folds it into oidc:workos/<user id>. The `workos` provider is unchanged.
MENGER_AUTH_PROVIDERS=workos=client_01M4GRE1PVRFQJ7T4EMSK4MQKN;oidc:authkit=https://manageable-editor-54.authkit.app,https://app.menger.sh/mcp;key=wss://app.menger.sh/ws
# TRANSPORT-24: /mcp is an OAuth 2.1 protected resource — a request without a
# token is 401 naming /.well-known/oauth-protected-resource/mcp, which names
# this authorization server; Claude Code's /mcp then shows Authenticate.
MENGER_MCP_AUTHORIZATION_SERVERS=https://manageable-editor-54.authkit.app
# TRANSPORT-24: no password form — the generic provider "takes passwords" and
# would otherwise be the form's default; sign-in stays the GitHub button.
MENGER_LOGIN_PASSWORD=none
# GitHub only (the owner, 2026-10-17: "I think that's all we support for right now. nothing else"); WorkOS
# production's GitHub uses the owner's own OAuth app, callback
# https://auth.workos.com/sso/oauth/github/uXPvlu2ZBL3hn8XOItxAKXx92/callback.
MENGER_LOGIN_BUTTONS=GitHub=workos:GitHubOAuth
MENGER_REQUIRE_LOGIN=1
MENGER_NO_REST=1
# Admins: the owner — their user in WorkOS PRODUCTION, the account made by
# signing in there with GitHub as `hypermemetic` (a new environment, so not
# staging's user_01M4GTJS…) — added as oidc:workos/<production user id> when
# it is known; and the `operator` key. The owner had no user in production
# yet (2026-10-17), and menger has no admin-by-email form: their first
# sign-in waits in `members requests` and the operator key grants it admin on
# `*` (RUN-11's bootstrap); the principal is added here after.
MENGER_ADMINS=key:ba720a3d0cfbbf974cf6d57fe57832ad2c2c6198375691be98e28afbe3974b8e
# CHAT-13: the standing chat members — in every chat opened, and seated in
# every open chat at startup: the builder's key — the chat bridge (CHAT-11) answers there.
MENGER_CHAT_MEMBERS=key:54a9677a62e4289ee5a2d0a4751a6f188abafd8b1f2b2d4019ec0768eb3b0d28
# APP-110: the tracker draws the live test app in a ticket (`live` block): test's origin.
# app-test.menger.sh must name app.menger.sh in MENGER_FRAME_ANCESTORS (app-test.env).
MENGER_LIVE_ORIGIN=https://app-test.menger.sh
