# RUN-11: app-test.menger.sh — menger's test environment on the Linode,
# behind the edge's Caddy (hypermemetic-infra, deploy/app.yml). Copied to
# /opt/apps/menger-test/app.env by infra on every run. Settings only: nothing
# here is a secret (AuthKit needs none; a secret would go in the box's
# secret.env). Its own tracker, empty at first (owner, 2026-10-12): the
# volume menger-test_data. The image sets the bind (0.0.0.0), the ports
# (8080 WebSocket, 8081 shell), MENGER_NO_REST and the database
# (/data/tickets.db); infra's compose sets MENGER_TRUSTED_PROXIES to the
# edge's pinned address (172.30.0.2/32, SCAFFOLD-22), which wins over this
# file — the value below says the same, for a run outside infra.
MENGER_ENV=test
MENGER_PUBLIC_URL=https://app-test.menger.sh
MENGER_BIND=0.0.0.0
MENGER_TRUSTED_PROXIES=172.30.0.2/32
# Sign-in (RUN-11 `sign-in`, recommended: AuthKit): WorkOS's STAGING client,
# as this machine's prod and test use — its redirect URI
# https://app-test.menger.sh/login/callback is registered there
# (deploy/workos-redirect-uris list). `key` admits agents' key proofs naming
# this socket (synapse --url wss://app-test.menger.sh/ws _login …); it is
# not offered on the login page.
MENGER_AUTH_PROVIDERS=workos=client_01M4GRE0HND6SKGPV780GPTYDX;key=wss://app-test.menger.sh/ws
MENGER_LOGIN_EMAIL=workos:authkit
MENGER_LOGIN_BUTTONS=Google=workos:GoogleOAuth;Apple=workos:AppleOAuth;Microsoft=workos:MicrosoftOAuth;GitHub=workos:GitHubOAuth
MENGER_REQUIRE_LOGIN=1
MENGER_NO_REST=1
# Admins: the owner (WorkOS staging) and the `operator` key (ACCESS-47).
# Nothing else is granted.
MENGER_ADMINS=oidc:workos/user_01M4GTJS2WTGNCXY1ZSXNSDE7M;key:ba720a3d0cfbbf974cf6d57fe57832ad2c2c6198375691be98e28afbe3974b8e
