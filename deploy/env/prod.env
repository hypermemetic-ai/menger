# DEPLOY-1: production. The ports and the database are the ones menger has
# always served from. `deploy/pipeline install` writes this to
# ~/.config/menger/prod.env with @HOME@ and @NODE@ filled in.
MENGER_ENV=prod
MENGER_WS_PORT=4455
MENGER_SHELL_PORT=4456
MENGER_REST_PORT=4457
MENGER_DIAGRAMS_PORT=4458
MENGER_DB_PATH=@HOME@/.local/share/menger/tickets.db
MENGER_DIAGRAMS_NODE=@NODE@
