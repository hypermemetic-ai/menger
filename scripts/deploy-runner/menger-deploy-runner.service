# DEPLOY-37: the deploy runner — the executor behind the deploy page's
# "→ test" and "→ prod" (DEPLOY-40: image → app-test → app-prod, the owner's only): it takes each deploy request (the webhook on loopback, or by
# dialling out to the tracker) and runs deploy/pipeline build → deploy test,
# reporting each step back against the request. Installed by
# scripts/deploy-runner/install.sh as ~/.config/systemd/user/menger-deploy-runner.service,
# running the installed copy in ~/.local/share/menger-deploy-runner. The
# pipeline it runs is the main checkout's (MENGER_RUNNER_REPO), which builds
# main's tip — never a worktree.
#
#   systemctl --user status menger-deploy-runner
#   journalctl --user -u menger-deploy-runner -f
#   systemctl --user disable --now menger-deploy-runner   # stop it for good
#
# Settings: ~/.config/menger/deploy-runner.env (the tracker, the mode, the
# repository); the webhook's secret: ~/.config/menger/deploy-runner.secret
# (0600; set on the tracker from the same file, deploy/README "The deploy runner").
[Unit]
Description=menger deploy runner (DEPLOY-37) - carries out deploy requests through deploy/pipeline
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/menger/deploy-runner.env
WorkingDirectory=%h
ExecStart=/bin/sh -c 'exec node %h/.local/share/menger-deploy-runner/deploy/runner.mjs $MENGER_RUNNER_MODE'
Restart=always
RestartSec=5
# A build under way is the pipeline's: let it finish its own cleanup.
KillMode=mixed
TimeoutStopSec=60

[Install]
WantedBy=default.target
