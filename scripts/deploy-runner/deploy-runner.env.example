# DEPLOY-37: the deploy runner's settings (read by menger-deploy-runner.service).
# How it takes requests: --watch dials out to the tracker (app.menger.sh cannot
# reach this machine); --listen takes the webhook on 127.0.0.1:$MENGER_RUNNER_PORT
# (a tracker on this machine, or an https route to it); both is "--listen --watch".
MENGER_RUNNER_MODE=--watch
MENGER_URL=wss://app.menger.sh/ws
MENGER_RUNNER_PROJECT=MENGER
MENGER_RUNNER_PORT=4475
MENGER_RUNNER_SECRET_FILE=/home/hypermemetic/.config/menger/deploy-runner.secret
# The checkout whose deploy/pipeline runs (it builds main's tip; never a worktree).
MENGER_RUNNER_REPO=/home/hypermemetic/dev/controlflow/hypermemetic/menger
# DEPLOY-40: who may ask for a deploy to app-prod (#/deploy's → prod) — the owner's
# principals, comma-separated (as in MENGER_ADMINS, without its keys: a key or an
# agent is refused whatever this says). Empty: every app-prod request is refused.
MENGER_RUNNER_OWNERS=
# The key it reports as: deployer on MENGER (the pipeline's).
MENGER_DEPLOY_KEY_FILE=/home/hypermemetic/.plexus/keys/pipeline.key
# DEPLOY-48: a ticket of the project entering In Review (or a commit linked to one there)
# deploys main's tip to test by itself — debounced, at most one run and one pending request.
# 0 turns it off (→ test on #/deploy still works); `deploy/pipeline status` says which.
MENGER_RUNNER_AUTO_TEST=1
# The quiet after the last trigger before a run is filed, seconds.
MENGER_RUNNER_DEBOUNCE_SECS=60
# A red auto-test run is posted to its ticket's chat, else this one, and a gap blocking the
# triggering tickets is filed — both as this key (an editor's; `none`: neither).
MENGER_RUNNER_CHAT=6
MENGER_RUNNER_EDITOR_KEY_FILE=/home/hypermemetic/.plexus/keys/builder.key
