# CHAT-11: ~/.config/menger/chat-bridge.env — the chat bridge's settings.
# Which tracker it watches. To switch, change this one line, then
#   systemctl --user restart menger-chat-bridge
# RUN-13 moved prod's data to app.menger.sh (2026-10-17); :4455 is the local
# prod it moved from. The builder key must be granted on the one named.
MENGER_URL=wss://app.menger.sh/ws
#MENGER_URL=ws://127.0.0.1:4455

# The key it signs in with (a key proof at the upgrade; the file, 0600, never its contents).
MENGER_KEY_FILE=/home/hypermemetic/.plexus/keys/builder.key
MENGER_AGENT=builder

# Who it answers, one principal a line (read on every message).
CHAT_BRIDGE_ALLOW=/home/hypermemetic/.config/menger/chat-bridge.allow
# CHAT-45: each archetype's default model — the architect (this bridge), the
# builder, the analyst — one file the bridge and every launcher read, on
# every turn (no restart). install.sh writes it once from
# archetypes.env.example. A chat changes its own with /model.
CHAT_BRIDGE_ARCHETYPES=/home/hypermemetic/.config/menger/archetypes.env
# Its state: per chat the last message handled and the Claude session; turns.log.
CHAT_BRIDGE_STATE=/home/hypermemetic/.local/state/menger/chat-bridge
# Where the agent runs (its CLAUDE.md / AGENTS.md are read from here up).
CHAT_BRIDGE_CWD=/home/hypermemetic/dev/controlflow/hypermemetic/menger
CHAT_BRIDGE_MAX=3
# A turn's limit in minutes; 0 is none (CHAT-36).
CHAT_BRIDGE_TURN_MINUTES=0
# CHAT-18: the live line (chats.activity) shows the work at once; this posts
# "working…" after N seconds only where the server takes no activity (0 = never).
CHAT_BRIDGE_WORKING_AFTER=20
CLAUDE_BIN=/home/hypermemetic/.local/bin/claude
