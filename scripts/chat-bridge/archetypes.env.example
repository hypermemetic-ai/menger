# CHAT-45: ~/.config/menger/archetypes.env — each archetype's default model.
# One file the chat bridge and every launcher read (scripts/chat-bridge/models.mjs);
# read on every turn, so an edit needs no restart. A value is a model's id or
# its short name: opus, sonnet, haiku, fable. A missing line is the built-in
# default. A chat changes its own model with /model; a delegate (CHAT-46)
# takes the default of the archetype it is given.
#   claude -p --model "$(node scripts/chat-bridge/models.mjs builder)" …

# answers in chat, through the bridge
MENGER_MODEL_ARCHITECT=claude-opus-5-5
# a detached run that builds a ticket
MENGER_MODEL_BUILDER=claude-opus-5-5
# reads and reports
MENGER_MODEL_ANALYST=claude-sonnet-5-5
