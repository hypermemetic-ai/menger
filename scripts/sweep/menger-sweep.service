# CI-2: the build-output sweep (scripts/sweep/install.sh installs it).
[Unit]
Description=menger: sweep idle cargo build output; tell the owner when the disk is full (CI-2)

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
# RUN-34: the sweep's own settings, if any — MENGER_SCRATCH_DIRS=DIR:DIR, the
# scratch roots beyond ~/.cache/menger-perf-scratch whose ui8-* work directories
# it takes (scripts/cleanup-gate.sh's ui8-work)
EnvironmentFile=-%h/.config/menger/sweep.env
ExecStart=%h/.local/share/menger-sweep/run
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=30min
