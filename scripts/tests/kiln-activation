#!/usr/bin/env bash
# shellcheck disable=SC2015  # `check && ok || bad` is the house assertion
# LAYERS-20: `scripts/kiln-activation --check` — fresh when the generated
# ui/src/kiln-activation.svelte carries the kiln's interface hash, stale (exit 1,
# both hashes named) when the kiln's IR says another. A stand-in PLEXUS_FRESH
# holds only the IR: nothing is built. Against the real packages, where they
# are beside the checkout, the committed file is checked too. `cargo test`
# runs it (tests/scripts.rs).
set -uo pipefail
SELF=$(readlink -f "$0"); ROOT=$(dirname "$(dirname "$(dirname "$SELF")")")
GEN=$ROOT/scripts/kiln-activation
FILE=$ROOT/ui/src/kiln-activation.svelte
T=$(mktemp -d); trap 'rm -rf "$T"' EXIT
pass=0 fail=0
ok()  { pass=$((pass + 1)); }
bad() { fail=$((fail + 1)); printf 'FAIL %s\n' "$*" >&2; }
is()  { [[ $2 == "$3" ]] && ok || bad "$1: got '$2', wanted '$3'"; }
has() { [[ $2 == *"$3"* ]] && ok || bad "$1: wanted '$3' in: $2"; }

kept=$(sed -n 's|^ *// interface \([0-9a-f]*\)$|\1|p' "$FILE")
[[ $kept =~ ^[0-9a-f]{16}$ ]] && ok || bad "the generated file's header names an interface: '$kept'"
head -3 "$FILE" | grep -q "GENERATED by scripts/kiln-activation" && ok || bad "the header says it is generated"
grep -q "^  // from plexus-examples [0-9a-f]\{40\}" "$FILE" && ok || bad "the header names plexus-examples' commit"

# LSTORE-5: every wasm in the file (base64) built with no path of the machine that built it, the
# kiln among them with no SQLite inside, and the engine carried once.
said=$(node -e '
  const text = require("node:fs").readFileSync(process.argv[1], "utf8");
  const wasm = (t) => [...t.matchAll(/["\x27`]([A-Za-z0-9+/]{200,}={0,2})["\x27`]/g)].map((m) => Buffer.from(m[1], "base64"))
    .filter((b) => b.subarray(0, 4).equals(Buffer.from([0, 0x61, 0x73, 0x6d])));
  const sqlite = (t) => wasm(t).filter((b) => b.includes("SQLite format 3")).length;
  const homes = wasm(text).flatMap((b) => b.toString("latin1").match(/\/(var\/)?home\/[\x21-\x7e]*/g) ?? []);
  const kiln = text.split("async function loadKiln()")[1] ?? "";
  console.log(`${wasm(text).length} wasm, ${sqlite(text)} with SQLite, the kiln ${sqlite(kiln)}; home paths: ${homes.slice(0, 3).join(" ") || "none"}`);
' "$FILE")
has "the wasm in the file: no home path ($said)" "$said" "home paths: none"
has "the wasm in the file: SQLite once, in the engine, not the kiln ($said)" "$said" ", 1 with SQLite, the kiln 0;"

ir() { mkdir -p "$T/$1/plexus-examples/ir"; printf '{"ir":"plexus/0","activation":"kiln","hash":"%s"}\n' "$2" >"$T/$1/plexus-examples/ir/kiln.json"; }

ir same "$kept"
out=$(PLEXUS_FRESH=$T/same "$GEN" --check 2>&1); code=$?
is "fresh: exit" "$code" 0
has "fresh: says so" "$out" "fresh — interface $kept"

ir moved 0123456789abcdef
out=$(PLEXUS_FRESH=$T/moved "$GEN" --check 2>&1); code=$?
is "stale: exit" "$code" 1
has "stale: names the file's hash" "$out" "carries the kiln's interface $kept"
has "stale: names the kiln's hash" "$out" "says 0123456789abcdef"

out=$(PLEXUS_FRESH=$T/none "$GEN" --check 2>&1); code=$?
is "no IR: exit" "$code" 2
has "no IR: says where" "$out" "no kiln IR there"

# The real packages, when they are beside the checkout (the house's machines).
for d in "$ROOT/../fresh" "$ROOT/../../fresh"; do
  if [[ -f $d/plexus-examples/ir/kiln.json ]]; then
    out=$(PLEXUS_FRESH=$d "$GEN" --check 2>&1); code=$?
    is "against $d: exit ($out)" "$code" 0
    break
  fi
done

printf '%d passed, %d failed\n' "$pass" "$fail"
[[ $fail == 0 ]]
