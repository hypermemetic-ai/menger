#!/usr/bin/env bash
# shellcheck disable=SC2015,SC2181,SC2143  # `check && ok || bad` is the house assertion (deploy/tests)
# RUN-21: scripts/cleanup-gate.sh on a throwaway root — a workspace with a
# main checkout and its worktrees (merged, unmerged, dirty, an agent's), gate
# scratch dirs, cargo targets shared and not, menger's data, scratch DBs, a
# session's scratch, symlinks out, a file held open. Every shape removed, every
# refusal refused, and the dry run removes nothing. The root lives under
# /tmp/claude-UID/run21/ and is removed at the end by the script itself — the
# test holds no `rm -r`. `cargo test` runs it (tests/deploy_record.rs).
#
#   scripts/tests/cleanup-gate     exit 1 if any check failed
set -uo pipefail

SELF=$(readlink -f "$0"); HERE=$(dirname "$SELF")
CG=$(dirname "$HERE")/cleanup-gate.sh
PARENT=/tmp/claude-$(id -u)/run21
mkdir -p "$PARENT"
T=$(mktemp -d "$PARENT/t.XXXXXX")
cd / || exit 1
pass=0 fail=0
ok()  { pass=$((pass + 1)); }
bad() { fail=$((fail + 1)); printf 'FAIL %s\n' "$*" >&2; }
has() { [[ $2 == *"$3"* ]] && ok || bad "$1: wanted '$3' in: $2"; }
hasnt() { [[ $2 != *"$3"* ]] && ok || bad "$1: did not want '$3' in: $2"; }
there() { [[ -e $2 || -L $2 ]] && ok || bad "$1: $2 is gone"; }
gone()  { [[ ! -e $2 && ! -L $2 ]] && ok || bad "$1: $2 is still there"; }
# cg NAME CODE ARGS… — the script on the throwaway root exits CODE; its output in $out
cg() { local name=$1 want=$2; shift 2
  out=$(CLEANUP_GATE_ROOT=$T "$CG" "$@" 2>&1); local got=$?
  [[ $got == "$want" ]] && ok || bad "$name: exit $got, wanted $want — $out"; }

export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@t \
  GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@t
unset CLEANUP_GATE_LOG CLEANUP_GATE_IDLE_HOURS MENGER_SCRATCH_DIRS
# CI-2: the disk's use is said, never measured, and cargo is a stand-in that
# answers `metadata` from a map (manifest<TAB>build_directory) — no real cargo runs
export CLEANUP_GATE_USED_PCT=30 CLEANUP_GATE_CARGO=$T/bin/cargo STUB_CARGO_MAP=$T/cargo-map
mkdir -p "$T/bin"; : >"$STUB_CARGO_MAP"
cat >"$T/bin/cargo" <<'STUB'
#!/usr/bin/env bash
m=${*: -1}
while IFS=$'\t' read -r k v; do [[ $k == "$m" ]] && { printf '{"build_directory":"%s"}\n' "$v"; exit 0; }; done <"$STUB_CARGO_MAP"
exit 101
STUB
chmod +x "$T/bin/cargo"

# ── the throwaway machine ───────────────────────────────────────────────────
H=$T/home WS=$T/home/dev/controlflow/hypermemetic CT=$T/home/.cache/cargo-target
TM=$T/tmp SCR=$T/tmp/claude-$(id -u) LOG=$T/home/.local/state/menger/cleanup-gate.log
mkdir -p "$WS/plexus-core" "$CT"/{menger,plexus-core,gate-a,gate-b}/debug "$H/.local/share/menger" \
  "$SCR"/{sess1,sess2,sess3} "$TM/theme-sweep" "$WS/.logs-only" "$WS/.has-git/sub/.git" \
  "$WS/.menger-publish" "$T/elsewhere"
M=$WS/menger
git init -q -b main "$M"; echo a >"$M/f"; printf 'target/\n' >"$M/.gitignore"
git -C "$M" add f .gitignore; git -C "$M" commit -qm one
git -C "$M" worktree add -q -b gate-a "$WS/.gate-a"                 # merged: its branch goes
git -C "$M" worktree add -q -b gate-b "$WS/.gate-b"                 # unmerged: its branch stays
echo b >"$WS/.gate-b/f"; git -C "$WS/.gate-b" commit -qam two
git -C "$M" worktree add -q -b gate-dirty "$WS/.gate-dirty"; echo x >"$WS/.gate-dirty/untracked"
git -C "$M" worktree add -q -b agent-x "$M/.claude/worktrees/agent-x"
git -C "$M" worktree add -q --detach "$T/elsewhere/wt"              # a worktree outside the workspace
mkdir -p "$WS/.gate-a/target/debug"; echo build >"$WS/.gate-a/target/debug/x"   # ignored: no refusal
for f in fe.log mg.log; do echo log >"$WS/.logs-only/$f"; done
echo 1 >"$CT/gate-a/debug/obj"; echo log >"$CT/a12-gate.log"; echo 1 >"$CT/menger/debug/obj"
echo db >"$H/.local/share/menger/tickets.db"
for s in .db .db-shm .db-wal .sessions.jsonl .sessions.jsonl.lock .log; do echo x >"$TM/menger-gate-a$s"; done
echo x >"$TM/menger-look4-sweep.db"; echo x >"$TM/other.db"
echo s >"$SCR/sess1/shot.png"; echo s >"$SCR/sess2/held"; echo s >"$SCR/sess3/f"; echo s >"$TM/theme-sweep/a.png"
ln -s "$M" "$SCR/to-main"; ln -s "$H" "$SCR/to-home"; ln -s "$T/elsewhere" "$SCR/to-elsewhere"
ln -s "$CT/gate-b" "$SCR/to-target"

# ── the root is a throwaway, or nothing runs ───────────────────────────────
out=$(CLEANUP_GATE_ROOT=/tmp "$CG" gate-a 2>&1); [[ $? == 1 ]] && ok || bad "a root of /tmp is refused"
has "a root of /tmp" "$out" "two levels below /tmp"
out=$(CLEANUP_GATE_ROOT=$H "$CG" gate-a 2>&1); [[ $? == 0 ]] && ok || bad "a deep root is taken: $out"
cg "no arguments" 1
cg "an unknown flag" 1 --force gate-a
cg "--list --yes" 1 --list --yes
has "--list --yes" "$out" "never removes"

# ── the dry run is the default and removes nothing ─────────────────────────
cg "dry run gate-a" 0 gate-a
has "dry run: the worktree" "$out" "would remove  worktree   $WS/.gate-a"
has "dry run: its branch" "$out" "branch gate-a (merged)"
has "dry run: the target" "$out" "target     $CT/gate-a"
has "dry run: the db" "$out" "scratch-db $TM/menger-gate-a.db-wal"
has "dry run: the log" "$out" "$TM/menger-gate-a.log"
has "dry run: the space" "$out" "would free"
for p in "$WS/.gate-a" "$CT/gate-a" "$TM/menger-gate-a.db" "$TM/menger-gate-a.log"; do there "dry run keeps" "$p"; done
git -C "$M" rev-parse -q --verify gate-a >/dev/null && ok || bad "dry run kept branch gate-a"
[[ ! -e $LOG ]] && ok || bad "a dry run writes no log"
cg "--dry-run after --yes wins" 0 --yes --dry-run gate-a; there "--dry-run wins" "$WS/.gate-a"

# ── --list sees every candidate and judges each ────────────────────────────
cg "--list" 2 --list
for p in "$WS/.gate-a" "$WS/.gate-b" "$M/.claude/worktrees/agent-x" "$WS/.logs-only" "$CT/gate-a" "$CT/a12-gate.log" \
         "$TM/menger-look4-sweep.db" "$SCR/sess1" "$TM/theme-sweep"; do has "--list: $p" "$out" "would remove"; has "--list: $p" "$out" "$p"; done
has "--list: the shared target refused" "$out" "refused  $CT/menger — a shared cargo target"
has "--list: the publish stage refused" "$out" ".menger-publish — scripts/publish.sh's stage"
has "--list: the dirty worktree refused" "$out" ".gate-dirty — a worktree with uncommitted"
has "--list: the outside worktree refused" "$out" "a git worktree outside"
there "--list removes nothing" "$WS/.gate-a"; there "--list removes nothing" "$SCR/sess1"

# ── --yes removes, logs, and frees ─────────────────────────────────────────
cg "remove gate-a" 0 --yes gate-a
has "removed: the worktree" "$out" "removed  worktree   $WS/.gate-a"
has "removed: the branch" "$out" "branch gate-a deleted"
has "removed: freed" "$out" "freed"
for p in "$WS/.gate-a" "$CT/gate-a" "$TM/menger-gate-a.db" "$TM/menger-gate-a.db-shm" "$TM/menger-gate-a.db-wal" "$TM/menger-gate-a.sessions.jsonl" "$TM/menger-gate-a.sessions.jsonl.lock" "$TM/menger-gate-a.log"; do gone "gate-a" "$p"; done
git -C "$M" rev-parse -q --verify gate-a >/dev/null && bad "branch gate-a still there" || ok
[[ -z $(git -C "$M" worktree list --porcelain | grep "gate-a") ]] && ok || bad "git still knows .gate-a"
has "the log" "$(<"$LOG")" "removed worktree $WS/.gate-a"
has "the log" "$(<"$LOG")" "removed target $CT/gate-a"
there "the main checkout stays" "$M/f"
cg "gate-a again: nothing" 0 --yes gate-a; has "nothing left" "$out" "nothing  left by gate-a"

cg "gate-b: unmerged" 0 --yes gate-b
has "gate-b: the branch kept" "$out" "branch gate-b kept"
gone "gate-b" "$WS/.gate-b"; gone "gate-b" "$CT/gate-b"
git -C "$M" rev-parse -q --verify gate-b >/dev/null && ok || bad "unmerged branch gate-b was deleted"

cg "an agent's worktree by name" 0 --yes agent-x; gone "agent-x" "$M/.claude/worktrees/agent-x"
cg "gate scratch by path" 0 --yes --path "$WS/.logs-only"; gone "ws-scratch" "$WS/.logs-only"
cg "a cargo-target log by path" 0 --yes --path "$CT/a12-gate.log"; gone "target file" "$CT/a12-gate.log"
cg "a scratch db by path" 0 --yes --path "$TM/menger-look4-sweep.db"; gone "scratch-db" "$TM/menger-look4-sweep.db"
cg "a session's scratch" 0 --yes --path "$SCR/sess1"; gone "session" "$SCR/sess1"
cg "theme-sweep" 0 --yes --path "$TM/theme-sweep"; gone "sweep" "$TM/theme-sweep"
cg "a symlink to a target: the target goes" 0 --yes --path "$SCR/to-target"
has "symlink shown resolved" "$out" "$SCR/to-target → "
cg "a relative path" 0 --path "tmp/claude-$(id -u)/sess3"  # PWD is /: names the real /tmp/…, not the root's
has "a relative path is absolute from PWD" "$out" "/tmp/claude-$(id -u)/sess3"

# ── refusals: each said, nothing touched, exit 2 ───────────────────────────
refused() { local name=$1 why=$2; shift 2; cg "$name" 2 --yes "$@"; has "$name" "$out" "refused"; has "$name" "$out" "$why"; }
refused "/" "a root" --path /
refused "\$HOME" "a root" --path "$H"
refused "the workspace" "a root" --path "$WS"
refused "the target root" "a root" --path "$CT"
refused "the session root" "a root" --path "$SCR"
refused "/tmp itself" "a root" --path "$TM"
refused "menger's data" "menger's data" --path "$H/.local/share/menger"
refused "menger's db" "menger's data" --path "$H/.local/share/menger/tickets.db"
refused "a main checkout" "main checkout" --path "$M"
refused "a main checkout by name" "main checkout" menger
has "by name, the shared target too" "$out" "$CT/menger — a shared cargo target"
refused "a repo-named target" "shared cargo target" --path "$CT/plexus-core"
refused "a dirty worktree" "uncommitted or untracked" --path "$WS/.gate-dirty"
refused "a worktree outside the workspace" "outside" --path "$T/elsewhere/wt"
refused "scratch holding a checkout" "holds a git checkout" --path "$WS/.has-git"
refused "the publish stage" "publish.sh" --path "$WS/.menger-publish"
refused "a db of no known shape" "not a leftover shape" --path "$TM/other.db"
refused "a source dir" "not a leftover shape" --path "$WS/plexus-core"
refused "named with .." "named with .." --path "$CT/../cargo-target/menger"
refused "a name with .." "not a gate name" ../x
refused "a symlink to the main checkout" "main checkout" --path "$SCR/to-main"
refused "a symlink to \$HOME" "a root" --path "$SCR/to-home"
refused "a symlink out of every root" "not a leftover shape" --path "$SCR/to-elsewhere"
for p in "$M/f" "$H/.local/share/menger/tickets.db" "$CT/menger/debug/obj" "$CT/plexus-core" "$WS/.gate-dirty/untracked" \
         "$T/elsewhere/wt" "$WS/.has-git/sub" "$WS/.menger-publish" "$TM/other.db" "$WS/plexus-core" "$SCR/to-main"; do
  there "refusals touch nothing" "$p"; done
has "refusals are logged under --yes" "$(<"$LOG")" "refused $M"

# in use: a file held open, a directory something works in, the caller's own directory
# shellcheck disable=SC2217  # the point: sleep holds the file open
sleep 60 <"$SCR/sess2/held" & held=$!
(cd "$WS/.gate-dirty" && exec sleep 60) & inside=$!
sleep 0.3
refused "a file held open" "in use by pid $held" --path "$SCR/sess2"
there "held" "$SCR/sess2/held"
git -C "$WS/.gate-dirty" clean -qf
refused "a worktree something works in" "in use by pid $inside" --path "$WS/.gate-dirty"
kill "$held" "$inside" 2>/dev/null; wait "$held" "$inside" 2>/dev/null
cg "let go, it goes" 0 --yes --path "$SCR/sess2"; gone "let go" "$SCR/sess2"
out=$(cd "$SCR/sess3" && CLEANUP_GATE_ROOT=$T "$CG" --yes --path "$SCR/sess3" 2>&1); [[ $? == 2 ]] && ok || bad "inside: $out"
has "the caller's own directory" "$out" "you are inside it"; there "inside" "$SCR/sess3/f"
hasnt "no hand-written rm -r in this test" "$(grep -v '^#' "$SELF" | grep -v hasnt)" "rm -r"

# ── CI-2: build-dirs, and the sweep ────────────────────────────────────────
CB=$H/.cache/cargo-build
aged() { local when=$1; shift; find "$@" -depth -exec touch -h -d "$when" {} +; }   # PATH… modified WHEN, all through
bd() { mkdir -p "$CB/$1/debug/deps" && echo o >"$CB/$1/debug/deps/x.rlib" && : >"$CB/$1/debug/.cargo-build-lock"; }
bd ab/1111111111111111; bd cd/2222222222222222; bd ce/3333333333333333; bd cf/4444444444444444; bd d0/5555555555555555
bd ef/6666666666666666; bd f0/7777777777777777
mkdir -p "$CB/zz/not-a-hash" "$CT/menger/debug/incremental/m-1" "$CT/menger/debug/deps" \
  "$CT/menger/wasm32-unknown-unknown/release/deps" "$CT/old-gate/debug" "$CT/new-gate/debug"
echo o >"$CT/menger/debug/deps/a.rlib"; echo o >"$CT/menger/debug/incremental/m-1/q"
echo o >"$CT/menger/wasm32-unknown-unknown/release/deps/b.rlib"; echo bin >"$CT/menger/debug/menger"
echo o >"$CT/old-gate/debug/x"; echo o >"$CT/new-gate/debug/x"
aged '8 hours ago' "$CB"/ab "$CB"/d0 "$CT/menger/debug/deps" "$CT/menger/debug/incremental" \
  "$CT/menger/wasm32-unknown-unknown/release/deps" "$CT/old-gate"
aged '2 hours ago' "$CB/ce"
aged '30 minutes ago' "$CB/cf"
# a worktree with two workspaces (its root and frontend/), each with its build-dir
git -C "$M" worktree add -q -b gate-c "$WS/.gate-c"
mkdir -p "$WS/.gate-c/frontend"; : >"$WS/.gate-c/Cargo.toml"; : >"$WS/.gate-c/frontend/Cargo.toml"
printf '%s\n' Cargo.toml >"$WS/.gate-c/.git-keep"; git -C "$WS/.gate-c" add -A; git -C "$WS/.gate-c" commit -qm c
git -C "$M" merge -q --ff-only gate-c
printf '%s\t%s\n' "$WS/.gate-c/Cargo.toml" "$CB/ef/6666666666666666" "$WS/.gate-c/frontend/Cargo.toml" "$CB/f0/7777777777777777" \
  >>"$STUB_CARGO_MAP"

cg "--sweep takes no names" 1 --sweep gate-a
cg "--idle-hours must be a number" 1 --sweep --idle-hours soon
cg "sweep, dry run" 0 --sweep
has "sweep: the use and threshold" "$out" "30% used — build output idle 6h goes"
has "sweep: an idle build-dir" "$out" "would remove  cargo-build $CB/ab/1111111111111111"
has "sweep: a fresh build-dir kept" "$out" "kept     cargo-build $CB/cd/2222222222222222 — modified within 6h"
has "sweep: 2 h idle is not 6" "$out" "kept     cargo-build $CB/ce/3333333333333333"
has "sweep: a shared target's stale deps" "$out" "would remove  target-part $CT/menger/debug/deps"
has "sweep: … its stale incremental" "$out" "target-part $CT/menger/debug/incremental"
has "sweep: … under a triple" "$out" "target-part $CT/menger/wasm32-unknown-unknown/release/deps"
hasnt "sweep: never a shared target's final artifacts" "$out" "$CT/menger/debug/menger"
hasnt "sweep: never a shared target whole" "$out" "  $CT/menger "
has "sweep: an idle non-shared target" "$out" "would remove  target     $CT/old-gate"
has "sweep: a fresh one kept" "$out" "kept     target      $CT/new-gate"
hasnt "sweep: no worktrees" "$out" "worktree"
hasnt "sweep: no sessions" "$out" "session"
hasnt "sweep: not a hash, not a candidate" "$out" "not-a-hash"
there "the dry sweep keeps" "$CB/ab/1111111111111111"; there "the dry sweep keeps" "$CT/old-gate"

sleep 60 <"$CB/d0/5555555555555555/debug/deps/x.rlib" & held=$!
sleep 0.3
cg "sweep" 0 --yes --sweep
has "sweep: held, kept" "$out" "kept     cargo-build $CB/d0/5555555555555555 — in use by pid $held"
has "sweep: freed" "$out" "freed"
gone "swept" "$CB/ab/1111111111111111"; gone "its hash's parent, empty, too" "$CB/ab"
gone "swept" "$CT/menger/debug/deps"; gone "swept" "$CT/menger/debug/incremental"; gone "swept" "$CT/old-gate"
gone "swept" "$CT/menger/wasm32-unknown-unknown/release/deps"
there "kept: the held one" "$CB/d0/5555555555555555"
there "kept: fresh" "$CB/cd/2222222222222222"; there "kept: 2 h" "$CB/ce/3333333333333333"; there "kept" "$CT/new-gate"
there "kept: the shared target's binary" "$CT/menger/debug/menger"; there "kept: the shared target" "$CT/menger/debug/obj"
there "kept: a worktree's fresh build-dir" "$CB/ef/6666666666666666"
has "sweep: logged" "$(<"$LOG")" "removed cargo-build $CB/ab/1111111111111111"
has "sweep: its summary logged" "$(<"$LOG")" "sweep 30% used, idle 6h: freed"
kill "$held" 2>/dev/null; wait "$held" 2>/dev/null

CLEANUP_GATE_USED_PCT=80 cg "sweep at 80%: idle 1 h" 0 --yes --sweep
has "80%: the threshold drops" "$out" "80% used — build output idle 1h goes"
gone "80%: 2 h idle goes" "$CB/ce/3333333333333333"; there "80%: 30 min stays" "$CB/cf/4444444444444444"
CLEANUP_GATE_USED_PCT=95 cg "sweep at 95%: idle 15 min" 0 --yes --sweep
has "95%: the threshold drops again" "$out" "95% used — build output idle 15m goes"
gone "95%: 30 min idle goes" "$CB/cf/4444444444444444"; there "95%: fresh stays" "$CB/cd/2222222222222222"
cg "--idle-hours 0 takes what is idle at all" 0 --sweep --idle-hours 0
has "--idle-hours 0" "$out" "idle 0m goes"

# a worktree takes its build-dirs with it
cg "gate-c, dry run" 0 gate-c
has "gate-c: its build-dir" "$out" "would remove  cargo-build $CB/ef/6666666666666666"
has "gate-c: its frontend's" "$out" "cargo-build $CB/f0/7777777777777777"
cg "gate-c" 0 --yes gate-c
gone "gate-c" "$WS/.gate-c"; gone "gate-c's build-dir" "$CB/ef/6666666666666666"; gone "gate-c's frontend's" "$CB/f0/7777777777777777"
has "gate-c: logged" "$(<"$LOG")" "removed cargo-build $CB/ef/6666666666666666"
cg "a build-dir by path" 0 --yes --path "$CB/cd/2222222222222222"; gone "by path" "$CB/cd/2222222222222222"
cg "a shared target's part by path" 0 --yes --path "$CT/menger/debug/build" ; has "absent is fine" "$out" "absent"
refused "the build-dir root" "a root" --path "$CB"
refused "a hash's parent" "not a leftover shape" --path "$CB/zz"
refused "not a hash" "not a leftover shape" --path "$CB/zz/not-a-hash"
refused "a shared target's final artifact" "not a leftover shape" --path "$CT/menger/debug/menger"

# ── CI-6: pipeline logs — green ones past 60 days go, a red run's stay ─────
PL=$H/.local/state/menger-deploy/logs; mkdir -p "$PL"
for n in 20260101T010101Z-aaaaaaa-gate-workspace.log 20260101T010101Z-aaaaaaa-gate-frontend.log \
         20260102T010101Z-bbbbbbb-gate-workspace.log 20260102T010101Z-bbbbbbb-build-release.log 20261019T010101Z-ccccccc-gate-workspace.log; do echo l >"$PL/$n"; done
: >"$PL/20260102T010101Z.red"
aged '90 days ago' "$PL"/20260101T010101Z-* "$PL"/20260102T010101Z-* "$PL/20260102T010101Z.red"
aged '3 days ago' "$PL"/20261019T010101Z-*
cg "sweep: logs, dry run" 0 --sweep
has "logs: a green log past 60 days" "$out" "would remove  pipeline-log $PL/20260101T010101Z-aaaaaaa-gate-workspace.log"
has "logs: its sibling" "$out" "pipeline-log $PL/20260101T010101Z-aaaaaaa-gate-frontend.log"
hasnt "logs: a red run's gate log" "$out" "20260102T010101Z-bbbbbbb-gate-workspace.log"
hasnt "logs: a red run's build log" "$out" "20260102T010101Z-bbbbbbb-build-release.log"
hasnt "logs: a recent one" "$out" "20261019T010101Z"
cg "sweep: logs" 0 --yes --sweep
gone "logs: green, old" "$PL/20260101T010101Z-aaaaaaa-gate-workspace.log"; gone "logs: green, old (2)" "$PL/20260101T010101Z-aaaaaaa-gate-frontend.log"
there "logs: red kept" "$PL/20260102T010101Z-bbbbbbb-gate-workspace.log"; there "logs: red kept (2)" "$PL/20260102T010101Z-bbbbbbb-build-release.log"
there "logs: recent kept" "$PL/20261019T010101Z-ccccccc-gate-workspace.log"; there "logs: the red mark kept" "$PL/20260102T010101Z.red"
refused "a red run's log by path" "a red run's log" --path "$PL/20260102T010101Z-bbbbbbb-gate-workspace.log"
cg "--log-days 1 takes the recent green one" 0 --yes --sweep --log-days 1
gone "logs: --log-days 1" "$PL/20261019T010101Z-ccccccc-gate-workspace.log"; there "logs: still the red" "$PL/20260102T010101Z-bbbbbbb-build-release.log"

# ── RUN-34: the throwaway's ui8-* work directories under a scratch root ────
# scripts/ui-throwaway.mjs's workDir() makes ui8-pages-* / ui8-probe-* (and
# any ui8-<prefix>-*) under $TMPDIR; builders set it to ~/.cache/menger-perf-
# scratch. Such a directory, holding the throwaway's marks (tickets.db, ui.db,
# admin.key — the server's database, the ui service's, the admin's key), is
# shape ui8-work under a scratch root — a directory named menger-perf-scratch
# in ~/.cache, or one MENGER_SCRATCH_DIRS names — when nothing holds it and
# nothing in it changed for an hour. Nothing else in a scratch root is a shape.
PS=$H/.cache/menger-perf-scratch OS=$T/other-scratch UK=$T/unknown-scratch
mkdir -p "$PS" "$OS" "$UK"
ui8() { local d=$1; shift   # DIR [MARK…]: a fake work directory with these marks (default: all of them)
  mkdir -p "$d/engine"; echo e >"$d/engine/engine.wasm"
  local m; for m in "${@:-tickets.db tickets.db-wal ui.db admin.key signer.key session}"; do for m in $m; do echo x >"$d/$m"; done; done; }
echo x >"$PS/menger-perf.db"; echo x >"$PS/f17-build.log"; mkdir -p "$PS/f17"; echo x >"$PS/f17/a"
aged '3 hours ago' "$PS/menger-perf.db" "$PS/f17-build.log" "$PS/f17"

# a_ui8_dir_under_a_scratch_root_is_a_leftover
ui8 "$PS/ui8-pages-x"; aged '2 hours ago' "$PS/ui8-pages-x"
cg "ui8: a dry run by path" 0 --path "$PS/ui8-pages-x"
has "ui8: the shape" "$out" "would remove  ui8-work"; has "ui8: its path" "$out" "$PS/ui8-pages-x"
there "ui8: a dry run keeps it" "$PS/ui8-pages-x"
cg "ui8: removed by path" 0 --yes --path "$PS/ui8-pages-x"
has "ui8: removed" "$out" "removed  ui8-work"; gone "ui8: removed by path" "$PS/ui8-pages-x"
has "ui8: logged" "$(<"$LOG")" "removed ui8-work $PS/ui8-pages-x"
there "ui8: the scratch root stays" "$PS"; there "ui8: its other files stay" "$PS/menger-perf.db"
ui8 "$PS/ui8-probe-x"; aged '2 hours ago' "$PS/ui8-probe-x"
cg "ui8: a probe's by path" 0 --yes --path "$PS/ui8-probe-x"; gone "ui8: a probe's" "$PS/ui8-probe-x"
ui8 "$PS/ui8-f20p0-x"; aged '2 hours ago' "$PS/ui8-f20p0-x"   # a builder's own prefix: still ui8-*
cg "ui8: any ui8- prefix by path" 0 --yes --path "$PS/ui8-f20p0-x"; gone "ui8: any ui8- prefix" "$PS/ui8-f20p0-x"
ui8 "$PS/ui8-pages-early" admin.key signer.key; aged '2 hours ago' "$PS/ui8-pages-early"  # the run died before the server started?
refused "ui8: keys alone are not the marks" "without the throwaway's marks" --path "$PS/ui8-pages-early"
refused "ui8: the scratch root itself" "a root" --path "$PS"
refused "ui8: a scratch root's other files" "not a leftover shape" --path "$PS/menger-perf.db"
refused "ui8: a scratch root's other dirs" "not a leftover shape" --path "$PS/f17"
there "ui8: refusals touch nothing" "$PS/f17/a"; there "ui8: refusals touch nothing" "$PS/ui8-pages-early/admin.key"

# a_ui8_dir_in_use_is_refused
ui8 "$PS/ui8-pages-held"; ui8 "$PS/ui8-pages-cwd"; aged '2 hours ago' "$PS/ui8-pages-held" "$PS/ui8-pages-cwd"
# shellcheck disable=SC2217  # the point: sleep holds the database open, as the server does
sleep 60 <"$PS/ui8-pages-held/tickets.db" & held=$!
(cd "$PS/ui8-pages-cwd" && exec sleep 60) & inside=$!
sleep 0.3
refused "ui8: its database held open" "in use by pid $held" --path "$PS/ui8-pages-held"
refused "ui8: something works in it" "in use by pid $inside" --path "$PS/ui8-pages-cwd"
cg "ui8: the sweep keeps what is held" 0 --yes --sweep
has "ui8: the sweep keeps it, held" "$out" "kept     ui8-work"; has "ui8: … and says by whom" "$out" "$PS/ui8-pages-held — in use by pid $held"
there "ui8: held, there" "$PS/ui8-pages-held/tickets.db"; there "ui8: worked in, there" "$PS/ui8-pages-cwd"
kill "$held" "$inside" 2>/dev/null; wait "$held" "$inside" 2>/dev/null
cg "ui8: let go, it goes" 0 --yes --path "$PS/ui8-pages-held" "$PS/ui8-pages-cwd"
gone "ui8: let go" "$PS/ui8-pages-held"; gone "ui8: let go (cwd)" "$PS/ui8-pages-cwd"

# a_ui8_dir_under_an_unknown_root_is_refused
ui8 "$UK/ui8-pages-x"; ui8 "$H/.cache/ui8-pages-x"; ui8 "$PS/sub/ui8-pages-x"
aged '2 hours ago' "$UK/ui8-pages-x" "$H/.cache/ui8-pages-x" "$PS/sub"
refused "ui8: under an unknown root" "not a leftover shape" --path "$UK/ui8-pages-x"
refused "ui8: under ~/.cache itself" "not a leftover shape" --path "$H/.cache/ui8-pages-x"
refused "ui8: two levels below a scratch root" "not a leftover shape" --path "$PS/sub/ui8-pages-x"
MENGER_SCRATCH_DIRS=$OS refused "ui8: a root the env names, but not this one" "not a leftover shape" --path "$UK/ui8-pages-x"
there "ui8: unknown, there" "$UK/ui8-pages-x/tickets.db"; there "ui8: ~/.cache, there" "$H/.cache/ui8-pages-x"
there "ui8: deeper, there" "$PS/sub/ui8-pages-x"

# a_ui8_dir_younger_than_an_hour_is_left
ui8 "$PS/ui8-pages-young"; aged '20 minutes ago' "$PS/ui8-pages-young"
refused "ui8: younger than an hour, by path" "modified within 1h" --path "$PS/ui8-pages-young"
cg "ui8: younger than an hour, the sweep" 0 --yes --sweep
has "ui8: the sweep keeps the young one" "$out" "kept     ui8-work"; has "ui8: … and says why" "$out" "$PS/ui8-pages-young — modified within 1h"
there "ui8: young, there" "$PS/ui8-pages-young/tickets.db"
ui8 "$PS/ui8-pages-touched"; aged '2 hours ago' "$PS/ui8-pages-touched"; echo w >>"$PS/ui8-pages-touched/tickets.db-wal"
refused "ui8: one file written within the hour" "modified within 1h" --path "$PS/ui8-pages-touched"
there "ui8: touched, there" "$PS/ui8-pages-touched"

# the_sweep_lists_and_takes_scratch_roots
ui8 "$PS/ui8-probe-a"; ui8 "$PS/ui8-pages-b"; ui8 "$OS/ui8-probe-c"
aged '2 hours ago' "$PS/ui8-probe-a" "$PS/ui8-pages-b" "$OS/ui8-probe-c" "$PS/ui8-pages-touched"
MENGER_SCRATCH_DIRS="$OS:$UK/absent" cg "ui8: --list" 2 --list
for p in "$PS/ui8-probe-a" "$PS/ui8-pages-b" "$OS/ui8-probe-c" "$PS/ui8-pages-touched"; do has "ui8: --list names $p" "$out" "ui8-work   $p"; done
has "ui8: --list judges the young one" "$out" "$PS/ui8-pages-young"
hasnt "ui8: --list, never the unknown root" "$out" "$UK/ui8-pages-x"
hasnt "ui8: --list, never a scratch root's other files" "$out" "$PS/menger-perf.db"
there "ui8: --list removes nothing" "$PS/ui8-probe-a"
MENGER_SCRATCH_DIRS="$OS:$UK/absent" cg "ui8: the sweep, dry run" 0 --sweep
has "ui8: the dry sweep" "$out" "would remove  ui8-work"; has "ui8: … names the scratch root's" "$out" "$PS/ui8-probe-a"
has "ui8: … and the env's" "$out" "$OS/ui8-probe-c"
there "ui8: the dry sweep keeps" "$PS/ui8-probe-a"
MENGER_SCRATCH_DIRS="$OS:$UK/absent" cg "ui8: the sweep" 0 --yes --sweep
for p in "$PS/ui8-probe-a" "$PS/ui8-pages-b" "$OS/ui8-probe-c" "$PS/ui8-pages-touched"; do gone "ui8: swept" "$p"; done
has "ui8: the sweep logged" "$(<"$LOG")" "removed ui8-work $PS/ui8-probe-a"
has "ui8: … the env's root's too" "$(<"$LOG")" "removed ui8-work $OS/ui8-probe-c"
there "ui8: the sweep keeps the young" "$PS/ui8-pages-young"; there "ui8: … the keys-only" "$PS/ui8-pages-early"
there "ui8: … the unknown root's" "$UK/ui8-pages-x"; there "ui8: … ~/.cache's" "$H/.cache/ui8-pages-x"
there "ui8: … the root's own files" "$PS/menger-perf.db"; there "ui8: … and dirs" "$PS/f17/a"; there "ui8: … the root" "$PS"
MENGER_SCRATCH_DIRS="$OS:$H" cg "ui8: \$HOME named a scratch root refuses the run" 1 --yes --path "$PS/ui8-pages-young"
has "ui8: … and says which" "$out" "MENGER_SCRATCH_DIRS names $H — a root"; there "ui8: … touching nothing" "$PS/ui8-pages-young"
MENGER_SCRATCH_DIRS=relative/dir cg "ui8: a relative scratch root refuses the run" 1 --list; has "ui8: relative said" "$out" "not an absolute path"
has "ui8: install.sh says the timer runs its installed copy, and which" "$(<"$(dirname "$HERE")/sweep/install.sh")" "the timer runs this installed copy"
has "ui8: the timer reads its own env file" "$(<"$(dirname "$HERE")/sweep/menger-sweep.service")" "EnvironmentFile=-%h/.config/menger/sweep.env"

# a_dir_named_ui8_without_the_marks_is_refused
mkdir -p "$PS/ui8-pages-bare" "$PS/ui8-notes"; echo x >"$PS/ui8-pages-bare/notes.md"; echo x >"$PS/ui8-notes/tickets.db"
aged '2 hours ago' "$PS/ui8-pages-bare" "$PS/ui8-notes"
refused "ui8: no marks" "without the throwaway's marks" --path "$PS/ui8-pages-bare"
refused "ui8: a database alone is not the marks" "without the throwaway's marks" --path "$PS/ui8-notes"
echo x >"$PS/ui8-file"; aged '2 hours ago' "$PS/ui8-file"
refused "ui8: a file named ui8 is no work directory" "not a leftover shape" --path "$PS/ui8-file"
ln -s "$T/elsewhere" "$PS/ui8-pages-link"
refused "ui8: a symlink named ui8 out of the root" "not a leftover shape" --path "$PS/ui8-pages-link"
cg "ui8: the sweep leaves the unmarked" 0 --yes --sweep
there "ui8: unmarked, there" "$PS/ui8-pages-bare/notes.md"; there "ui8: a db alone, there" "$PS/ui8-notes/tickets.db"
there "ui8: the file, there" "$PS/ui8-file"; there "ui8: the link's target, there" "$T/elsewhere/wt"

# the review's cases (RUN-34): a scratch root's own rules, and what the sweep may never take
bad_env() { local name=$1 why=$2 val=$3
  MENGER_SCRATCH_DIRS=$val cg "ui8: $name refuses --list" 1 --list; has "ui8: $name said" "$out" "$why"
  MENGER_SCRATCH_DIRS=$val cg "ui8: $name refuses --path" 1 --path "$PS/ui8-pages-young"; there "ui8: $name, nothing touched" "$PS/ui8-pages-young"
}
bad_env "\$HOME" "a root, never a scratch root" "$H"
bad_env "/" "a root, never a scratch root" "/"
bad_env "a .. entry" "named with . or .." "$OS/../other-scratch"
bad_env "a newline" "a newline in it" "$OS"$'\n'"$UK"
bad_env "~/.cache" "a root, never a scratch root" "$H/.cache"
bad_env "an ancestor of \$HOME" "a root, never a scratch root" "$T"
bad_env "a dir in the workspace" "in the workspace" "$WS/.scratchy"
bad_env "a dir outside the test root" "outside the test root" "/var/tmp"
# under --sweep a bad entry is said and skipped: the rest is swept
bd fa/8888888888888888; aged '8 hours ago' "$CB/fa"
ui8 "$OS/ui8-probe-d"; aged '2 hours ago' "$OS/ui8-probe-d"
MENGER_SCRATCH_DIRS="$H:$OS:/bad"$'\n'"/x" cg "ui8: a bad env under --sweep still sweeps" 0 --yes --sweep
has "ui8: … says the bad one" "$out" "MENGER_SCRATCH_DIRS names $H — a root"
gone "ui8: … still takes cargo-build" "$CB/fa/8888888888888888"
has "ui8: … the newline entry said, not split" "$out" "a newline in it"; gone "ui8: … and a good root's" "$OS/ui8-probe-d"

# a scratch root with a space in its path
SP="$T/with space"; ui8 "$SP/ui8-probe-s"; ui8 "$SP/ui8-probe-t"; aged '2 hours ago' "$SP/ui8-probe-s" "$SP/ui8-probe-t"
MENGER_SCRATCH_DIRS=$SP cg "ui8: a space, by path" 0 --yes --path "$SP/ui8-probe-s"; gone "ui8: a space, by path" "$SP/ui8-probe-s"
MENGER_SCRATCH_DIRS=$SP cg "ui8: a space, the sweep" 0 --yes --sweep; gone "ui8: a space, the sweep" "$SP/ui8-probe-t"

# a future mtime is young
ui8 "$PS/ui8-pages-future"; aged '2 hours' "$PS/ui8-pages-future"
refused "ui8: a future mtime, by path" "modified within 1h" --path "$PS/ui8-pages-future"
cg "ui8: a future mtime, the sweep" 0 --yes --sweep; has "ui8: … kept" "$out" "$PS/ui8-pages-future — modified within 1h"
there "ui8: future, there" "$PS/ui8-pages-future/tickets.db"

# a newline in a name: never two paths (one of them $PWD/.victim, a worktree)
git -C "$M" worktree add -q -b victim "$WS/.victim"
NL=$PS/$'ui8-a\n.victim'; ui8 "$NL"; aged '2 hours ago' "$NL" "$WS/.victim"
out=$(cd "$WS" && CLEANUP_GATE_ROOT=$T "$CG" --sweep 2>&1); [[ $? == 0 ]] && ok || bad "ui8: a newline, dry sweep from the workspace: $out"
hasnt "ui8: a newline: no worktree in a sweep" "$out" "worktree"; hasnt "ui8: … no victim" "$out" ".victim"
out=$(cd "$WS" && CLEANUP_GATE_ROOT=$T "$CG" --yes --sweep 2>&1); [[ $? == 0 ]] && ok || bad "ui8: a newline, sweep from the workspace: $out"
there "ui8: the victim worktree stays" "$WS/.victim/f"; there "ui8: the newline dir stays" "$NL/tickets.db"
out=$(cd "$WS" && CLEANUP_GATE_ROOT=$T "$CG" --list 2>&1)
hasnt "ui8: --list does not name the newline dir as ui8-work" "$out" "ui8-work   $PS/ui8-a"
refused "ui8: a newline name by path" "named with a newline" --path "$NL"; there "ui8: … there" "$NL/tickets.db"
out=$(cd "$WS" && CLEANUP_GATE_ROOT=$T "$CG" --yes --path "$NL" 2>&1); [[ $? == 2 ]] && ok || bad "ui8: a newline path from the workspace: $out"
hasnt "ui8: … never the worktree it would split into" "$out" "worktree"; there "ui8: … the victim stays" "$WS/.victim/f"

# ui8-* links: to $HOME, to a checkout, to a marked dir elsewhere
mkdir -p "$T/linked-marked"; ui8 "$T/linked-marked"; aged '2 hours ago' "$T/linked-marked"
ln -s "$H" "$PS/ui8-pages-tohome"; ln -s "$M" "$PS/ui8-pages-tomain"; ln -s "$T/linked-marked" "$PS/ui8-pages-tomarked"
refused "ui8: a link to \$HOME" "a root" --path "$PS/ui8-pages-tohome"
refused "ui8: a link to a checkout" "main checkout" --path "$PS/ui8-pages-tomain"
refused "ui8: a link to a marked dir elsewhere" "not a leftover shape" --path "$PS/ui8-pages-tomarked"
cg "ui8: the sweep and the links" 0 --yes --sweep
hasnt "ui8: the sweep never follows a ui8 link" "$out" "ui8-pages-to"
there "ui8: \$HOME there" "$H/.local/share/menger/tickets.db"; there "ui8: the checkout there" "$M/f"; there "ui8: the marked dir there" "$T/linked-marked/tickets.db"

# the sweep refuses any shape but build output, pipeline logs and ui8-work
git -C "$M" worktree add -q -b gate-y "$WS/.gate-y"; ln -s "$WS/.gate-y" "$CT/link-to-wt"
cg "ui8: the sweep meets a worktree" 2 --yes --sweep
has "ui8: … refuses it" "$out" "refused  $CT/link-to-wt → $WS/.gate-y — a worktree, and the sweep takes only"
there "ui8: … the worktree stays" "$WS/.gate-y/f"
rm -f -- "$CT/link-to-wt"   # the fixture link alone, never what it points at

# the default scratch root as a symlink to $HOME: dropped, and said
T2=$(mktemp -d "$PARENT/t2.XXXXXX"); mkdir -p "$T2/home/.cache" "$T2/tmp"; ln -s "$T2/home" "$T2/home/.cache/menger-perf-scratch"
ui8 "$T2/home/ui8-x"; aged '2 hours ago' "$T2/home/ui8-x"
out=$(CLEANUP_GATE_ROOT=$T2 "$CG" --yes --sweep 2>&1); [[ $? == 0 ]] && ok || bad "ui8: the default root a link: $out"
has "ui8: the default root a link to \$HOME: said" "$out" "menger-perf-scratch → $T2/home — a root, never a scratch root; not a scratch root"
there "ui8: … \$HOME/ui8-x stays" "$T2/home/ui8-x/tickets.db"
out=$(CLEANUP_GATE_ROOT=$T2 "$CG" --yes --path "$T2/home/ui8-x" 2>&1); [[ $? == 2 ]] && ok || bad "ui8: … by path: $out"
has "ui8: … by path, no shape" "$out" "not a leftover shape"
CLEANUP_GATE_LOG=/dev/null "$CG" --yes --path "$T2" >/dev/null || bad "ui8: the second test root $T2 was not removed"

# a ui8 dir that is a mount point is never emptied (an unprivileged mount namespace, where there is one)
mkdir -p "$PS/ui8-pages-mnt"
if unshare -rm true 2>/dev/null; then
  # shellcheck disable=SC2016  # expanded inside the namespace
  out=$(unshare -rm bash -c 'mount -t tmpfs t "$1" && for m in tickets.db ui.db admin.key; do echo x >"$1/$m"; done && touch -d "2 hours ago" "$1"/* "$1" &&
    CLEANUP_GATE_ROOT="$2" "$3" --yes --path "$1"; echo "rc=$?"; [ -e "$1/tickets.db" ] && echo still-there' _ "$PS/ui8-pages-mnt" "$T" "$CG" 2>&1)
  has "ui8: a mount point refused" "$out" "a mount point, never removed"; has "ui8: … exit 2" "$out" "rc=2"
  has "ui8: … its files kept" "$out" "still-there"
else echo "cleanup-gate: no unprivileged mount namespace here; the mount-point case is not run" >&2; fi

# ── done: the root goes through the script itself (a session's scratch) ───
printf 'cleanup-gate: %d passed, %d failed\n' "$pass" "$fail"
CLEANUP_GATE_LOG=/dev/null "$CG" --yes --path "$T" >/dev/null || printf 'cleanup-gate: the test root %s was not removed\n' "$T" >&2
[[ $fail == 0 ]]
