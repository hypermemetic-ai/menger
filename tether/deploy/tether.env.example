# TETHER-9: ~/.config/menger/tether.env — menger tether's settings (the unit
# reads it; `systemctl --user restart tether` after an edit). No secret goes
# here: the key is a file synapse keeps, named by TETHER_REMOTE_AS.

# tether's own socket, and who may drive it (synapse _key show builder).
TETHER_PORT=4486
TETHER_AUTH_PROVIDERS=key
TETHER_ADMINS=key:REPLACE-WITH-synapse-_key-show-builder

# The remote menger it signs in to and listens on, as this agent
# (~/.plexus/keys/<TETHER_REMOTE_AS>.key, 0600; TETHER_REMOTE_KEY names another file).
TETHER_REMOTE=wss://app.menger.sh/ws
TETHER_REMOTE_AS=builder

# Where sessions work, the Claude Code they run, and its permission mode
# (bypassPermissions: the mode the bridge's and the builders' agents run in).
TETHER_WORK_DIR=/home/hypermemetic/dev/controlflow/hypermemetic/menger
TETHER_CLAUDE_PATH=/home/hypermemetic/.local/bin/claude
TETHER_PERMISSION_MODE=bypassPermissions

# Seconds an answer or reply no session of tether's asked waits for another
# agent (the bridge, a hand-launched run) to act and close it, before tether
# starts a session for it.
TETHER_GRACE_SECS=600
# Act on answers given through the API and comments by keys too (off: people's only).
#TETHER_ACCEPT_KEYS=true
# Don't listen; runs still post their reports.
#TETHER_NO_LISTEN=true
